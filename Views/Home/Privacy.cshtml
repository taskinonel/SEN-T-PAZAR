@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    ViewData["Title"] = "Privacy";
}

<section class="section info-page" style="background-image: linear-gradient(110deg, rgba(20,34,59,.88), rgba(20,34,59,.42)), url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=1800&q=80');">
    <div class="container info-page__content">
        <h1>Gizlilik ve Veri Politikası</h1>
        <p>SEN-T PAZAR, kullanıcı verilerini yalnızca hizmet kalitesini artırmak, güvenli iletişim sağlamak ve ilan deneyimini iyileştirmek için işler.</p>
        <div class="info-page__cards">
            <article>
                <img src="https://images.unsplash.com/photo-1633265486064-086b219458ec?auto=format&fit=crop&w=1000&q=80" alt="Veri Güvenliği" />
                <h3>Veri Güvenliği</h3>
                <p>İletişim ve hesap verileri güvenli katmanlarla korunur.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?auto=format&fit=crop&w=1000&q=80" alt="Kullanım Şeffaflığı" />
                <h3>Kullanım Şeffaflığı</h3>
                <p>Veriler yalnızca kullanıcı deneyimi, destek ve güvenlik amacıyla kullanılır.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=1000&q=80" alt="Hesap Kontrolü" />
                <h3>Hesap Kontrolü</h3>
                <p>Kullanıcılar kendi ilan ve profil bilgilerinde düzenleme yapabilir.</p>
            </article>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-light mt-3">@L["home"]</a>
    </div>
</section>
