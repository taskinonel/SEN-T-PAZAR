@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    ViewData["Title"] = L["privacyTitle"];
}

<section class="section info-page" style="background-image: linear-gradient(110deg, rgba(20,34,59,.92), rgba(20,34,59,.55)), url('https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&w=1200&q=60');">
    <div class="container info-page__content">
        <h1>@L["privacyTitle"]</h1>
        <p>@L["privacySubtitle"]</p>
        <div class="info-page__cards">
            <article>
                <img src="https://images.unsplash.com/photo-1633265486064-086b219458ec?auto=format&fit=crop&w=400&h=240&q=75" alt="@L["privacyCard1Title"]" />
                <h3>@L["privacyCard1Title"]</h3>
                <p>@L["privacyCard1Text"]</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?auto=format&fit=crop&w=400&h=240&q=75" alt="@L["privacyCard2Title"]" />
                <h3>@L["privacyCard2Title"]</h3>
                <p>@L["privacyCard2Text"]</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1551836022-d5d88e9218df?auto=format&fit=crop&w=400&h=240&q=75" alt="@L["privacyCard3Title"]" />
                <h3>@L["privacyCard3Title"]</h3>
                <p>@L["privacyCard3Text"]</p>
            </article>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-light mt-3">@L["home"]</a>
    </div>
</section>
