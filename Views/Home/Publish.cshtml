                                <span>@T("Hayvanlar Alemi", "Pets", "Животные", "عالم الحيوانات", "حیوانات")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-helper" value="helper" required>
                            <label for="cat-helper">
                                <i class="bi bi-people"></i>
                                <span>@T("Yardımcı Arayanlar", "Looking for Helpers", "Поиск помощников", "الباحثون عن مساعدين", "در جستجوی کمک")</span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Category" class="text-danger"></span>

                    <div class="form-group">
                        <label asp-for="Type">@L["listingType"] <span class="required">*</span></label>
                        <select asp-for="Type" class="form-select" id="typeSelect" required>
                            <option value="">@selectOptionWithDots</option>
