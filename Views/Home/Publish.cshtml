@model SEN_T_PAZAR.Models.CreateListingViewModel
@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    ViewData["Title"] = L["freePostAd"] + " - " + L["publishTitle"];
    var cities = (ViewData["PublishCities"] as List<string>) ?? [];
    var types = (ViewData["PublishTypes"] as List<string>) ?? [];
    var categories = (ViewData["PublishCategories"] as List<string>) ?? [];
}

@section Styles {
    <style>
        .publish-page { background: #f8f9fa; min-height: 100vh; padding: 2rem 0; }
        .publish-container { max-width: 900px; margin: 0 auto; background: #fff; border-radius: 16px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; }
        .publish-header { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; padding: 2rem; text-align: center; }
        .publish-header h1 { font-size: 1.8rem; margin-bottom: 0.5rem; font-weight: 600; }
        .publish-header p { opacity: 0.9; margin: 0; }
        .publish-form { padding: 2rem; }
        .form-section { margin-bottom: 2rem; border-bottom: 1px solid #e9ecef; padding-bottom: 2rem; }
        .form-section:last-child { border-bottom: none; }
        .section-title { display: flex; align-items: center; gap: 0.75rem; font-size: 1.1rem; font-weight: 600; color: #495057; margin-bottom: 1.5rem; }
        .section-title i { width: 36px; height: 36px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1rem; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; font-size: 0.875rem; font-weight: 500; color: #495057; margin-bottom: 0.5rem; }
        .form-group label .required { color: #dc3545; }
        .form-control, .form-select { border: 2px solid #e9ecef; border-radius: 8px; padding: 0.75rem 1rem; font-size: 0.95rem; transition: all 0.2s; width: 100%; }
        .form-control:focus, .form-select:focus { border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,0.1); outline: none; }
        .form-control::placeholder { color: #adb5bd; }
        textarea.form-control { resize: vertical; min-height: 120px; }
        .input-group { display: flex; gap: 0.5rem; }
        .input-group .form-control { flex: 1; }
        .input-group .form-select { width: auto; min-width: 80px; }
        .price-input { display: flex; align-items: center; gap: 0.5rem; }
        .price-input .form-control { flex: 1; }
        .currency-symbol { background: #e9ecef; padding: 0.75rem 1rem; border-radius: 8px; font-weight: 600; color: #495057; }
        .checkbox-group { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: 0.5rem; }
        .checkbox-item { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; padding: 0.5rem; border-radius: 6px; transition: background 0.2s; }
        .checkbox-item:hover { background: #f8f9fa; }
        .checkbox-item input[type="checkbox"] { width: 20px; height: 20px; accent-color: #667eea; }
        .category-selector { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 0.55rem; margin-bottom: 1.5rem; }
        .category-option { position: relative; }
        .category-option input { position: absolute; opacity: 0; }
        .category-option label { display: flex; flex-direction: column; align-items: center; gap: 0.35rem; padding: 0.8rem 0.45rem; border: 2px solid #e9ecef; border-radius: 12px; cursor: pointer; transition: all 0.2s; text-align: center; min-height: 72px; justify-content: center; }
        .category-option label i { font-size: 1.2rem; color: #6c757d; }
        .category-option label span { font-size: 0.8rem; font-weight: 600; color: #495057; line-height: 1.2; }
        .category-option input:checked + label { border-color: #667eea; background: #f8f9ff; }
        .category-option input:checked + label i { color: #667eea; }
        .dynamic-fields { display: none; background: #f8f9fa; padding: 1.5rem; border-radius: 12px; margin-top: 1rem; }
        .dynamic-fields.active { display: block; animation: fadeIn 0.3s ease; }
        .features-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; }
        .feature-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem; border-radius: 6px; transition: background 0.2s; }
        .feature-item:hover { background: #f8f9fa; }
        .feature-item input[type="checkbox"] { width: 18px; height: 18px; accent-color: #667eea; }
        .image-upload { border: 2px dashed #dee2e6; border-radius: 12px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.2s; }
        .image-upload:hover { border-color: #667eea; background: #f8f9ff; }
        .image-upload.dragover { border-color: #667eea; background: #f8f9ff; }
        .image-upload i { font-size: 2.5rem; color: #adb5bd; margin-bottom: 1rem; }
        .image-upload p { color: #6c757d; margin: 0; }
        .image-upload input { display: none; }
        .image-preview { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 0.75rem; margin-top: 1rem; }
        .preview-item { position: relative; aspect-ratio: 1; border-radius: 8px; overflow: hidden; border: 2px solid #e9ecef; }
        .preview-item img { width: 100%; height: 100%; object-fit: cover; }
        .preview-item .remove-btn { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; background: #dc3545; color: #fff; border: none; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; }
        .preview-item .cover-badge { position: absolute; bottom: 4px; left: 4px; background: #28a745; color: #fff; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: 600; }
        .preview-item input[type="radio"] { position: absolute; bottom: 4px; right: 4px; width: 20px; height: 20px; }
        .contact-options { display: flex; gap: 1rem; flex-wrap: wrap; }
        .contact-option { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1rem; border: 2px solid #e9ecef; border-radius: 8px; cursor: pointer; transition: all 0.2s; }
        .contact-option:hover { border-color: #667eea; }
        .contact-option input { display: none; }
        .contact-option input:checked + i { color: #667eea; }
        .contact-option input:checked + i + span { color: #667eea; font-weight: 600; }
        .submit-btn { width: 100%; padding: 1rem 2rem; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; border: none; border-radius: 12px; font-size: 1.1rem; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-top: 1rem; }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(102,126,234,0.3); }
        .submit-btn:active { transform: translateY(0); }
        .text-danger { color: #dc3545; font-size: 0.8rem; margin-top: 0.25rem; }
        .progress-bar { display: flex; gap: 0.5rem; margin-bottom: 2rem; }
        .progress-step { flex: 1; text-align: center; padding: 0.75rem; background: #e9ecef; border-radius: 8px; font-size: 0.85rem; color: #6c757d; position: relative; }
        .progress-step.active { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: #fff; }
        .progress-step.completed { background: #28a745; color: #fff; }
        .char-counter { text-align: right; font-size: 0.8rem; color: #6c757d; margin-top: 0.25rem; }
        .char-counter.warning { color: #ffc107; }
        .char-counter.danger { color: #dc3545; }
        .info-box { background: #e7f3ff; border-left: 4px solid #667eea; padding: 1rem; border-radius: 8px; margin-bottom: 1rem; }
        .info-box p { margin: 0; color: #495057; font-size: 0.9rem; }
        .category-brief { background: linear-gradient(135deg, #f8fbff 0%, #eef4ff 100%); border: 1px solid #d8e4ff; border-radius: 14px; padding: 1rem 1.1rem; margin-bottom: 1.25rem; }
        .category-brief h4 { color: #304b7f; font-size: 1rem; margin: 0 0 0.4rem; font-weight: 700; }
        .category-brief p { margin: 0; color: #607189; font-size: 0.9rem; }
        .category-guide-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 0.75rem; margin-top: 1rem; }
        .category-guide-card { background: #fff; border: 1px solid #e3ebf7; border-radius: 12px; padding: 0.85rem; min-height: 100%; }
        .category-guide-card strong { display: block; color: #304b7f; font-size: 0.9rem; margin-bottom: 0.3rem; }
        .category-guide-card span { color: #6b7280; font-size: 0.82rem; line-height: 1.45; }
        .helper-text { display: block; margin-top: 0.35rem; color: #6b7280; font-size: 0.78rem; }
        @@keyframes fadeIn { from { opacity: 0; transform: translateY(-10px); } to { opacity: 1; transform: translateY(0); } }
        .form-navigation { display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem; }
        .form-navigation .btn { padding: 0.75rem 2rem; border-radius: 8px; font-weight: 500; cursor: pointer; }
        .btn-secondary { background: #6c757d; color: #fff; border: none; }
        .btn-primary { background: #1e3a66; color: #fff; border: none; }
        @@media (max-width: 768px) {
            .publish-form { padding: 1rem; }
            .category-selector { grid-template-columns: repeat(3, 1fr); }
            .form-grid { grid-template-columns: 1fr; }
            .features-grid { grid-template-columns: repeat(2, 1fr); }
            .progress-step { font-size: 0.7rem; padding: 0.5rem; }
        }
        @@media (max-width: 540px) {
            .category-selector { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
}

<div class="publish-page">
    <div class="publish-container">
        <div class="publish-header">
            <h1>@L["publishHeaderTitle"]</h1>
            <p>@L["publishHeaderSubtitle"]</p>
        </div>

        <div class="publish-form">
            @if (TempData["PublishSuccess"] is string message)
            {
                <div class="alert alert-success" role="alert">@message</div>
            }

            <form asp-action="Publish" asp-controller="Home" method="post" enctype="multipart/form-data" id="publishForm">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="progress-bar">
                    <div class="progress-step active" data-step="1">1. @L["stepCategory"]</div>
                    <div class="progress-step" data-step="2">2. @L["stepInfo"]</div>
                    <div class="progress-step" data-step="3">3. @L["stepLocation"]</div>
                    <div class="progress-step" data-step="4">4. @L["stepImages"]</div>
                    <div class="progress-step" data-step="5">5. @L["stepContact"]</div>
                </div>

                <div class="form-section" id="step1">
                    <div class="section-title">
                        <i class="bi bi-grid-3x3-gap"></i>
                        @L["selectCategory"]
                    </div>
                    
                    <div class="info-box">
                        <p><i class="bi bi-info-circle"></i> @L["selectCategoryInfo"]</p>
                    </div>

                    <div class="category-selector">
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-estate" value="estate" required>
                            <label for="cat-estate">
                                <i class="bi bi-house-door"></i>
                                <span>@L["cat_realestate"]</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-vehicle" value="vehicle" required>
                            <label for="cat-vehicle">
                                <i class="bi bi-car-front"></i>
                                <span>@L["cat_vehicle"]</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-electronics" value="electronics" required>
                            <label for="cat-electronics">
                                <i class="bi bi-laptop"></i>
                                <span>@L["cat_electronics"]</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-furniture" value="furniture" required>
                            <label for="cat-furniture">
                                <i class="bi bi-sofa"></i>
                                <span>@L["cat_home"]</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-services" value="services" required>
                            <label for="cat-services">
                                <i class="bi bi-briefcase"></i>
                                <span>@L["cat_services"]</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-other" value="other" required>
                            <label for="cat-other">
                                <i class="bi bi-box"></i>
                                <span>@L["allCategories"]</span>
                            </label>
                        </div>
                    </div>
                    <span asp-validation-for="Category" class="text-danger"></span>

                    <div class="form-group">
                        <label asp-for="Type">@L["listingType"] <span class="required">*</span></label>
                        <select asp-for="Type" class="form-select" required>
                            <option value="">Seçiniz...</option>
                            @foreach (var type in types)
                            {
                                <option value="@type">@L.TypeLabel(type)</option>
                            }
                        </select>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div id="estate-fields" class="dynamic-fields">
                        <div class="section-title">
                            <i class="bi bi-house"></i>
                            @L["estateFeatures"]
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="EstateNetArea">@L["netArea"]</label>
                                <input asp-for="EstateNetArea" type="number" class="form-control" placeholder="örn: 120" />
                            </div>
                            <div class="form-group">
                                <label asp-for="EstateGrossArea">@L["grossArea"]</label>
                                <input asp-for="EstateGrossArea" type="number" class="form-control" placeholder="örn: 140" />
                            </div>
                            <div class="form-group">
                                <label asp-for="EstateRoomCount">@L["roomCount"]</label>
                                <select asp-for="EstateRoomCount" asp-items="Html.GetEnumSelectList<EstateRoomCount>()" class="form-select">
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="EstateBuildingAge">@L["buildingAge"]</label>
                                <select asp-for="EstateBuildingAge" asp-items="Html.GetEnumSelectList<EstateBuildingAge>()" class="form-select">
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="EstateTotalFloors">@L["floorCount"]</label>
                                <input asp-for="EstateTotalFloors" type="number" class="form-control" placeholder="örn: 10" />
                            </div>
                            <div class="form-group">
                                <label asp-for="EstateFloorLocation">@L["floorLocation"]</label>
                                <select asp-for="EstateFloorLocation" asp-items="Html.GetEnumSelectList<EstateFloorLocation>()" class="form-select">
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="HeatingType">Isıtma Tipi</label>
                                <select asp-for="HeatingType" asp-items="Html.GetEnumSelectList<HeatingType>()" class="form-select">
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="DuesAmount">@L["dues"] (₺)</label>
                                <input asp-for="DuesAmount" type="number" class="form-control" placeholder="örn: 500" />
                            </div>
                            <div class="form-group">
                                <label asp-for="DepositAmount">@L["deposit"] (₺)</label>
                                <input asp-for="DepositAmount" type="number" class="form-control" placeholder="@L["forRentOnly"]" />
                            </div>
                        </div>
                        <div class="features-grid mt-3">
                            <label class="feature-item">
                                <input asp-for="EstateFurnished" type="checkbox" />
                                <span>@L["furnished"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="InSite" type="checkbox" />
                                <span>@L["inSite"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="HasBalcony" type="checkbox" />
                                <span>@L["balcony"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="HasElevator" type="checkbox" />
                                <span>@L["elevator"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="HasParking" type="checkbox" />
                                <span>@L["parking"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="HasPool" type="checkbox" />
                                <span>@L["pool"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="HasSecurity" type="checkbox" />
                                <span>@L["security"]</span>
                            </label>
                        </div>
                    </div>

                    <div id="vehicle-fields" class="dynamic-fields">
                        <div class="section-title">
                            <i class="bi bi-car-front"></i>
                            @L["vehicleInfo"]
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="VehicleBrand">@L["brand"] <span class="required">*</span></label>
                                <input asp-for="VehicleBrand" class="form-control" placeholder="örn: BMW" required />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleModel">@L["model"] <span class="required">*</span></label>
                                <input asp-for="VehicleModel" class="form-control" placeholder="örn: 3.20i" required />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleYear">@L["year"] <span class="required">*</span></label>
                                <input asp-for="VehicleYear" type="number" class="form-control" placeholder="örn: 2020" min="1950" max="2030" required />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleKM">@L["kilometer"] <span class="required">*</span></label>
                                <input asp-for="VehicleKM" type="number" class="form-control" placeholder="örn: 45000" required />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleFuelType">@L["fuelType"] <span class="required">*</span></label>
                                <select asp-for="VehicleFuelType" asp-items="Html.GetEnumSelectList<FuelType>()" class="form-select" required>
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleTransmission">@L["transmission"] <span class="required">*</span></label>
                                <select asp-for="VehicleTransmission" asp-items="Html.GetEnumSelectList<TransmissionType>()" class="form-select" required>
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleBodyType">@L["bodyType"]</label>
                                <select asp-for="VehicleBodyType" asp-items="Html.GetEnumSelectList<BodyType>()" class="form-select">
                                    <option value="">Seçiniz</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="EngineCapacity">@L["engineCapacity"] (cc)</label>
                                <input asp-for="EngineCapacity" type="number" class="form-control" placeholder="örn: 1998" />
                            </div>
                            <div class="form-group">
                                <label asp-for="EnginePower">@L["enginePower"] (HP)</label>
                                <input asp-for="EnginePower" type="number" class="form-control" placeholder="örn: 184" />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleColor">@L["color"]</label>
                                <input asp-for="VehicleColor" class="form-control" placeholder="örn: Beyaz" />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehiclePlate">@L["plate"]</label>
                                <input asp-for="VehiclePlate" class="form-control" placeholder="örn: TR / Yabancı" />
                            </div>
                        </div>
                        <div class="features-grid mt-3">
                            <label class="feature-item">
                                <input asp-for="UnderWarranty" type="checkbox" />
                                <span>@L["underWarranty"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="TradeIn" type="checkbox" />
                                <span>@L["tradeIn"]</span>
                            </label>
                        </div>
                        <div class="form-group mt-3">
                            <label asp-for="AccidentRecord">@L["accidentRecord"]</label>
                            <select asp-for="AccidentRecord" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="none">@L["accidentRecordNone"]</option>
                                <option value="minor">@L["accidentRecordMinor"]</option>
                                <option value="major">@L["accidentRecordMajor"]</option>
                            </select>
                        </div>
                    </div>

                    <div id="product-fields" class="dynamic-fields">
                        <div class="section-title">
                            <i class="bi bi-box-seam"></i>
                            <span id="productSectionTitle">Ürün Bilgileri</span>
                        </div>
                        <div class="category-brief">
                            <h4 id="categoryBriefTitle">Kategoriye özel alanlar</h4>
                            <p id="categoryBriefText">Doğru alt kategori, model ve teslim bilgileri ilanınızın daha hızlı bulunmasını sağlar.</p>
                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="SubCategory" id="subCategoryLabel">Alt Kategori <span class="required">*</span></label>
                                <select asp-for="SubCategory" class="form-select" id="subCategorySelect" required>
                                    <option value="">Seçiniz</option>
                                </select>
                                <small class="helper-text" id="subCategoryHelp">İlanınızın doğru kitleye ulaşması için en yakın alt kategoriyi seçin.</small>
                            </div>
                            <div class="form-group">
                                <label asp-for="ProductBrand" id="productBrandLabel">Marka</label>
                                <input asp-for="ProductBrand" class="form-control" id="productBrandInput" placeholder="örn: Apple" />
                                <small class="helper-text" id="productBrandHelp">Biliniyorsa marka veya sağlayıcı adını yazın.</small>
                            </div>
                            <div class="form-group">
                                <label asp-for="ProductModel" id="productModelLabel">Model</label>
                                <input asp-for="ProductModel" class="form-control" id="productModelInput" placeholder="örn: iPhone 15 Pro" />
                                <small class="helper-text" id="productModelHelp">Model, paket adı veya ürün takım adını yazın.</small>
                            </div>
                            <div class="form-group" id="productConditionGroup">
                                <label asp-for="ProductCondition" id="productConditionLabel">Durumu <span class="required">*</span></label>
                                <select asp-for="ProductCondition" asp-items="Html.GetEnumSelectList<ConditionState>()" class="form-select" id="productConditionSelect">
                                    <option value="">Seçiniz</option>
                                </select>
                                <small class="helper-text" id="productConditionHelp">Fiziksel durum ve kullanım seviyesi güven oluşturur.</small>
                            </div>
                            <div class="form-group">
                                <label asp-for="WarrantyPeriod" id="warrantyLabel">Garanti Süresi</label>
                                <input asp-for="WarrantyPeriod" class="form-control" id="warrantyInput" placeholder="örn: 2 Yıl" />
                                <small class="helper-text" id="warrantyHelp">Teslimat, uygunluk veya garanti bilgisini ekleyin.</small>
                            </div>
                            <div class="form-group">
                                <label asp-for="SerialNumber" id="serialNumberLabel">Seri Numarası</label>
                                <input asp-for="SerialNumber" class="form-control" id="serialNumberInput" placeholder="Ürün seri numarası" />
                                <small class="helper-text" id="serialNumberHelp">İsterseniz seri no, lisans no ya da ölçü bilgisi paylaşın.</small>
                            </div>
                            <div class="form-group">
                                <label asp-for="UsageDuration" id="usageDurationLabel">Kullanım Süresi</label>
                                <input asp-for="UsageDuration" class="form-control" id="usageDurationInput" placeholder="örn: 6 Ay" />
                                <small class="helper-text" id="usageDurationHelp">Kullanım süresi, teslim süresi veya hizmet süresi gibi net bilgi verin.</small>
                            </div>
                        </div>
