                nameof(EstateRoomCount.TwoZero) => "2+0",
                nameof(EstateRoomCount.TwoOne) => "2+1",
                nameof(EstateRoomCount.ThreeZero) => "3+0",
                nameof(EstateRoomCount.ThreeOne) => "3+1",
