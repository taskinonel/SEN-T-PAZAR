                         </div>
                      <!-- District field removed as per request -->
                     </div>

                     <div class="form-grid mt-3">
                         <div class="form-group">
                             <label asp-for="Neighborhood">@L["neighborhood"]</label>
                             <input asp-for="Neighborhood" class="form-control" placeholder="@T("örn: Moda", "e.g. Moda", "напр.: Мода", "مثال: مودا", "مثلاً: موده")" />
                         </div>
                         <div class="form-group">
                             <label asp-for="HouseNumber">@T("Ev / Bina No", "House / Building No", "Дом / Корпус", "رقم المنزل / العمارة", "پلاک / ساختمان")</label>
