                                <option value="">Seçiniz...</option>
                                @foreach (var city in cities)
                                {
                                    <option value="@city">@city</option>
                                }
                            </select>
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="District">@L["district"] <span class="required">*</span></label>
                            <input asp-for="District" class="form-control" placeholder="örn: Kadıköy" required />
                            <span asp-validation-for="District" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Neighborhood">@L["neighborhood"]</label>
                            <input asp-for="Neighborhood" class="form-control" placeholder="örn: Moda" />
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <label asp-for="Address">@L["address"]</label>
                        <textarea asp-for="Address" class="form-control" rows="3" placeholder="Tam adres bilgisi (opsiyonel, sadece ilan sahibine görünür)"></textarea>
                    </div>

                    <div class="info-box">
                        <p><i class="bi bi-info-circle"></i> Konum bilgileri harita üzerinde gösterilecektir. Tam adres ilan sahibine özel mesajla iletilebilir.</p>
                    </div>

                    <div class="form-group">
                        <label asp-for="VideoUrl">@L["videoUrl"]</label>
                        <input asp-for="VideoUrl" type="url" class="form-control" placeholder="https://youtube.com/watch?v=..." />
                        <small class="text-muted">@L["videoUrlHelp"]</small>
                    </div>
                </div>

                <div class="form-section" id="step4">
                    <div class="section-title">
                        <i class="bi bi-images"></i>
                        @L["images"]
                    </div>

                    <div class="info-box">
                        <p><i class="bi bi-camera"></i> @L["photoUploadInfo"]</p>
                    </div>

                    <div class="image-upload" id="dropZone">
                        <i class="bi bi-cloud-upload"></i>
                        <p><strong>@L["dragPhotos"]</strong> @L["clickToSelect"]</p>
                        <p style="font-size: 0.8rem; color: #adb5bd;">JPEG, PNG formatında, max 10MB</p>
                        <input asp-for="ImageFiles" type="file" multiple accept="image/jpeg,image/png,image/webp" id="fileInput" />
                    </div>

                    <div class="image-preview" id="imagePreview"></div>
                    <input type="hidden" asp-for="CoverImageIndex" id="coverImageIndex" value="0" />

                    <span asp-validation-for="ImageFiles" class="text-danger"></span>
                </div>

                <div class="form-section" id="step5">
                    <div class="section-title">
                        <i class="bi bi-person"></i>
                        @L["contactInfo"]
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="FullName">@L["fullName"] <span class="required">*</span></label>
                            <input asp-for="FullName" class="form-control" placeholder="@L["fullName"]" required />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="Phone">@L["phone"] <span class="required">*</span></label>
                            <input asp-for="Phone" type="tel" class="form-control" placeholder="05xx xxx xx xx" required />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mt-3">
                        <label>@L["contactPreferences"]</label>
                        <div class="contact-options">
                            <label class="contact-option">
                                <input asp-for="AllowWhatsApp" type="checkbox" checked />
                                <i class="bi bi-whatsapp"></i>
                                <span>WhatsApp</span>
                            </label>
                            <label class="contact-option">
                                <input asp-for="AllowMessages" type="checkbox" checked />
                                <i class="bi bi-chat-dots"></i>
                                <span>@L["siteMessages"]</span>
                            </label>
                        </div>
                    </div>

                    <div class="info-box mt-3">
                        <p><i class="bi bi-shield-check"></i> @L["contactPrivacy"]</p>
                    </div>
                </div>

                <div class="form-navigation">
                    <button type="button" class="btn btn-secondary" id="prevBtn" style="display: none;">@L["previous"]</button>
                    <button type="button" class="btn btn-primary" id="nextBtn">@L["next"]</button>
                    <button type="submit" class="submit-btn" id="submitBtn" style="display: none;">
                        <i class="bi bi-check-circle"></i> @L["publishMyAd"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

