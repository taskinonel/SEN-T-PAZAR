                        </div>
                        <div class="form-grid">
                            <div class="form-group">
                                <label asp-for="SubCategory" id="subCategoryLabel">@T("Alt Kategori", "Subcategory", "Подкатегория", "الفئة الفرعية", "زیر‌دسته") <span class="required">*</span></label>
                                <input asp-for="SubCategory" type="hidden" id="subCategoryValue" />
                                <select class="form-select" id="subCategorySelect" required>
                                    <option value="">@selectOption</option>
                                </select>
                                <small class="helper-text" id="subCategoryHelp">@T("İlanınızın doğru kitleye ulaşması için en yakın alt kategoriyi seçin.", "Choose the closest subcategory so your listing reaches the right audience.", "Выберите наиболее подходящую подкатегорию, чтобы объявление нашло нужную аудиторию.", "اختر أقرب فئة فرعية ليصل إعلانك إلى الجمهور المناسب.", "نزدیک‌ترین زیر‌دسته را انتخاب کنید تا آگهی شما به مخاطب درست برسد.")</small>
                            </div>
                            <div class="form-group" id="productBrandGroup">
                                <label asp-for="ProductBrand" id="productBrandLabel">@T("Marka", "Brand", "Бренд", "العلامة التجارية", "برند")</label>
                                <input asp-for="ProductBrand" class="form-control" id="productBrandInput" placeholder="@T("örn: Apple", "e.g. Apple", "напр.: Apple", "مثال: Apple", "مثلاً: Apple")" />
                                <small class="helper-text" id="productBrandHelp">@T("Biliniyorsa marka veya sağlayıcı adını yazın.", "Enter the brand or provider name if known.", "Укажите бренд или поставщика, если известно.", "اكتب اسم العلامة أو المورّد إذا كان معروفًا.", "اگر مشخص است نام برند یا ارائه‌دهنده را بنویسید.")</small>
                            </div>
                            <div class="form-group" id="productModelGroup">
                                <label asp-for="ProductModel" id="productModelLabel">@T("Model", "Model", "Модель", "الموديل", "مدل")</label>
                                <input asp-for="ProductModel" class="form-control" id="productModelInput" placeholder="@T("örn: iPhone 15 Pro", "e.g. iPhone 15 Pro", "напр.: iPhone 15 Pro", "مثال: iPhone 15 Pro", "مثلاً: iPhone 15 Pro")" />
                                <small class="helper-text" id="productModelHelp">@T("Model, paket adı veya ürün takım adını yazın.", "Enter the model, package name or product set name.", "Укажите модель, название пакета или комплекта.", "اكتب الموديل أو اسم الباقة أو اسم المجموعة.", "مدل، نام بسته یا نام ست محصول را بنویسید.")</small>
                            </div>
                            <div class="form-group" id="productConditionGroup">
                                <label asp-for="ProductCondition" id="productConditionLabel">@T("Durumu", "Condition", "Состояние", "الحالة", "وضعیت") <span class="required">*</span></label>
                                <select asp-for="ProductCondition" asp-items="BuildEnumOptions<ConditionState>(Model.ProductCondition)" class="form-select" id="productConditionSelect">
                                    <option value="">@selectOption</option>
                                </select>
                                <small class="helper-text" id="productConditionHelp">@T("Fiziksel durum ve kullanım seviyesi güven oluşturur.", "Physical condition and usage level help build trust.", "Физическое состояние и степень использования повышают доверие.", "الحالة المادية ومستوى الاستخدام يبنيان الثقة.", "وضعیت فیزیکی و میزان استفاده اعتماد ایجاد می‌کند.")</small>
                            </div>
                            <div class="form-group" id="warrantyGroup">
                                <label asp-for="WarrantyPeriod" id="warrantyLabel">@T("Garanti Süresi", "Warranty Period", "Срок гарантии", "مدة الضمان", "مدت گارانتی")</label>
                                <input asp-for="WarrantyPeriod" class="form-control" id="warrantyInput" placeholder="@T("örn: 2 Yıl", "e.g. 2 Years", "напр.: 2 года", "مثال: سنتان", "مثلاً: 2 سال")" />
                                <small class="helper-text" id="warrantyHelp">@T("Teslimat, uygunluk veya garanti bilgisini ekleyin.", "Add delivery, availability or warranty details.", "Добавьте сведения о доставке, наличии или гарантии.", "أضف معلومات التسليم أو التوفر أو الضمان.", "اطلاعات تحویل، موجودی یا گارانتی را اضافه کنید.")</small>
                            </div>
                            <div class="form-group" id="serialNumberGroup">
                                <label asp-for="SerialNumber" id="serialNumberLabel">@T("Seri Numarası", "Serial Number", "Серийный номер", "الرقم التسلسلي", "شماره سریال")</label>
                                <input asp-for="SerialNumber" class="form-control" id="serialNumberInput" placeholder="@T("Ürün seri numarası", "Product serial number", "Серийный номер товара", "الرقم التسلسلي للمنتج", "شماره سریال محصول")" />
                                <small class="helper-text" id="serialNumberHelp">@T("İsterseniz seri no, lisans no ya da ölçü bilgisi paylaşın.", "You can share a serial number, license number or measurement if needed.", "При желании укажите серийный номер, лицензию или размер.", "يمكنك مشاركة الرقم التسلسلي أو رقم الترخيص أو المقاس إذا رغبت.", "در صورت تمایل شماره سریال، شماره مجوز یا اطلاعات اندازه را وارد کنید.")</small>
                            </div>
                            <div class="form-group" id="usageDurationGroup">
                                <label asp-for="UsageDuration" id="usageDurationLabel">@T("Kullanım Süresi", "Usage Period", "Срок использования", "مدة الاستخدام", "مدت استفاده")</label>
                                <input asp-for="UsageDuration" class="form-control" id="usageDurationInput" placeholder="@T("örn: 6 Ay", "e.g. 6 Months", "напр.: 6 месяцев", "مثال: 6 أشهر", "مثلاً: 6 ماه")" />
                                <small class="helper-text" id="usageDurationHelp">@T("Kullanım süresi, teslim süresi veya hizmet süresi gibi net bilgi verin.", "Provide a clear usage period, delivery duration or service duration.", "Укажите понятный срок использования, доставки или оказания услуги.", "قدّم مدة استخدام أو تسليم أو خدمة بشكل واضح.", "مدت استفاده، تحویل یا خدمت را به‌صورت شفاف وارد کنید.")</small>
                            </div>
                        </div>
                        <div class="category-guide-grid">
                            <div class="category-guide-card">
                                <strong id="guideCardTitle1">@T("Alt kategori seçin", "Choose the subcategory", "Выберите подкатегорию", "اختر الفئة الفرعية", "زیر‌دسته را انتخاب کنید")</strong>
                                <span id="guideCardText1">@T("Doğru sınıflandırma, ilanın filtrelerde daha görünür olmasını sağlar.", "Correct classification makes the listing more visible in filters.", "Правильная классификация повышает видимость объявления в фильтрах.", "التصنيف الصحيح يجعل الإعلان أكثر ظهورًا في الفلاتر.", "دسته‌بندی درست باعث دیده‌شدن بیشتر آگهی در فیلترها می‌شود.")</span>
                            </div>
                            <div class="category-guide-card">
                                <strong id="guideCardTitle2">@T("Detay ekleyin", "Add details", "Добавьте детали", "أضف التفاصيل", "جزئیات را اضافه کنید")</strong>
                                <span id="guideCardText2">@T("Marka, model, ölçü veya paket adı güven verir ve karar süresini kısaltır.", "Brand, model, size or package name builds trust and shortens decision time.", "Бренд, модель, размер или название пакета повышают доверие и сокращают время решения.", "اسم العلامة أو الموديل أو المقاس أو الباقة يبني الثقة ويقلل وقت القرار.", "برند، مدل، اندازه یا نام بسته اعتماد ایجاد می‌کند و زمان تصمیم‌گیری را کوتاه می‌کند.")</span>
                            </div>
                            <div class="category-guide-card">
                                <strong id="guideCardTitle3">@T("Teslim bilgisini yazın", "Add delivery details", "Укажите условия передачи", "اكتب معلومات التسليم", "اطلاعات تحویل را بنویسید")</strong>
                                <span id="guideCardText3">@T("Teslimat, randevu, garanti veya uygunluk bilgisi dönüşüm oranını artırır.", "Delivery, appointment, warranty or availability details improve conversion.", "Информация о доставке, записи, гарантии или наличии повышает конверсию.", "معلومات التسليم أو الموعد أو الضمان أو التوفر ترفع معدل التحويل.", "اطلاعات تحویل، نوبت، گارانتی یا موجودی نرخ تبدیل را افزایش می‌دهد.")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-section" id="step2">
                    <div class="section-title">
                        <i class="bi bi-file-text"></i>
                        @L["listingInfo"]
                    </div>
                    
                    <div class="form-group">
                        <label asp-for="Title">@L["listingTitle"] <span class="required">*</span></label>
                        <input asp-for="Title" class="form-control" placeholder="@T("Örn: Satılık 3+1 Daire - Merkezi Konum", "e.g. 3+1 Apartment for Sale - Central Location", "напр.: 3+1 квартира на продажу - центр", "مثال: شقة 3+1 للبيع - موقع مركزي", "مثلاً: آپارتمان ۳+۱ فروشی - موقعیت مرکزی")" maxlength="100" required />
                        <span asp-validation-for="Title" class="text-danger"></span>
                        <div class="char-counter" id="titleCounter">0 / 100</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Description">@L["description"] <span class="required">*</span></label>
                        <textarea asp-for="Description" class="form-control" rows="8" placeholder="@T("İlanınızı detaylı bir şekilde açıklayın. Özellikler, avantajlar, konum bilgileri...", "Describe your listing in detail. Include features, advantages and location details...", "Подробно опишите объявление. Укажите характеристики, преимущества и местоположение...", "اشرح إعلانك بالتفصيل. أضف المزايا والموقع والتفاصيل المهمة...", "آگهی خود را با جزئیات توضیح دهید. ویژگی‌ها، مزیت‌ها و اطلاعات موقعیت را بنویسید...")" minlength="40" maxlength="5000" required></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                        <div class="char-counter" id="descCounter">0 / 5000 (minimum 40)</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Tags">@L["keywords"]</label>
                        <input asp-for="Tags" class="form-control" placeholder="@T("Virgülle ayırarak yazın: daire, merkez, metro, okul", "Separate with commas: apartment, center, metro, school", "Разделяйте запятыми: квартира, центр, метро, школа", "افصل بفواصل: شقة، مركز، مترو، مدرسة", "با ویرگول جدا کنید: آپارتمان، مرکز، مترو، مدرسه")" />
                        <small class="text-muted">@T("Aramalarda çıkması için önemli kelimeler ekleyin", "Add important keywords to appear in search", "Добавьте важные ключевые слова для поиска", "أضف كلمات مهمة للظهور في البحث", "برای نمایش در جستجو کلمات کلیدی مهم را اضافه کنید")</small>
                    </div>

                    <div class="form-grid mt-3" id="priceSection">
                        <div class="form-group">
                            <label asp-for="PriceAmount">@L["price"] <span class="required">*</span></label>
                            <div class="price-input">
                                <input asp-for="PriceAmount" type="number" class="form-control" placeholder="0" min="1" step="1" required />
                                <select asp-for="PriceCurrency" class="form-select" style="width: 100px;">
                                    <option value="TL" selected>₺ TL</option>
                                    <option value="USD">$ USD</option>
                                    <option value="EUR">€ EUR</option>
                                    <option value="GBP">£ GBP</option>
                                </select>
                            </div>
                            <small class="text-muted" id="currencyInfo">TL varsayılan ve önerilen para birimidir.</small>
                            <span asp-validation-for="PriceAmount" class="text-danger"></span>
                            <script>
                                document.addEventListener('DOMContentLoaded', function() {
                                    var currencySelect = document.querySelector('select[name="PriceCurrency"]');
                                    var info = document.getElementById('currencyInfo');
                                    if (currencySelect) {
                                        currencySelect.addEventListener('change', function() {
                                            if (currencySelect.value !== 'TL') {
                                                info.textContent = '@T("TL dışı döviz seçtiniz. İlanlar için TL önerilir.", "You selected a foreign currency. TL is recommended for listings.", "Вы выбрали иностранную валюту. Для объявлений рекомендуется TL.", "لقد اخترت عملة أجنبية. يوصى باستخدام الليرة التركية في الإعلانات.", "شما ارز دیگری انتخاب کرده‌اید. برای آگهی‌ها لیر ترکیه پیشنهاد می‌شود.")';
                                                info.classList.add('text-warning');
                                            } else {
                                                info.textContent = '@T("TL varsayılan ve önerilen para birimidir.", "TL is the default and recommended currency.", "TL — валюта по умолчанию и рекомендуемая.", "الليرة التركية هي العملة الافتراضية والمقترحة.", "لیر ترکیه ارز پیش‌فرض و پیشنهادی است.")';
                                                info.classList.remove('text-warning');
                                            }
                                        });
                                    }
                                });
                            </script>
                        </div>
                        <div class="form-group">
                            <label asp-for="PriceType">@T("Fiyat Tipi", "Price Type", "Тип цены", "نوع السعر", "نوع قیمت")</label>
                            <select asp-for="PriceType" asp-items="BuildEnumOptions<PriceType>(Model.PriceType)" class="form-select"></select>
                        </div>
                    </div>

                    <div class="form-group mt-3" id="adoptionPriceNotice" style="display: none;">
                        <div class="category-brief">
                            <h4>@T("Sahiplendirme ilanlarında fiyat alınmaz", "Adoption listings do not require a price", "В объявлениях о пристройстве цена не требуется", "إعلانات التبنّي لا تتطلب سعراً", "در آگهی‌های واگذاری قیمت لازم نیست")</h4>
                            <p>@T("Hayvan sahiplendirme ilanlarında ücret alanını kapatıyoruz. Sağlık, bakım ve teslim koşullarını açıklama alanında belirtin.", "We hide the price field for pet adoption listings. Explain health, care and delivery terms in the description.", "Для объявлений о пристройстве животных поле цены скрыто. Укажите здоровье, уход и условия передачи в описании.", "نخفي حقل السعر في إعلانات تبنّي الحيوانات. اذكر الحالة الصحية والرعاية وشروط التسليم في الوصف.", "در آگهی‌های واگذاری حیوانات فیلد قیمت پنهان می‌شود. وضعیت سلامت، نگهداری و شرایط تحویل را در توضیحات بنویسید.")</p>
