                            <div class="form-group">
                                <label asp-for="EstateBuildingAge">@L["buildingAge"]</label>
                                <select asp-for="EstateBuildingAge" asp-items="BuildEnumOptions<EstateBuildingAge>(Model.EstateBuildingAge)" class="form-select">
                                    <option value="">@selectOption</option>
                                </select>
                                <span asp-validation-for="EstateBuildingAge" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label asp-for="EstateTotalFloors">@L["floorCount"]</label>
