                    { value: 'yatili-yardimci', text: '@T("Yatılı Yardımcı", "Live-in Helper", "Помощник с проживанием", "مساعد مقيم", "کمک‌یار مقیم")' },
                    { value: 'bahce-bakimi', text: '@T("Bahçe Bakımı", "Garden Care", "Уход за садом", "العناية بالحديقة", "نگهداری باغ")' }
                ]
            };

            function decodeLocalizedText(value) {
                if (typeof value !== 'string' || value.indexOf('&') === -1) {
                    return value;
                }

                const textArea = document.createElement('textarea');
                textArea.innerHTML = value;
                return textArea.value;
            }

            function decodeCategoryFieldConfig() {
                Object.keys(categoryFieldConfig).forEach(key => {
                    const config = categoryFieldConfig[key];

                    Object.keys(config).forEach(prop => {
                        const value = config[prop];

                        if (typeof value === 'string') {
                            config[prop] = decodeLocalizedText(value);
                            return;
                        }

                        if (Array.isArray(value)) {
                            config[prop] = value.map(option => {
                                if (!option || typeof option !== 'object') {
                                    return option;
                                }

                                return {
                                    ...option,
                                    value: decodeLocalizedText(option.value),
                                    text: decodeLocalizedText(option.text)
                                };
                            });
                        }
                    });
                });
            }

            decodeCategoryFieldConfig();

            const serverSubCategoryValueMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["PublishSubCategoryValueMap"], new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
            const serverTypeValueMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["PublishTypeValueMap"], new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
            const serverProductFieldVisibilityMap = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewData["PublishProductFieldVisibilityMap"], new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));

            function humanizeSlug(value) {
                return (value || '')
                    .replace(/([a-z])([A-Z])/g, '$1 $2')
                    .split(/[-_\s]/g)
                    .filter(Boolean)
                    .map(part => part.charAt(0).toUpperCase() + part.slice(1))
                    .join(' ');
            }

            function syncSubCategorySelection(value) {
                const normalizedValue = value || '';

                if (subCategorySelect) {
                    subCategorySelect.value = normalizedValue;
                }

                if (subCategoryValue) {
                    subCategoryValue.value = normalizedValue;
                }
            }

            function mergeServerTaxonomyIntoConfig() {
                Object.entries(serverSubCategoryValueMap || {}).forEach(([key, values]) => {
                    const config = categoryFieldConfig[key];
                    if (!config || !Array.isArray(values) || values.length === 0) {
                        return;
                    }

                    const optionMap = new Map((config.subCategoryOptions || []).map(option => [option.value, option]));
                    config.subCategoryOptions = values.map(value => optionMap.get(value) || ({ value, text: humanizeSlug(value) }));
                });
            }

            function buildTypeOptionsFromServer() {
                const labelMap = new Map(Object.entries(localizedTypeLabels));

                const mappedOptions = {};
                Object.entries(serverTypeValueMap || {}).forEach(([key, values]) => {
                    mappedOptions[key] = Array.isArray(values)
                        ? values.map(value => ({ value, text: labelMap.get(value) || humanizeSlug(value) }))
                        : [];
                });

                return mappedOptions;
            }

            mergeServerTaxonomyIntoConfig();

            const categoryTypeOptions = buildTypeOptionsFromServer();

            function normalizeCategoryValue(rawValue) {
                if (!rawValue) {
                    return '';
                }

                const normalized = rawValue
                    .toString()
                    .trim()
                    .toLowerCase()
                    .replace(/ı/g, 'i')
                    .replace(/ğ/g, 'g')
                    .replace(/ü/g, 'u')
                    .replace(/ş/g, 's')
                    .replace(/ö/g, 'o')
                    .replace(/ç/g, 'c');

                const categoryAliases = {
                    emlak: 'estate',
                    realestate: 'estate',
                    estate: 'estate',
                    arsa: 'land',
                    land: 'land',
                    vasita: 'vehicle',
                    vehicle: 'vehicle',
                    arac: 'vehicle',
                    otomobil: 'vehicle',
                    'yedek-parca': 'parts',
                    yedekparca: 'parts',
                    parts: 'parts',
                    'ikinci-el': 'secondhand',
                    ikinciel: 'secondhand',
                    secondhand: 'secondhand',
                    'is-makinesi': 'equipment',
                    ismakinesi: 'equipment',
                    equipment: 'equipment',
                    hizmet: 'services',
                    services: 'services',
                    service: 'services',
                    tutoring: 'tutoring',
                    jobs: 'jobs',
                    pets: 'pets',
                    hayvanlar: 'pets',
                    petshop: 'pets',
                    'pet-shop': 'pets',
                    helper: 'helper',
                    elektronik: 'electronics',
                    electronics: 'electronics',
                    mobilya: 'furniture',
                    furniture: 'furniture',
                    diger: 'other',
                    other: 'other'
                };

                return categoryAliases[normalized] || normalized;
            }

            function updateTypeOptions(category) {
                if (!typeSelect) {
                    return;
                }

                const options = categoryTypeOptions[category] ?? categoryTypeOptions.secondhand;
                const previous = typeSelect.value;
                typeSelect.innerHTML = '';
                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = localizedUi.selectOptionDots;
                typeSelect.appendChild(defaultOption);

                options.forEach(option => {
                    const optionElement = document.createElement('option');
                    optionElement.value = option.value;
                    optionElement.textContent = option.text;
                    if (option.value === previous) {
                        optionElement.selected = true;
                    }
                    typeSelect.appendChild(optionElement);
                });

                if (typeHelp) {
                    typeHelp.textContent = localizedUi.typeHelp;
                }
            }

            function updateStepIndicator() {
                document.querySelectorAll('.progress-step').forEach((step, index) => {
                    step.classList.remove('active', 'completed');
                    if (index + 1 < currentStep) step.classList.add('completed');
                    else if (index + 1 === currentStep) step.classList.add('active');
                });
            }

            function isPetAdoptionSelection() {
                const selectedCategory = normalizeCategoryValue(document.querySelector('input[name="Category"]:checked')?.value || '');
                const selectedType = (typeSelect?.value || '').trim().toLowerCase();
                return selectedCategory === 'pets' && selectedType === 'adoption';
            }

            function toggleFieldGroup(group, shouldShow) {
                if (!group) {
                    return;
                }

                group.style.display = shouldShow ? '' : 'none';
                group.querySelectorAll('input, select, textarea').forEach(field => {
                    field.disabled = !shouldShow;
                });
            }

            function updatePriceVisibility() {
                const shouldShowPrice = !isPetAdoptionSelection();
                toggleFieldGroup(priceSection, shouldShowPrice);
                toggleFieldGroup(priceDescriptionGroup, shouldShowPrice);
                toggleFieldGroup(priceOptionsGroup, shouldShowPrice);

                if (adoptionPriceNotice) {
                    adoptionPriceNotice.style.display = shouldShowPrice ? 'none' : '';
                }
            }

            function setCategoryFieldConfig(category) {
                const config = categoryFieldConfig[category] ?? categoryFieldConfig.electronics;
                const visibility = serverProductFieldVisibilityMap?.[category] ?? serverProductFieldVisibilityMap?.electronics ?? {
                    showBrand: true,
                    showModel: true,
                    showWarranty: true,
                    showSerial: true,
                    showUsage: true
                };

                productSectionTitle.textContent = config.title;
                categoryBriefTitle.textContent = config.briefTitle;
                categoryBriefText.textContent = config.briefText;
                subCategoryLabel.innerHTML = config.subCategoryLabel + ' <span class="required">*</span>';
                subCategoryHelp.textContent = config.subCategoryHelp;
                productBrandLabel.textContent = config.brandLabel;
                productBrandInput.placeholder = config.brandPlaceholder;
                productBrandHelp.textContent = config.brandHelp;
                productModelLabel.textContent = config.modelLabel;
                productModelInput.placeholder = config.modelPlaceholder;
                productModelHelp.textContent = config.modelHelp;
                warrantyLabel.textContent = config.warrantyLabel;
                warrantyInput.placeholder = config.warrantyPlaceholder;
                warrantyHelp.textContent = config.warrantyHelp;
                serialNumberLabel.textContent = config.serialLabel;
                serialNumberInput.placeholder = config.serialPlaceholder;
                serialNumberHelp.textContent = config.serialHelp;
                usageDurationLabel.textContent = config.usageLabel;
                usageDurationInput.placeholder = config.usagePlaceholder;
                usageDurationHelp.textContent = config.usageHelp;
                guideCardTitle1.textContent = config.guide1Title;
                guideCardText1.textContent = config.guide1Text;
                guideCardTitle2.textContent = config.guide2Title;
                guideCardText2.textContent = config.guide2Text;
                guideCardTitle3.textContent = config.guide3Title;
                guideCardText3.textContent = config.guide3Text;

                const existingValue = subCategoryValue?.value || subCategorySelect.value;
                subCategorySelect.innerHTML = '';
                const defaultOption = document.createElement('option');
                defaultOption.value = '';
                defaultOption.textContent = localizedUi.selectOption;
                subCategorySelect.appendChild(defaultOption);
                config.subCategoryOptions.forEach(option => {
                    const optionElement = document.createElement('option');
                    optionElement.value = option.value;
                    optionElement.textContent = option.text;
                    if (option.value === existingValue) {
                        optionElement.selected = true;
                    }
                    subCategorySelect.appendChild(optionElement);
                });

                const hasMatchingValue = config.subCategoryOptions.some(option => option.value === existingValue);
                syncSubCategorySelection(hasMatchingValue ? existingValue : '');

                productConditionLabel.innerHTML = config.conditionRequired
                    ? config.conditionLabel + ' <span class="required">*</span>'
                    : config.conditionLabel;
                productConditionHelp.textContent = config.conditionHelp;
                productConditionGroup.style.display = config.conditionRequired ? '' : 'none';
                productConditionSelect.required = config.conditionRequired;
                if (!config.conditionRequired) {
                    productConditionSelect.value = '';
                }

                toggleOptionalProductField(productBrandGroup, productBrandInput, visibility.showBrand);
                toggleOptionalProductField(productModelGroup, productModelInput, visibility.showModel);
                toggleOptionalProductField(warrantyGroup, warrantyInput, visibility.showWarranty);
                toggleOptionalProductField(serialNumberGroup, serialNumberInput, visibility.showSerial);
                toggleOptionalProductField(usageDurationGroup, usageDurationInput, visibility.showUsage);
            }

            function toggleOptionalProductField(group, field, shouldShow) {
                if (!group || !field) {
                    return;
                }

                group.style.display = shouldShow ? '' : 'none';
                if (!shouldShow) {
                    field.value = '';
                }
            }

            function syncDynamicPanelRequired() {
                dynamicPanels.forEach(panel => {
                    const isActive = panel.classList.contains('active');
                    panel.querySelectorAll('input, select, textarea').forEach(field => {
                        if (field.required) {
                            field.dataset.baseRequired = 'true';
                        }

                        if (!field.dataset.baseRequired) {
                            return;
                        }

                        if (field.id === 'productConditionSelect') {
                            return;
                        }

                        field.required = isActive;
                    });
                });
            }

            function clearPanelFields(panel, excludedIds = []) {
                if (!panel) {
                    return;
                }

                const excludedSet = new Set(excludedIds);
                panel.querySelectorAll('input, select, textarea').forEach(field => {
                    if (excludedSet.has(field.id) || excludedSet.has(field.name)) {
                        return;
                    }

                    if (field.type === 'checkbox' || field.type === 'radio') {
                        field.checked = false;
                        return;
                    }

                    field.value = '';
                });
            }

            function resetEstatePanel() {
                clearPanelFields(estateFields, ['estateSubCategorySelect']);
                if (estateSubCategorySelect) {
                    estateSubCategorySelect.value = 'konut';
                }
                updateEstateMode();
            }

            function resetVehiclePanel() {
                clearPanelFields(vehicleFields, ['vehicleSubCategorySelect']);
                if (vehicleSubCategorySelect) {
                    vehicleSubCategorySelect.value = 'araba';
                }
            }

            function resetProductPanel() {
                clearPanelFields(productFields, ['subCategorySelect', 'subCategoryValue']);
            }

            function updateEstateMode() {
                const estateSubCategory = estateSubCategorySelect ? estateSubCategorySelect.value : 'konut';
                const isLand = estateSubCategory === 'arsa';
                const isCommercial = estateSubCategory === 'ticari';
                const isResidential = estateSubCategory === 'konut';
                if (!estateSectionTitle || !estateSectionHint || !estateResidentialFields || !estateResidentialFeatures) {
                    return;
                }

                estateSectionTitle.textContent = isLand
                    ? localizedUi.estateLandTitle
                    : (isCommercial ? localizedUi.estateCommercialTitle : estateFeaturesLabel);
                estateSectionHint.textContent = isLand
                    ? localizedUi.estateLandHint
                    : (isCommercial
                        ? localizedUi.estateCommercialHint
                        : localizedUi.estateResidentialHint);

                estateResidentialFields.style.display = isLand ? 'none' : '';
                estateResidentialFeatures.style.display = isLand ? 'none' : '';
                if (estateFeatureBoards) {
                    estateFeatureBoards.style.display = isResidential ? '' : 'none';
                }

                // Konut için oda sayısı zorunlu: required attribute'unu dinamik yönet
                if (estateRoomCountSelect) {
                    estateRoomCountSelect.required = isResidential;
                    if (isResidential) {
                        estateRoomCountSelect.dataset.baseRequired = 'true';
                    } else {
                        delete estateRoomCountSelect.dataset.baseRequired;
                    }
                }

                if (!isResidential) {
                    estateResidentialFields.querySelectorAll('input, select, textarea').forEach(field => {
                        if (field.type === 'checkbox' || field.type === 'radio') {
                            field.checked = false;
                        } else {
                            field.value = '';
                        }
                    });
                    estateResidentialFeatures.querySelectorAll('input[type="checkbox"]').forEach(field => {
                        field.checked = false;
                    });

                    if (estateFeatureBoards) {
                        estateFeatureBoards.querySelectorAll('input[type="checkbox"]').forEach(field => {
                            field.checked = false;
                        });
                    }
                }
            }

            function buildEstateFeaturePayload() {
                const all = Array.from(document.querySelectorAll('.estate-extra-feature'));
                const grouped = { exterior: [], interior: [], location: [] };

                all.forEach((input) => {
                    if (!(input instanceof HTMLInputElement) || !input.checked) {
                        return;
                    }

                    const key = input.dataset.group;
                    if (!key || !grouped[key]) {
                        return;
                    }

                    grouped[key].push(input.value.trim());
                });

                return grouped;
            }

            function encodeEstateFeaturePayload(payload) {
                const hasAny = payload.exterior.length > 0 || payload.interior.length > 0 || payload.location.length > 0;
                if (!hasAny) {
                    return '';
                }

                try {
                    return btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
                } catch {
                    return '';
                }
            }

            function mergeEstateFeaturesIntoTags() {
                if (!tagsInput) {
                    return;
                }

                const category = normalizeCategoryValue(document.querySelector('input[name="Category"]:checked')?.value || '');
                const estateSubCategory = (estateSubCategorySelect?.value || '').trim().toLowerCase();
                const currentTokens = tagsInput.value
                    .split(',')
                    .map(x => x.trim())
                    .filter(x => x.length > 0 && !x.startsWith(estateFeaturePrefix));

                if (category !== 'estate' || estateSubCategory !== 'konut') {
                    tagsInput.value = currentTokens.join(', ');
                    return;
                }

                const encoded = encodeEstateFeaturePayload(buildEstateFeaturePayload());
                if (encoded) {
                    currentTokens.push(estateFeaturePrefix + encoded);
                }

                tagsInput.value = currentTokens.join(', ');
            }

            function validateCurrentStep() {
                const currentSection = document.getElementById('step' + currentStep);
                const requiredFields = currentSection.querySelectorAll('[required]');
                let valid = true;
                const checkedRadioGroups = new Set();
                
                requiredFields.forEach(field => {
                    const dynamicParent = field.closest('.dynamic-fields');
                    const isVisible = !dynamicParent || dynamicParent.classList.contains('active');

                    if (!isVisible || field.offsetParent === null) {
                        field.style.borderColor = '#e9ecef';
                        return;
                    }

                    if (field.type === 'radio') {
                        if (checkedRadioGroups.has(field.name)) {
                            return;
                        }

                        checkedRadioGroups.add(field.name);
                        const group = currentSection.querySelectorAll(`input[name="${field.name}"]`);
                        const hasChecked = Array.from(group).some(radio => radio.checked);
                        if (!hasChecked) {
                            valid = false;
                        }
                        return;
                    }

                    if (!field.value.trim()) {
                        valid = false;
                        field.style.borderColor = '#dc3545';
                    } else {
                        field.style.borderColor = '#e9ecef';
                    }
                });
                
                return valid;
            }

            nextBtn.addEventListener('click', function() {
                if (validateCurrentStep()) {
                    if (currentStep < totalSteps) {
                        currentStep++;
                        updateStepIndicator();
                        
                        document.querySelectorAll('.form-section').forEach((section, index) => {
                            section.style.display = index + 1 === currentStep ? 'block' : 'none';
                        });
                        
                        prevBtn.style.display = currentStep > 1 ? 'inline-block' : 'none';
                        
                        if (currentStep === totalSteps) {
                            nextBtn.style.display = 'none';
                            submitBtn.style.display = 'block';
                        }
                    }
                } else {
                        alert(localizedUi.requiredFieldsAlert);
                }
            });

            prevBtn.addEventListener('click', function() {
                if (currentStep > 1) {
                    currentStep--;
                    updateStepIndicator();
                    
                    document.querySelectorAll('.form-section').forEach((section, index) => {
                        section.style.display = index + 1 === currentStep ? 'block' : 'none';
                    });
                    
                    prevBtn.style.display = currentStep > 1 ? 'inline-block' : 'none';
                    nextBtn.style.display = 'inline-block';
                    submitBtn.style.display = 'none';
                }
            });

            document.querySelectorAll('.form-section').forEach((section, index) => {
                section.style.display = index + 1 === currentStep ? 'block' : 'none';
            });

            updateStepIndicator();
            prevBtn.style.display = currentStep > 1 ? 'inline-block' : 'none';
            nextBtn.style.display = currentStep === totalSteps ? 'none' : 'inline-block';
            submitBtn.style.display = currentStep === totalSteps ? 'block' : 'none';

            if (currentStep > 1) {
                const currentSection = document.getElementById('step' + currentStep);
                currentSection?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            // Sunucu validasyon hatası varsa hata özetine scroll yap
            const serverErrorSummary = document.getElementById('serverErrorSummary');
            if (serverErrorSummary) {
                serverErrorSummary.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function updateCategoryPanels(category) {
                category = normalizeCategoryValue(category);
                if (category === 'land') {
                    category = 'estate';
                }

                if (currentDynamicCategory && currentDynamicCategory !== category) {
                    if (currentDynamicCategory === 'estate') {
                        resetEstatePanel();
                    } else if (currentDynamicCategory === 'vehicle') {
                        resetVehiclePanel();
                    } else if (productCategoryKeys.includes(currentDynamicCategory)) {
                        resetProductPanel();
                    }
                }

                currentDynamicCategory = category;
                estateFields.classList.remove('active');
                vehicleFields.classList.remove('active');
                productFields.classList.remove('active');

                if (category === 'estate') {
                    estateFields.classList.add('active');
                    setCategoryFieldConfig('estate');
                    if (estateSubCategorySelect && subCategorySelect) {
                        syncSubCategorySelection(estateSubCategorySelect.value);
                    }
                    updateEstateMode();
                } else if (category === 'vehicle') {
                    vehicleFields.classList.add('active');
                    syncSubCategorySelection(vehicleSubCategorySelect?.value || 'araba');
                } else if (productCategoryKeys.includes(category)) {
                    productFields.classList.add('active');
                    setCategoryFieldConfig(category);
                } else {
                    syncSubCategorySelection('');
                }

                updateTypeOptions(category);
                syncDynamicPanelRequired();
                updatePriceVisibility();
            }

            categoryInputs.forEach(input => {
                input.addEventListener('change', function() {
                    updateCategoryPanels(normalizeCategoryValue(this.value));
                });
            });

            if (typeSelect) {
                typeSelect.addEventListener('change', updatePriceVisibility);
            }

            if (estateSubCategorySelect) {
                estateSubCategorySelect.addEventListener('change', function() {
                    syncSubCategorySelection(this.value);
                    updateEstateMode();
                });
            }

            if (vehicleSubCategorySelect) {
                vehicleSubCategorySelect.addEventListener('change', function() {
                    syncSubCategorySelection(this.value || 'araba');
                });
            }

            if (subCategorySelect) {
                subCategorySelect.addEventListener('change', function() {
                    syncSubCategorySelection(this.value);
                });
            }

            const selectedCategoryInput = document.querySelector('input[name="Category"]:checked');
            if (selectedCategoryInput) {
                updateCategoryPanels(normalizeCategoryValue(selectedCategoryInput.value));
            }

            function updateCharCounter(input, counter, max) {
                const len = input.value.length;
                counter.textContent = len + ' / ' + max + (input === descInput ? ' (minimum 40)' : '');
                counter.className = 'char-counter';
                if (len > max * 0.9) counter.classList.add('danger');
                else if (len > max * 0.8) counter.classList.add('warning');
            }

            if (titleInput && titleCounter) {
                titleInput.addEventListener('input', () => updateCharCounter(titleInput, titleCounter, 100));
            }
            if (descInput && descCounter) {
                descInput.addEventListener('input', () => updateCharCounter(descInput, descCounter, 5000));
            }

            if (priceInput) {
                priceInput.addEventListener('input', function() {
                    this.value = this.value.replace(/[^\d]/g, '');
                });
            }

            let uploadedFiles = [];

            dropZone.addEventListener('click', () => fileInput.click());
            
            dropZone.addEventListener('dragover', (e) => {
                e.preventDefault();
                dropZone.classList.add('dragover');
            });
            
            dropZone.addEventListener('dragleave', () => {
                dropZone.classList.remove('dragover');
            });
            
            dropZone.addEventListener('drop', (e) => {
                e.preventDefault();
                dropZone.classList.remove('dragover');
                handleFiles(e.dataTransfer.files);
            });
            
            fileInput.addEventListener('change', () => {
                handleFiles(fileInput.files);
            });

            function handleFiles(files) {
                if (uploadedFiles.length + files.length > 20) {
                    alert(localizedUi.maxPhotosAlert);
                    return;
                }

                let addedAny = false;
                Array.from(files).forEach(file => {
                    if (file.size > 10 * 1024 * 1024) {
                        alert(file.name + localizedUi.fileTooBigSuffix);
                        return;
                    }
                    
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        const index = uploadedFiles.length;
                        uploadedFiles.push(file);
                        addedAny = true;
                        
                        const div = document.createElement('div');
                        div.className = 'preview-item';
                        div.dataset.index = index;
                        div.innerHTML = `
                            <img src="${e.target.result}" alt="${file.name}">
                            <button type="button" class="remove-btn" data-index="${index}">×</button>
                            ${index === 0 ? `<span class="cover-badge">${localizedUi.coverBadge}</span>` : ''}
                            <input type="radio" name="coverSelect" value="${index}" ${index === 0 ? 'checked' : ''} title="${localizedUi.coverPhotoTitle}">
                        `;
                        
                        imagePreview.appendChild(div);
                        
                        div.querySelector('.remove-btn').addEventListener('click', function() {
                            const idx = parseInt(this.dataset.index);
                            uploadedFiles.splice(idx, 1);
                            div.remove();
                            updateFileInput();
                            reorderPreviews();
                        });
                        
                        div.querySelector('input[type="radio"]').addEventListener('change', function() {
                            coverImageIndex.value = this.value;
                            updateCoverBadge();
                        });

                        updateFileInput();
                    };
                    reader.readAsDataURL(file);
                });

                if (!addedAny) {
                    updateFileInput();
                }
            }

            function updateFileInput() {
                const dt = new DataTransfer();
                uploadedFiles.forEach(file => dt.items.add(file));
                fileInput.files = dt.files;
            }

            function reorderPreviews() {
                const items = imagePreview.querySelectorAll('.preview-item');
                items.forEach((item, index) => {
                    item.dataset.index = index;
                    item.querySelector('.remove-btn').dataset.index = index;
                    const radio = item.querySelector('input[type="radio"]');
                    radio.value = index;
                    const badge = item.querySelector('.cover-badge');
                    if (badge) badge.remove();
                });
                coverImageIndex.value = 0;
                if (items.length > 0 && !items[0].querySelector('.cover-badge')) {
                    items[0].insertAdjacentHTML('afterbegin', `<span class="cover-badge">${localizedUi.coverBadge}</span>`);
                }
            }

            function updateCoverBadge() {
                imagePreview.querySelectorAll('.cover-badge').forEach(badge => badge.remove());
                const selected = imagePreview.querySelector('input[type="radio"]:checked');
                if (selected) {
                    selected.closest('.preview-item').insertAdjacentHTML('afterbegin', `<span class="cover-badge">${localizedUi.coverBadge}</span>`);
                }
            }

            form.addEventListener('submit', function() {
                const activeCategory = currentDynamicCategory || normalizeCategoryValue(document.querySelector('input[name="Category"]:checked')?.value || '');
                if (activeCategory === 'estate' && estateSubCategorySelect && subCategorySelect) {
                    syncSubCategorySelection(estateSubCategorySelect.value);
                } else if (activeCategory === 'vehicle' && vehicleSubCategorySelect) {
                    syncSubCategorySelection(vehicleSubCategorySelect.value || 'araba');
                } else if (productCategoryKeys.includes(activeCategory) && subCategorySelect) {
                    syncSubCategorySelection(subCategorySelect.value);
                }

                if (activeCategory !== 'estate') {
                    resetEstatePanel();
                }

                if (activeCategory !== 'vehicle') {
                    resetVehiclePanel();
                }

                if (!productCategoryKeys.includes(activeCategory) && activeCategory !== 'estate') {
                    resetProductPanel();
                }

                mergeEstateFeaturesIntoTags();
            });

            // Address auto-population
            function updateAddress() {
                if (!addressInput) return;
                const parts = [];
                if (citySelect && citySelect.value) parts.push(citySelect.value);
                // District field removed as per request
                if (neighborhoodInput && neighborhoodInput.value) parts.push(neighborhoodInput.value);
                if (houseNumberInput && houseNumberInput.value) parts.push('No: ' + houseNumberInput.value);
                if (apartmentNumberInput && apartmentNumberInput.value) parts.push('Daire No: ' + apartmentNumberInput.value);
                if (parts.length > 0) {
                    addressInput.value = parts.join(', ');
                }
            }

            [citySelect, neighborhoodInput, houseNumberInput, apartmentNumberInput].forEach(el => {
                if (el) {
                    el.addEventListener('change', updateAddress);
                    el.addEventListener('input', updateAddress);
                }
            });
        });
    </script>
}
