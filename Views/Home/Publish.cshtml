                                <span>@T("Özel Ders Verenler", "Private Tutors", "Частные уроки", "مدرسون خصوصيون", "مدرسان خصوصی")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-jobs" value="jobs" required>
