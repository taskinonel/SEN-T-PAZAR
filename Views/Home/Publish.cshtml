                            </div>
                            <div class="form-group">
                                <label asp-for="EnginePower">@L["enginePower"] (HP)</label>
                                <input asp-for="EnginePower" type="number" class="form-control" placeholder="@T("örn: 184", "e.g. 184", "напр.: 184", "مثال: 184", "مثلاً: 184")" />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleColor">@L["color"]</label>
                                <input asp-for="VehicleColor" class="form-control" placeholder="@T("örn: Beyaz", "e.g. White", "напр.: белый", "مثال: أبيض", "مثلاً: سفید")" />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehiclePlate">@L["plate"]</label>
                                <input asp-for="VehiclePlate" class="form-control" placeholder="@T("örn: TR / Yabancı", "e.g. TR / Foreign", "напр.: TR / иностранный", "مثال: TR / أجنبي", "مثلاً: TR / خارجی")" />
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleCondition">@T("Araç Durumu", "Vehicle Condition", "Состояние автомобиля", "حالة المركبة", "وضعیت خودرو")</label>
                                <select asp-for="VehicleCondition" asp-items="BuildEnumOptions<VehicleConditionState>(Model.VehicleCondition)" class="form-select">
                                    <option value="">@selectOption</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleSteeringType">@T("Direksiyon Tipi", "Steering Type", "Тип руля", "نوع المقود", "نوع فرمان")</label>
                                <select asp-for="VehicleSteeringType" asp-items="BuildEnumOptions<SteeringType>(Model.VehicleSteeringType)" class="form-select">
                                    <option value="">@selectOption</option>
                                </select>
                            </div>
                        </div>
                        <div class="features-grid mt-3">
                            <label class="feature-item">
                                <input asp-for="UnderWarranty" type="checkbox" />
                                <span>@L["underWarranty"]</span>
                            </label>
                            <label class="feature-item">
                                <input asp-for="TradeIn" type="checkbox" />
                                <span>@L["tradeIn"]</span>
                            </label>
                        </div>
                        <div class="form-group mt-3">
                            <label asp-for="AccidentRecord">@L["accidentRecord"]</label>
                            <select asp-for="AccidentRecord" class="form-select">
                                <option value="">@selectOption</option>
                                <option value="none">@T("Yok", "None", "Нет", "لا يوجد", "ندارد")</option>
                                <option value="minor">@T("Hafif", "Minor", "Незначительный", "طفيف", "جزئی")</option>
                                <option value="major">@T("Ağır", "Major", "Серьезный", "جسيم", "شدید")</option>
                            </select>
                        </div>
                    </div>

                    <div id="product-fields" class="dynamic-fields">
                        <div class="section-title">
                            <i class="bi bi-box-seam"></i>
                            <span id="productSectionTitle">Ürün Bilgileri</span>
                        </div>
                        <div class="category-brief">
                            <h4 id="categoryBriefTitle">Kategoriye özel alanlar</h4>
