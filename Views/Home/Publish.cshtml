                            {
                                <option value="@type">@L.TypeLabel(type)</option>
                            }
                        </select>
                        <small id="typeHelp" class="helper-text">@T("Kategoriye göre en uygun ilan tipi listelenir.", "The most suitable listing types are shown based on the selected category.", "Подходящие типы объявлений показаны в зависимости от выбранной категории.", "تظهر أنواع الإعلانات المناسبة بحسب الفئة المحددة.", "نوع‌های مناسب آگهی بر اساس دسته انتخاب‌شده نمایش داده می‌شوند.")</small>
                        <span asp-validation-for="Type" class="text-danger"></span>
                    </div>

                    <div id="estate-fields" class="dynamic-fields">
                        <div class="section-title">
                            <i class="bi bi-house"></i>
                            <span id="estateSectionTitle">@L["estateFeatures"]</span>
                        </div>
                        <p class="helper-text" id="estateSectionHint">@T("Konut ilanları için oda ve bina detaylarını, arsa ilanları için parsel büyüklüğünü ekleyin.", "Add room and building details for residential listings, and parcel size for land listings.", "Добавьте данные о комнатах и здании для жилья, а для земли укажите размер участка.", "أضف تفاصيل الغرف والمبنى لإعلانات السكن، ومساحة القطعة لإعلانات الأراضي.", "برای آگهی مسکونی جزئیات اتاق و ساختمان و برای زمین متراژ قطعه را وارد کنید.")</p>
