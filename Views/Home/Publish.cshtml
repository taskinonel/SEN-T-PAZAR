                                    <label><input type="checkbox" class="estate-extra-feature" data-group="exterior" value="Jeneratör" /> Jeneratör</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="exterior" value="Açık Otopark" /> Açık Otopark</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="exterior" value="Kapalı Otopark" /> Kapalı Otopark</label>
