                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Ebeveyn WC" /> Ebeveyn WC</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Ebeveyn Dolabı" /> Ebeveyn Dolabı</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Yangın Alarmı" /> Yangın Alarmı</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Klima" /> Klima</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Panjur" /> Panjur</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="TV Altyapısı" /> TV Altyapısı</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Parke" /> Parke</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Balkon" /> Balkon</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Doğal Mermer" /> Doğal Mermer</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Duş" /> Duş</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="interior" value="Çelik Kapı" /> Çelik Kapı</label>
                                </div>
                            </article>
                            <article class="estate-feature-board">
                                <h5>Konum Özellikleri</h5>
                                <div class="estate-feature-list">
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Şehir Manzarası" /> Şehir Manzarası</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Doğa Manzarası" /> Doğa Manzarası</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Deniz Manzarası" /> Deniz Manzarası</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Kanalizasyon" /> Kanalizasyon</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Denize Yakın" /> Denize Yakın</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Dağ Manzarası" /> Dağ Manzarası</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Güney Cephe" /> Güney Cephe</label>
                                    <label><input type="checkbox" class="estate-extra-feature" data-group="location" value="Batı Cephe" /> Batı Cephe</label>
