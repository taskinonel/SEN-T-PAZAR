                        <div class="char-counter" id="descCounter">0 / 5000 (minimum 40)</div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Tags">@L["keywords"]</label>
                        <input asp-for="Tags" class="form-control" placeholder="Virgülle ayırarak yazın: daire, merkez, metro, okul" />
                        <small class="text-muted">Aramalarda çıkması için önemli kelimeler ekleyin</small>
                    </div>

                    <div class="form-grid mt-3">
                        <div class="form-group">
                            <label asp-for="PriceAmount">@L["price"] <span class="required">*</span></label>
                            <div class="price-input">
                                <input asp-for="PriceAmount" type="number" class="form-control" placeholder="0" min="1" required />
                                <select asp-for="PriceCurrency" class="form-select" style="width: 100px;">
                                    <option value="TL">₺ TL</option>
                                    <option value="USD">$ USD</option>
                                    <option value="EUR">€ EUR</option>
                                    <option value="GBP">£ GBP</option>
                                </select>
                            </div>
                            <span asp-validation-for="PriceAmount" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="PriceType">Fiyat Tipi</label>
                            <select asp-for="PriceType" asp-items="Html.GetEnumSelectList<PriceType>()" class="form-select"></select>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="PriceDescription">@L["priceDescription"]</label>
                        <input asp-for="PriceDescription" class="form-control" placeholder="Örn: Son fiyat, pazarlık payı yok" />
                    </div>

                    <div class="checkbox-group">
                        <label class="checkbox-item">
                            <input asp-for="Negotiable" type="checkbox" checked />
                            <span>@L["negotiable"]</span>
                        </label>
                        <label class="checkbox-item">
                            <input asp-for="TradeIn" type="checkbox" />
                            <span>@L["tradeIn"]</span>
                        </label>
                    </div>

                    <div class="form-group mt-3">
                        <label asp-for="AdvertiserType">@L["advertiserType"] <span class="required">*</span></label>
                        <select asp-for="AdvertiserType" asp-items="Html.GetEnumSelectList<AdvertiserType>()" class="form-select"></select>
                    </div>
                </div>

                <div class="form-section" id="step3">
                    <div class="section-title">
                        <i class="bi bi-geo-alt"></i>
                        @L["locationInfo"]
                    </div>

                    <div class="form-grid">
                        <div class="form-group">
                            <label asp-for="City">@L["city"] <span class="required">*</span></label>
