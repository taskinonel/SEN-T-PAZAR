                                 <span>WhatsApp</span>
                             </label>
                             <label class="contact-option">
                                 <input asp-for="AllowMessages" type="checkbox" checked />
                                 <i class="bi bi-chat-dots"></i>
                                 <span>@L["siteMessages"]</span>
                             </label>
                         </div>
                     </div>

                     <div class="info-box mt-3">
                         <p><i class="bi bi-shield-check"></i> @L["contactPrivacy"]</p>
                         <p class="mt-2"><i class="bi bi-telephone"></i> @T("Telefon formatı: 05xx xxx xx xx veya +90 5xx xxx xx xx", "Phone format: 05xx xxx xx xx or +90 5xx xxx xx xx", "Формат телефона: 05xx xxx xx xx или +90 5xx xxx xx xx", "صيغة الهاتف: 05xx xxx xx xx أو +90 5xx xxx xx xx", "فرمت تلفن: 05xx xxx xx xx یا +90 5xx xxx xx xx")</p>
                     </div>
                 </div>

                <div class="form-navigation">
                    <button type="button" class="btn btn-secondary" id="prevBtn" style="display: none;">@L["previous"]</button>
                    <button type="button" class="btn btn-primary" id="nextBtn">@L["next"]</button>
                    <button type="submit" class="submit-btn" id="submitBtn" style="display: none;">
                        <i class="bi bi-check-circle"></i> @L["publishMyAd"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

