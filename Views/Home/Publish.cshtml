@model SEN_T_PAZAR.Models.CreateListingViewModel
@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    string T(string tr, string en, string ru, string ar, string? fa = null) => L.CultureCode switch
    {
        "en" => en,
        "ru" => ru,
        "ar" => ar,
        "fa" => fa ?? en ?? tr,
        _ => tr
    };

    bool HasModelError(string key)
    {
        return ViewData.ModelState.TryGetValue(key, out var entry) && entry.Errors.Count > 0;
    }

    ViewData["Title"] = L["freePostAd"] + " - " + L["publishTitle"];
    var cities = (ViewData["PublishCities"] as List<string>) ?? [];
    var types = (ViewData["PublishTypes"] as List<string>) ?? [];
    var categories = (ViewData["PublishCategories"] as List<string>) ?? [];
    var vehicleBrandOptions = (ViewData["VehicleBrandOptions"] as List<string>) ?? [];
    var initialStep = 1;

    if (HasModelError(nameof(Model.FullName)) || HasModelError(nameof(Model.Phone)))
    {
        initialStep = 5;
    }
    else if (HasModelError(nameof(Model.ImageFiles)))
    {
        initialStep = 4;
    }
            else if (HasModelError(nameof(Model.City)) ||
                     HasModelError(nameof(Model.Neighborhood)) ||
                     HasModelError(nameof(Model.Address)))
            {
                initialStep = 3;
            }
    else if (HasModelError(nameof(Model.Title)) ||
             HasModelError(nameof(Model.Description)) ||
             HasModelError(nameof(Model.PriceAmount)) ||
             HasModelError(nameof(Model.PriceCurrency)) ||
             HasModelError(nameof(Model.PriceType)) ||
             HasModelError(nameof(Model.PriceDescription)) ||
             HasModelError(nameof(Model.AdvertiserType)))
    {
        initialStep = 2;
    }
    else if (HasModelError(nameof(Model.Category)) ||
             HasModelError(nameof(Model.Type)) ||
             HasModelError(nameof(Model.SubCategory)) ||
             HasModelError(nameof(Model.EstateNetArea)) ||
             HasModelError(nameof(Model.EstateGrossArea)) ||
             HasModelError(nameof(Model.EstateRoomCount)) ||
             HasModelError(nameof(Model.VehicleBrand)) ||
             HasModelError(nameof(Model.VehicleModel)) ||
             HasModelError(nameof(Model.VehicleYear)) ||
             HasModelError(nameof(Model.VehicleKM)) ||
             HasModelError(nameof(Model.VehicleFuelType)) ||
             HasModelError(nameof(Model.VehicleTransmission)) ||
             HasModelError(nameof(Model.ProductCondition)))
    {
        initialStep = 1;
    }

    var selectOption = T("Seçiniz", "Select", "Выберите", "اختر", "انتخاب کنید");
    var selectOptionWithDots = T("Seçiniz...", "Select...", "Выберите...", "اختر...", "انتخاب کنید...");

