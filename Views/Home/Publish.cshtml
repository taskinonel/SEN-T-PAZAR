                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleTransmission">@L["transmission"] <span class="required">*</span></label>
                                <select asp-for="VehicleTransmission" asp-items="BuildEnumOptions<TransmissionType>(Model.VehicleTransmission)" class="form-select" required>
                                    <option value="">@selectOption</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="VehicleBodyType">@L["bodyType"]</label>
                                <select asp-for="VehicleBodyType" asp-items="BuildEnumOptions<BodyType>(Model.VehicleBodyType)" class="form-select">
                                    <option value="">@selectOption</option>
                                </select>
                            </div>
                            <div class="form-group">
                                <label asp-for="EngineCapacity">@L["engineCapacity"] (cc)</label>
