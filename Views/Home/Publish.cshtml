                                <span>@T("Ustalar ve Hizmetler", "Services & Professionals", "Услуги и специалисты", "الخدمات والمهنيون", "خدمات و متخصصان")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-tutoring" value="tutoring" required>
