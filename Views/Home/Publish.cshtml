                                <i class="bi bi-house-door"></i>
                                <span>@T("Emlak", "Real Estate", "Недвижимость", "العقارات", "املاک")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-vehicle" value="vehicle" required>
                            <label for="cat-vehicle">
                                <i class="bi bi-car-front"></i>
                                <span>@T("Vasıta", "Vehicles", "Транспорт", "المركبات", "خودرو")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-parts" value="parts" required>
                            <label for="cat-parts">
                                <i class="bi bi-tools"></i>
                                <span>@T("Yedek Parça, Aksesuar, Donanım & Tuning", "Spare Parts, Accessories, Equipment & Tuning", "Запчасти, аксессуары, оборудование и тюнинг", "قطع الغيار والإكسسوارات والمعدات والتعديل", "لوازم یدکی، جانبی، تجهیزات و تیونینگ")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-secondhand" value="secondhand" required>
                            <label for="cat-secondhand">
                                <i class="bi bi-cart-check"></i>
                                <span>@T("İkinci El ve Karma Ürünler", "Second Hand & Mixed Items", "Б/у и смешанные товары", "المنتجات المستعملة والمتنوعة", "کالاهای دست دوم و ترکیبی")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-electronics" value="electronics" required>
                            <label for="cat-electronics">
                                <i class="bi bi-phone"></i>
                                <span>@T("Elektronik", "Electronics", "Электроника", "الإلكترونيات", "الکترونیک")</span>
                            </label>
                        </div>
                        <div class="category-option">
                            <input type="radio" asp-for="Category" id="cat-furniture" value="furniture" required>
                            <label for="cat-furniture">
