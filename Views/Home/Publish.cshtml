                                    <label><input type="checkbox" class="estate-extra-feature" data-group="exterior" value="Güvenlik Kamerası" /> Güvenlik Kamerası</label>
                                </div>
                            </article>
                            <article class="estate-feature-board">
                                <h5>İç Özellikler</h5>
                                <div class="estate-feature-list">
