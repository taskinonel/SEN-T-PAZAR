@{
    ViewData["Title"] = "Güvenlik Politikası";
}

<style>
    .security-hero {
        background: linear-gradient(135deg, #1e3a66 0%, #0d6efd 60%, #6366f1 100%);
        padding: 3.5rem 0 2.5rem; color: #fff; text-align: center;
    }
    .security-hero h1 { font-size: 2rem; font-weight: 800; }
    .policy-card { border: none; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,.07); }
    .policy-card .card-body { padding: 2.5rem; }
    .policy-section h5 { color: #1e3a66; font-weight: 700; margin-top: 2rem; margin-bottom: .75rem; border-left: 4px solid #0d6efd; padding-left: .75rem; }
    .policy-section p, .policy-section li { line-height: 1.85; color: #444; }
    .toc-link { display: block; padding: .4rem .75rem; color: #0d6efd; text-decoration: none; border-radius: 8px; }
    .toc-link:hover { background: #eff6ff; }
</style>

<section class="security-hero">
    <div class="container">
        <h1><i class="bi bi-shield-fill-check me-2"></i>Güvenlik Politikası</h1>
        <p class="opacity-90 mb-1">Platform güvenliği, veri koruma ve kullanım güvencelerimiz</p>
        <small class="opacity-75">Son güncelleme: Mart 2025</small>
    </div>
</section>

<div class="bg-light py-5">
    <div class="container">
        <div class="row g-4">

            <!-- İçindekiler -->
            <div class="col-lg-3">
                <div class="card border-0 rounded-4 shadow-sm sticky-top" style="top:1.5rem;">
                    <div class="card-body p-3">
                        <h6 class="fw-bold mb-3 text-muted">İÇİNDEKİLER</h6>
                        <a href="#veri-guvenligi" class="toc-link">1. Veri Güvenliği</a>
                        <a href="#sifreleme" class="toc-link">2. Şifreleme</a>
                        <a href="#hesap-guvenligi" class="toc-link">3. Hesap Güvenliği</a>
                        <a href="#odeme-guvenligi" class="toc-link">4. Ödeme Güvenliği</a>
                        <a href="#kisisel-veriler" class="toc-link">5. Kişisel Veriler</a>
                        <a href="#guvenlik-aciklari" class="toc-link">6. Güvenlik Açıkları</a>
                        <a href="#cerezler" class="toc-link">7. Çerezler</a>
                        <a href="#iletisim" class="toc-link">8. İletişim</a>
                    </div>
                </div>
            </div>

            <!-- İçerik -->
            <div class="col-lg-9">
                <div class="card policy-card">
                    <div class="card-body policy-section">

                        <div id="veri-guvenligi">
                        <h5>1. Veri Güvenliği</h5>
                        <p>
                            SEN-T PAZAR olarak platform kullanıcılarının kişisel ve finansal verilerini korumak en yüksek önceliğimizdir.
                            Tüm veriler sektör standartlarına uygun güvenlik protokolleri ile korunmaktadır.
                        </p>
                        <ul>
                            <li>Veriler, güvenli sunucular üzerinde şifreli biçimde depolanır</li>
                            <li>Sunucu erişimleri iki faktörlü doğrulama ile korunur</li>
                            <li>Düzenli güvenlik taramaları ve penetrasyon testleri uygulanır</li>
                            <li>Veri yedekleri şifreli olarak ayrı lokasyonlarda saklanır</li>
                        </ul>
                        </div>

                        <div id="sifreleme">
                        <h5>2. Şifreleme</h5>
                        <ul>
                            <li><strong>HTTPS/TLS:</strong> Tüm web trafiği TLS 1.3 ile şifrelenir</li>
                            <li><strong>Parola Hashing:</strong> Şifreler BCrypt algoritmasıyla saklanır, düz metin olarak tutulmaz</li>
                            <li><strong>Veri Şifreleme:</strong> Hassas veriler AES-256 ile şifrelenerek depolanır</li>
                            <li><strong>SSL Sertifikası:</strong> Platform aktif SSL sertifikası ile çalışır</li>
                        </ul>
                        </div>

                        <div id="hesap-guvenligi">
                        <h5>3. Hesap Güvenliği</h5>
                        <ul>
                            <li>Başarısız giriş denemelerinde hesap geçici olarak kilitlenir</li>
                            <li>Şüpheli oturum tespitinde bildirim e-postası gönderilir</li>
                            <li>Oturumlar belirli süre hareketsizlikte otomatik sonlandırılır</li>
                            <li>Parola sıfırlama bağlantıları tek kullanımlıktır ve süreli geçerlidir</li>
                        </ul>
                        </div>

                        <div id="odeme-guvenligi">
                        <h5>4. Ödeme Güvenliği</h5>
                        <ul>
                            <li>Kart bilgileri platformda saklanmaz</li>
                            <li>Ödeme işlemleri PCI-DSS uyumlu sağlayıcılar tarafından işlenir</li>
                            <li>Şüpheli işlemlerde ek doğrulama talep edilir</li>
                            <li>Havale işlemleri admin onayından geçtikten sonra aktif edilir</li>
                        </ul>
                        </div>

                        <div id="kisisel-veriler">
                        <h5>5. Kişisel Veriler</h5>
                        <p>
                            Kişisel verileriniz 6698 Sayılı KVKK kapsamında korunmaktadır.
                            Detaylı bilgi için <a href="@Url.Action("Kvkk", "Home")" class="text-primary">KVKK Aydınlatma Metni</a>'ni inceleyiniz.
                        </p>
                        <ul>
                            <li>Yalnızca hizmet sunumu için gerekli veriler toplanır</li>
                            <li>Üçüncü taraflarla paylaşım ancak yasal zorunluluk veya açık rıza ile yapılır</li>
                            <li>Hesap silinmesi halinde kişisel veriler yasal saklama süresi sonunda imha edilir</li>
                        </ul>
                        </div>

                        <div id="guvenlik-aciklari">
                        <h5>6. Güvenlik Açığı Bildirimi</h5>
                        <p>
                            Platformda bir güvenlik açığı keşfederseniz lütfen bize bildirin. Sorumlu açıklama politikamız çerçevesinde:
                        </p>
                        <ul>
                            <li>Bildirimleri <strong>guvenlik@sent-pazar.com</strong> adresine iletin</li>
                            <li>Bildirilen sorunlar en fazla 72 saat içinde yanıtlanır</li>
                            <li>Doğrulanan kritik açıklar teşekkür listesinde yer alır</li>
                        </ul>
                        </div>

                        <div id="cerezler">
                        <h5>7. Çerez (Cookie) Politikası</h5>
                        <ul>
                            <li><strong>Zorunlu Çerezler:</strong> Oturum ve güvenlik için gerekli</li>
                            <li><strong>Tercih Çerezleri:</strong> Dil ve görünüm tercihlerinizi hatırlar</li>
                            <li><strong>Analitik Çerezler:</strong> Platform iyileştirme amaçlı, anonim veri</li>
                            <li>Tarayıcı ayarlarınızdan çerezleri yönetebilirsiniz</li>
                        </ul>
                        </div>

                        <div id="iletisim">
                        <h5>8. İletişim</h5>
                        <p>
                            Güvenlik konularındaki sorularınız için:
                            <strong>guvenlik@sent-pazar.com</strong><br>
                            Genel destek: <a href="@Url.Action("Contact", "Home")" class="text-primary">İletişim Formu</a>
                        </p>
                        </div>

                        <div class="alert alert-info border-0 mt-4">
                            <i class="bi bi-info-circle me-2"></i>
                            Bu politika gerektiğinde güncellenir. Önemli değişiklikler e-posta ile bildirilir.
                        </div>

                        <div class="mt-4 d-flex gap-2 flex-wrap">
                            <a asp-action="Kvkk" asp-controller="Home" class="btn btn-outline-primary">KVKK Metni</a>
                            <a asp-action="SecurePayment" asp-controller="Home" class="btn btn-outline-success">Güvenli Ödeme</a>
                            <a asp-action="Index" asp-controller="Home" class="btn btn-outline-secondary">Ana Sayfa</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
