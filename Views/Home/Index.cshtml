@if (shouldShowSearchResults && searchResults.Count > 0)
{
    <section class="section market-board reveal">
        <div class="container wide-panel">
                <div class="section__head section__head--light">
                    <h2>@listingBoardTitle</h2>
                    <p id="listing-search-count">@(searchResults.Count == 0 ? 0 : 1) - @Math.Min(12, searchResults.Count) / @searchResults.Count ilan görüntüleniyor</p>
                </div>
                <form method="get" asp-action="@formAction" asp-controller="Home" class="listing-sort-toolbar">
                    @if (Model.IsCategoryPage)
                    {
                        <input type="hidden" name="slug" value="@Model.CurrentCategorySlug" />
                    }
                    <input type="hidden" name="showResults" value="@Model.ShowResults.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="listingType" value="@Model.ListingType" />
                    <input type="hidden" name="city" value="@Model.City" />
                    <input type="hidden" name="category" value="@Model.Category" />
                    <input type="hidden" name="subCategory" value="@Model.SubCategory" />
                    <input type="hidden" name="priceRange" value="@Model.PriceRange" />
                    <input type="hidden" name="keyword" value="@Model.Keyword" />
                    <label for="listingSortSelect">@L["sortBy"]</label>
                    <select id="listingSortSelect" name="sortBy" onchange="this.form.submit()">
                        @foreach (var sortOption in Model.SortOptions)
                        {
                            <option value="@sortOption" selected="@(sortOption == Model.SortBy)">@L.SortLabel(sortOption)</option>
                        }
                    </select>
                </form>
                <div class="mobile-search-dock" data-mobile-search-dock>
                    <button type="button" class="mobile-search-dock__btn" data-dock-action="filter">
                        <i class="bi bi-funnel"></i>
                        <span>@T("Filtrele", "Filter", "Фильтр", "تصفية", "فیلتر")</span>
                    </button>
                    <button type="button" class="mobile-search-dock__btn" data-dock-action="sort">
                        <i class="bi bi-sort-down"></i>
                        <span>@T("Sırala", "Sort", "Сортировка", "ترتيب", "مرتب‌سازی")</span>
                    </button>
                    <button type="button" class="mobile-search-dock__btn" data-dock-action="top">
                        <i class="bi bi-arrow-up"></i>
                        <span>@T("Yukarı", "Top", "Наверх", "للأعلى", "بالا")</span>
                    </button>
                </div>
                <div class="market-board__grid market-board__grid--compact reveal-stagger" data-load-more-grid="true" data-total-count="@searchResults.Count" data-page-size="12" data-counter-id="listing-search-count" data-button-id="listing-load-more-btn">
                    @foreach (var listing in searchResults)
                    {
                        <article class="listing-card listing-card--compact">
                            <div class="listing-card__media-shell">
                                <a class="listing-card__media" asp-action="Details" asp-controller="Home" asp-route-id="@listing.Id">
                                      <img src="@listing.ImageUrl" 
                                          alt="@listing.Title" 
                                         loading="lazy" 
                                         referrerpolicy="no-referrer"
                                         onerror="this.onerror=null;this.src='/img/placeholder.svg';" />
                                    <div class="listing-card__hover-preview">
                                        <span class="preview-btn">@T("Detayları Gör", "View Details", "Подробнее", "عرض التفاصيل", "مشاهده جزئیات")</span>
                                    </div>
                                </a>
                                 <button type="button"
                                         class="btn-favorite heart-btn listing-card__favorite"
                                         data-listing-id="@listing.Id"
                                         title="@T("Favorilerime ekle", "Add to Favorites", "Добавить в избранное", "أضف إلى المفضلة", "افزودن به علاقة‌مندی‌ها")"
                                         aria-label="@T("Favorilerime ekle", "Add to Favorites", "Добавить в избранное", "أضف إلى المفضلة", "افزودن به علاقة‌مندی‌ها")">
                                     <svg class="heart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                         <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                                     </svg>
                                 </button>
                                 <button type="button"
                                         class="btn-compare"
                                         data-id="@listing.Id"
                                         title="@T("Karşılaştır", "Compare", "Сравнить", "قارن", "مقایسه")"
                                         aria-label="@T("Karşılaştır", "Compare", "Сравнить", "قارن", "مقایسه")">
                                     <i class="bi bi-intersect me-1"></i>@T("Karşılaştır", "Compare", "Сравнить", "قارن", "مقایسه")
                                 </button>
                            </div>
                            <div class="listing-card__body">
                                <div class="listing-card__topline">
                                    <span class="listing-card__category">@BrowseCategoryText(listing)</span>
                                </div>
                                <h3>
                                    <a asp-action="Details" asp-controller="Home" asp-route-id="@listing.Id">@listing.Title</a>
                                </h3>
                                <p class="listing-card__location">@FormatListingLocation(listing.City, listing.Location)</p>
                                <a class="listing-card__seller" style="text-decoration: none; color: inherit; cursor: pointer;" 
                                   asp-action="@(listing.SellerIsCorporate ? "Store" : "SellerProfile")" 
                                   asp-controller="Home" 
                                   asp-route-id="@listing.UserId"
                                   title="@($"{SellerDisplayName(listing)} profili")">
                                    <span class="listing-card__seller-avatar" aria-hidden="true">
                                        <img src="@SellerVisualUrl(listing)" class="@(listing.SellerIsCorporate ? "is-logo" : "is-photo")" alt="@SellerDisplayName(listing)" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/img/placeholder.svg';this.classList.remove('is-logo');this.classList.add('is-photo');" />
                                    </span>
                                     <span class="listing-card__seller-copy">
                                         <strong>@SellerDisplayName(listing)</strong>
                                         @if (!string.IsNullOrWhiteSpace(SellerSecondaryText(listing)))
                                         {
                                             <small>@SellerSecondaryText(listing)</small>
                                         }
                                         @if (listing.SellerIsCorporate && listing.IsVerifiedSeller)
                                         {
                                             <span class="badge badge-verified ms-2" title="Doğrulanmış Satıcı">✓</span>
                                         }
                                     </span>
                                </a>
                                <p class="listing-card__summary">@listing.Summary</p>
                                <div class="listing-card__meta">
                                    <span><i class="bi bi-speedometer2"></i>@listing.PrimarySpec</span>
                                    <span><i class="bi bi-tags"></i>@listing.SecondarySpec</span>
                                </div>
                                <div class="listing-card__footer">
                                    <strong class="listing-card__price">@listing.PriceLabel</strong>
                                    <a class="project-link btn btn-sm" asp-action="Details" asp-controller="Home" asp-route-id="@listing.Id">@T("Detayları Gör", "View Details", "Подробнее", "عرض التفاصيل", "مشاهده جزئیات")</a>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                @if (searchResults.Count > 12)
                {
                    <div class="market-board__actions">
                        <button type="button" class="market-board__load-more" id="listing-load-more-btn">@T("Daha Fazla Yükle", "Load More", "Показать ещё", "عرض المزيد", "نمایش بیشتر")</button>
                    </div>
                }
        </div>
    </section>
}

@if (searchResults.Count == 0 && shouldShowSearchResults)
