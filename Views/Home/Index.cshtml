<section class="section home-search-dock">
    <div class="container wide-panel">
        <form class="search-panel home-search-dock__panel"
              role="search"
              method="get"
              asp-action="@formAction"
              asp-controller="Home"
              data-is-category-page="@Model.IsCategoryPage.ToString().ToLowerInvariant()"
              data-current-category="@Model.Category"
              data-home-url="@Url.Action("Index", "Home")">
            @if (Model.IsCategoryPage)
            {
                <input type="hidden" name="slug" value="@Model.CurrentCategorySlug" />
            }
            <input type="hidden" name="showResults" value="true" />
            <div class="search-panel__listing-tabs" role="tablist" aria-label="@L["listingType"]">
                @foreach (var tab in Model.SearchTabs)
                {
                    <button type="button"
                            class="search-panel__listing-tab @(tab.IsActive ? "is-active" : string.Empty)"
                            data-listing-type="@tab.ListingType"
                            data-preset-category="@tab.PresetCategory"
                            aria-pressed="@(tab.IsActive ? "true" : "false")">
                        @tab.Label
                    </button>
                }
            </div>
            <div class="search-panel__intro">
                <div class="search-panel__intro-copy">
                    <span class="search-panel__badge">@L["smartSearch"]</span>
                    <strong>@L["searchIntroTitle"]</strong>
                    <p>@L["searchIntroText"]</p>
                </div>
            </div>
            <div class="search-panel__shell">
                <div class="search-panel__primary-row">
                    <select id="listingType" name="listingType" class="search-panel__visually-hidden" aria-label="@L["listingType"]">
                        @foreach (var option in Model.ListingTypeOptions)
                        {
                            <option value="@option" selected="@(option == Model.ListingType)">@L.TypeLabel(option)</option>
                        }
                    </select>
                    <div class="search-panel__main-grid">
                        <div class="search-panel__main-field">
                            <select id="category" name="category" aria-label="@L["category"]">
                                <option value="all" data-url="@Url.Action("Index", "Home")" selected="@(Model.Category == "all")">@L["allCategories"]</option>
                                @foreach (var category in Model.CategoryOptions.Where(x => x != "all"))
                                {
                                 <option value="@category"
                                             data-url="@L.BuildCategoryUrl(category)"
                                             selected="@(category == Model.Category)">
                                        @(category == "secondhand" || category == "other" ? "Diğer" : CategoryText(category))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="search-panel__main-field">
                            <select id="subCategory" name="subCategory" aria-label="@L["subCategory"]">
                                <option value="all">@T("Tüm alt kategoriler", "All subcategories", "Все подкатегории", "جميع الفئات الفرعية")</option>
                            </select>
                        </div>
                        <div class="search-panel__main-field">
                            <div class="city-picker" id="cityPicker">
                                <button type="button" class="city-picker__toggle" id="cityPickerToggle" aria-haspopup="true" aria-expanded="false">
                                    <span id="cityPickerLabel">@L["allCities"]</span>
                                    <i class="bi bi-chevron-down"></i>
                                </button>
                                <div class="city-picker__panel" id="cityPickerPanel" hidden>
                                    <div class="city-picker__grid">
                                        <aside class="city-picker__cities" id="cityPickerCities"></aside>
                                        <section class="city-picker__villages">
                                            <div class="city-picker__villages-head" id="cityPickerVillagesTitle">@T("Mahalle / Köy", "Neighborhood / Village", "Район / Деревня", "الحي / القرية", "محله / روستا")</div>
                                            <div class="city-picker__villages-list" id="cityPickerVillages"></div>
                                            <button type="button" class="city-picker__apply" id="cityPickerApply">@T("Filtreyi Uygula", "Apply Filter", "Применить фильтр", "تطبيق الفلتر", "اعمال فیلتر")</button>
                                        </section>
                                    </div>
                                </div>
                            </div>
                            <select id="city" name="city" class="search-panel__visually-hidden" aria-label="@L["city"]">
                                <option value="all" selected="@(Model.City == "all")">@L["allCities"]</option>
                                @foreach (var city in kktcLocationTree.Keys.OrderBy(x => x))
                                {
                                    <option value="@city" selected="@(city == Model.City)">@LocalizeCityName(city)</option>
                                    var districts = kktcLocationTree[city];
                                    foreach (var district in districts)
                                    {
                                        var districtValue = $"{city}::{district.Key}";
                                        <option value="@districtValue" selected="@(districtValue == Model.City)">@city / @district.Key</option>

                                        foreach (var village in district.Value)
                                        {
                                            var villageValue = $"{city}::{village}";
                                            <option value="@villageValue" selected="@(villageValue == Model.City)">@city / @district.Key / @village</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                         <div class="search-panel__main-field" style="display: flex; gap: 6px; align-items: center;">
                             <input type="number" id="minPrice" name="minPrice" placeholder="Min ₺" 
                                    value="@(Model.MinPrice?.ToString() ?? "")" 
                                    class="form-control form-control-sm" style="width: 110px;" />
                             <input type="number" id="maxPrice" name="maxPrice" placeholder="Max ₺" 
                                    value="@(Model.MaxPrice?.ToString() ?? "")" 
                                    class="form-control form-control-sm" style="width: 110px;" />
                         </div>
                        <div class="search-panel__main-field">
                            <select id="sortBy" name="sortBy" aria-label="@L["sortBy"]">
                                @foreach (var sort in Model.SortOptions)
                                {
                                    <option value="@sort" selected="@(sort == Model.SortBy)">@L.SortLabel(sort)</option>
                                }
                            </select>
                        </div>
                        <div class="search-panel__search-button-wrap">
                            <button type="submit" class="search-panel__search-button">
                                <span>@L["search"]</span>
                                <i class="bi bi-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" id="keyword" name="keyword" value="@Model.Keyword" />
        </form>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
    
            });
        </script>
        <div id="savedSearchFeedback" class="small text-success mt-2" style="display:none;"></div>
    </div>
</section>

