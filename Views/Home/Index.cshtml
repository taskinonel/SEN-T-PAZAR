@model SEN_T_PAZAR.Models.HomePageViewModel
@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    if (ViewData["Title"] is null)
    {
        ViewData["Title"] = "SEN-T PAZAR-DİJİTAL ÇARŞI";
    }

    if (ViewData["UseRawTitle"] is null)
    {
        ViewData["UseRawTitle"] = true;
    }

    if (ViewData["MetaDescription"] is null)
    {
        ViewData["MetaDescription"] = "SEN-T PAZAR DİJİTAL ÇARŞI üzerinde emlak, vasıta, elektronik, eşya ve hizmet ilanlarını inceleyin.";
    }

    if (ViewData["MetaKeywords"] is null)
    {
        ViewData["MetaKeywords"] = "SEN-T PAZAR, dijital çarşı, ilanlar, emlak, vasıta, elektronik, hizmet";
    }

    var formAction = Model.IsCategoryPage ? "Category" : "Index";
    var hasActiveFilters = Model.ListingType != "all"
        || Model.City != "all"
        || Model.SubCategory != "all"
        || Model.PriceRange != "any"
        || Model.SortBy != "latest"
        || !string.IsNullOrWhiteSpace(Model.Keyword);
    var shouldShowSearchResults = Model.ShowResults || hasActiveFilters || Model.IsCategoryPage;
    var listingBoardTitle = shouldShowSearchResults
        ? T("Arama Sonuçları", "Search Results", "Результаты поиска", "نتائج البحث")
        : L["showcase"];
    string CategoryText(string code) => L.CategoryLabel(code);
    string BrowseCategoryText(SEN_T_PAZAR.Models.PropertyCard item) => L.CategoryLabel(SEN_T_PAZAR.Models.ListingTaxonomy.GetBrowseCategoryCode(item.Category, item.SubCategory));
    string CategoryIconClass(string categoryCode) => categoryCode switch
    {
        "realestate" => "bi-house-door-fill",
        "land" => "bi-map-fill",
        "vehicle" => "bi-car-front-fill",
        "electronics" => "bi-tv-fill",
        "home" => "bi-lamp-fill",
        "services" => "bi-briefcase-fill",
        "tutoring" => "bi-mortarboard-fill",
        "jobs" => "bi-person-workspace",
        "helper" => "bi-people-fill",
        "secondhand" => "bi-box-seam-fill",
        "fashion" => "bi-bag-fill",
        "equipment" => "bi-tools",
        _ => "bi-grid-fill"
    };
    string PriceRangeText(string code) => code switch
    {
        "any" => L["anyPrice"],
        "low" => L["priceLow"],
        "mid" => L["priceMid"],
        "high" => L["priceHigh"],
        _ => L["anyPrice"]
    };
    string CategoryCardImageUrl(string categoryCode) => SEN_T_PAZAR.Models.ListingTaxonomy.GetCategoryCardImageUrl(categoryCode);
    string T(string tr, string en, string ru, string ar, string? fa = null) => L.CultureCode switch
    {
        "en" => en,
        "ru" => ru,
        "ar" => ar,
        "fa" => fa ?? en ?? tr,
        _ => tr
    };
    string FormatListingLocation(string? cityName, string? location)
    {
        var localizedCity = LocalizeCityName(string.IsNullOrWhiteSpace(cityName) ? T("Belirtilmedi", "Unspecified", "Не указано", "غير محدد", "مشخص نشده") : cityName);
        if (string.IsNullOrWhiteSpace(location) || string.Equals(location, cityName, StringComparison.OrdinalIgnoreCase))
        {
            return localizedCity;
        }

        return $"{localizedCity} - {location}";
    }
