            function getCategoryFilters(categoryKey, selectedSubCategory) {
                const normalized = normalizeCategoryKey(categoryKey);
                if (!normalized || normalized === 'all') {
                    return [];
                }

                const filters = [];
                let categoryDetailFilters = categorySpecific[normalized] || [];

                if (normalized === 'realestate') {
                    if (selectedSubCategory === 'arsa') {
                        categoryDetailFilters = [];
                    } else if (selectedSubCategory === 'ticari') {
                        categoryDetailFilters = [
                            {
                                ...categorySpecific.realestate[0],
                                options: ['@T("Ofis", "Office", "Офис", "مكتب")', '@T("Dükkan", "Store", "Магазин", "متجر")', '@T("Depo", "Warehouse", "Склад", "مستودع")', '@T("Mağaza", "Shop", "Магазин", "متجر")', '@T("Atölye", "Workshop", "Мастерская", "ورشة")']
                            }
                        ];
                    } else {
                        categoryDetailFilters = categorySpecific.realestate || [];
                    }
                }

                if (categoryDetailFilters.length > 0) {
                    filters.push(...categoryDetailFilters);
                }

                const supplementalAllowedCategories = new Set(['electronics', 'home', 'services', 'tutoring', 'jobs', 'helper', 'parts']);
                if (filters.length > 0 && supplementalAllowedCategories.has(normalized)) {
                    filters.push(...supplementalFilters);
                }

                return filters;
            }

            function resolveOptions(filter, selectedValues) {
                if (filter.dependsOn && filter.optionsByParent) {
                    const parentValue = selectedValues[filter.dependsOn] || '';
                    if (parentValue && filter.optionsByParent[parentValue]) {
                        return filter.optionsByParent[parentValue];
                    }

                    if (filter.key === 'heating' && parentValue) {
                        const allHeatingOptions = Object.values(filter.optionsByParent).flat();
                        return Array.from(new Set(allHeatingOptions));
                    }

                    return [];
                }

                if (filter.dependsOn) {
                    const parentValue = selectedValues[filter.dependsOn] || '';
                    if (!parentValue) {
                        return [];
                    }
                }

                return filter.options || [];
            }

            function syncListingTabs(listingType, selectedCategory) {
                listingTypeTabs.forEach((tab) => {
                    const tabType = tab.getAttribute('data-listing-type') || 'all';
                    const presetCategory = tab.getAttribute('data-preset-category') || 'all';
                    const isActive = tabType === listingType && (
                        presetCategory === 'helper'
                            ? selectedCategory === 'helper'
                            : tabType === 'job' && presetCategory === 'jobs'
                                ? selectedCategory !== 'helper'
                                : true
                    );

                    tab.classList.toggle('is-active', isActive);
                    tab.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                });
            }

            function applyPrimarySelectChain() {
                if (!listingTypeSelect || !citySelect || !categorySelect || !priceRangeSelect || !sortBySelect) {
                    updateFilters();
                    return;
                }

                const listingType = listingTypeSelect.value || 'all';
                const preservedCity = citySelect.value || 'all';
                const preservedCategory = categorySelect.value || 'all';
                const preservedPrice = priceRangeSelect.value || 'any';
                const preservedSort = sortBySelect.value || 'latest';

                const allowedCategories = categoryByListingType[listingType] || categoryByListingType.all || allCategoryOptions.map((x) => x.value);
                const categoryCandidates = allCategoryOptions.filter((x) => allowedCategories.includes(x.value));
                setSelectOptions(categorySelect, categoryCandidates, preservedCategory, 'all');
                categorySelect.disabled = false;

                const selectedCategory = categorySelect.value || 'all';
                const allowedCities = cityByCategory[selectedCategory] || cityByCategory.all;
                const cityCandidates = allCityOptions.filter((x) =>
                    allowedCities.includes(x.value) ||
                    allowedCities.some((allowedCity) => x.value.startsWith(`${allowedCity}::`))
                );
                setSelectOptions(citySelect, cityCandidates, preservedCity, 'all');
                citySelect.disabled = false;

                const selectedPrice = priceRangeSelect.value || preservedPrice;
                const selectedSort = sortBySelect.value || preservedSort;

                setSelectOptions(priceRangeSelect, allPriceRangeOptions, selectedPrice, 'any');
                priceRangeSelect.disabled = false;

                setSelectOptions(sortBySelect, allSortOptions, selectedSort, 'latest');
                sortBySelect.disabled = false;

                if (!allCategoryOptions.some((x) => x.value === categorySelect.value)) {
                    setSelectOptions(categorySelect, categoryCandidates, 'all', 'all');
                }

                syncListingTabs(listingTypeSelect.value, categorySelect.value || 'all');

                updateFilters();
            }

            function updateFilters() {
                if (!categorySelect || !featuresContainer) return;

                featuresContainer.classList.add('is-updating');
                window.setTimeout(() => featuresContainer.classList.remove('is-updating'), 260);
                
                const selectedCategory = categorySelect.value;
                const selectedSubCategory = subCategorySelect?.value || 'all';

                const filters = getCategoryFilters(selectedCategory || 'all', selectedSubCategory);

                if (filters && filters.length > 0) {
                    featuresContainer.innerHTML = '';
                    featuresContainer.classList.add('search-subfilters');

                    const selectRegistry = {};

                    filters.forEach(function(filter, idx) {
                        const groupDiv = document.createElement('div');
                        groupDiv.className = 'subfilter-card';

                        const isManualInput = filter.manual === true || filter.key === 'area';
                        const selectEl = isManualInput
                            ? document.createElement('input')
                            : document.createElement('select');
                        if (isManualInput) {
                            selectEl.type = 'text';
                            selectEl.className = 'subfilter-card__input';
                        } else {
                            selectEl.className = 'subfilter-card__select';
                        }
                        selectEl.name = filter.key;
                        selectEl.dataset.filterKey = filter.key;
                        selectEl.setAttribute('aria-label', getFilterPrompt(selectedCategory, filter, idx));
                        selectEl.title = getFilterPrompt(selectedCategory, filter, idx);
                        selectRegistry[filter.key] = selectEl;

                        groupDiv.appendChild(selectEl);

                        featuresContainer.appendChild(groupDiv);
                    });

                    const refreshFrom = (startIndex = 0) => {
                        const selectedValues = {};

                        filters.forEach(function(filter, index) {
                            const selectEl = selectRegistry[filter.key];
                            if (index < startIndex) {
                                selectedValues[filter.key] = selectEl.value;
                                return;
                            }

                            const previous = selectEl.value;
                            const options = resolveOptions(filter, selectedValues);

                            selectEl.innerHTML = '';
                            const defaultOption = document.createElement('option');
                            defaultOption.value = 'all';
                            defaultOption.textContent = getFilterPrompt(selectedCategory, filter, index);
                            selectEl.appendChild(defaultOption);

                            if (filter.key === 'area') {
                                const inputEl = selectEl;
                                inputEl.disabled = false;
                                inputEl.value = previous !== 'all' ? previous : '';
                                inputEl.placeholder = getFilterPrompt(selectedCategory, filter, index);
                                inputEl.addEventListener('input', function () {
                                    selectedValues[filter.key] = inputEl.value.trim() || 'all';
                                    refreshFrom(index + 1);
                                });
                                selectedValues[filter.key] = inputEl.value.trim() || 'all';
                                return;
                            }

                            if (options.length === 0) {
                                selectEl.disabled = true;
                                selectedValues[filter.key] = 'all';
                                return;
                            }

                            selectEl.disabled = false;
                            options.forEach(function(optLabel) {
                                const normalizedValue = typeof optLabel === 'string'
                                    ? decodeLocalized(optLabel)
                                    : decodeLocalized(optLabel.value || '');
                                const normalizedLabel = typeof optLabel === 'string'
                                    ? decodeLocalized(optLabel)
                                    : decodeLocalized(optLabel.label || optLabel.value || '');
                                const optionEl = document.createElement('option');
                                optionEl.value = normalizedValue;
                                optionEl.textContent = normalizedLabel;
                                if (previous === normalizedValue || (previous === 'all' && currentSubCategory === normalizedValue)) {
                                    optionEl.selected = true;
                                }
                                selectEl.appendChild(optionEl);
                            });

                            selectedValues[filter.key] = selectEl.value;
                        });
                    };

                    filters.forEach(function(filter, index) {
                        const selectEl = selectRegistry[filter.key];
                        selectEl.addEventListener('change', function() {
                            refreshFrom(index + 1);
                        });
                    });

                    refreshFrom(0);
                    
                    featuresContainer.style.display = 'grid';
                } else {
                    featuresContainer.style.display = 'none';
                    featuresContainer.innerHTML = '';
                }
            }

            if (listingTypeSelect) {
                listingTypeSelect.addEventListener('change', applyPrimarySelectChain);
            }
            listingTypeTabs.forEach((tab) => {
                tab.addEventListener('click', function() {
                    if (!listingTypeSelect) {
                        return;
                    }

                    const nextListingType = tab.getAttribute('data-listing-type') || 'all';
                    const presetCategory = tab.getAttribute('data-preset-category') || 'all';

                    listingTypeSelect.value = nextListingType;
                    applyPrimarySelectChain();

                    if (categorySelect && presetCategory !== 'all') {
                        const hasPresetCategory = Array.from(categorySelect.options).some((option) => option.value === presetCategory);
                        if (hasPresetCategory) {
                            categorySelect.value = presetCategory;
                            applyPrimarySelectChain();
                        }
                    }
                    // When switching to the Services listing/tab, clear any selected subcategory
                    if (presetCategory === 'services' || nextListingType === 'service') {
                        if (subCategorySelect) {
                            subCategorySelect.value = 'all';
                            subCategorySelect.dispatchEvent(new Event('change'));
                        }
