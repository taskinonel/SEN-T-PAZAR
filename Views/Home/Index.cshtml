                            '110-135 m²': ['@T("Merkezi", "Central", "Центральное", "مركزي")', '@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '120-160 m²': ['@T("Merkezi", "Central", "Центральное", "مركزي")', '@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '160-220 m²': ['@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Merkezi", "Central", "Центральное", "مركزي")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Soba", "Stove", "Печь", "مدفأة")'],
                            '180-260 m²': ['@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '260-340 m²': ['@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '250-350 m²': ['@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '350+ m²': ['@T("Yerden", "Underfloor", "Теплый пол", "تدفئة أرضية")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '30-50 m²': ['@T("Klima", "Air Conditioning", "Кондиционер", "تكييف")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")'],
                            '50-70 m²': ['@T("Klima", "Air Conditioning", "Кондиционер", "تكييف")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")'],
                            '60-120 m²': ['@T("Merkezi", "Central", "Центральное", "مركزي")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")'],
