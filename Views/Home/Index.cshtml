    string SellerDisplayName(PropertyCard item)
    {
        if (item.SellerIsCorporate && !string.IsNullOrWhiteSpace(item.SellerCompanyName))
        {
            return item.SellerCompanyName;
        }

        return string.IsNullOrWhiteSpace(item.SellerName)
            ? T("İlan Sahibi", "Listing Owner", "Владелец объявления", "صاحب الإعلان", "صاحب آگهی")
            : item.SellerName;
    }
    string SellerSecondaryText(PropertyCard item)
    {
        var parts = new List<string>();

        if (item.SellerIsCorporate)
        {
            if (!string.IsNullOrWhiteSpace(item.SellerName) && !string.Equals(item.SellerName, item.SellerCompanyName, StringComparison.OrdinalIgnoreCase))
            {
                parts.Add(item.SellerName);
            }

            if (!string.IsNullOrWhiteSpace(item.SellerRole))
            {
                parts.Add(item.SellerRole);
            }
        }
        else
        {
            if (!string.IsNullOrWhiteSpace(item.SellerRole))
            {
                parts.Add(item.SellerRole);
            }

            if (!string.IsNullOrWhiteSpace(item.SellerCity))
            {
                parts.Add(LocalizeCityName(item.SellerCity));
            }
        }

        return string.Join(" • ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
    string SellerVisualUrl(PropertyCard item)
    {
        if (item.SellerIsCorporate && !string.IsNullOrWhiteSpace(item.SellerCompanyLogoUrl))
        {
            return item.SellerCompanyLogoUrl;
        }

        if (!string.IsNullOrWhiteSpace(item.SellerAvatarUrl))
        {
            return item.SellerAvatarUrl;
        }

        if (!string.IsNullOrWhiteSpace(item.SellerCompanyLogoUrl))
        {
            return item.SellerCompanyLogoUrl;
        }

        return "/img/placeholder.svg";
    }
