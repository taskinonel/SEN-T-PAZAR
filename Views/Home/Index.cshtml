                                <div class="homepage-spotlight__subpanel-head">
                                    <h4>@T("Popüler Şehirler", "Popular Cities", "Популярные города", "المدن الشائعة", "شهرهای محبوب")</h4>
                                    <p>@T("İlan yoğunluğu en yüksek şehirler öne çıkanların hemen altında listeleniyor.", "The highest-density cities are listed just below featured picks.", "Города с самой высокой плотностью объявлений перечислены сразу под рекомендуемыми.", "المدن الأعلى كثافة في الإعلانات تظهر مباشرة أسفل الإعلانات المميزة.", "شهرهایی با بیشترین تراکم آگهی درست زیر بخش ویژه‌ها نمایش داده می‌شوند.")</p>
                                </div>
                                <div class="top-viewed-grid homepage-spotlight__mini-grid">
                                    @foreach (var city in Model.RegionSpots.OrderByDescending(x => x.ListingCount).Take(6))
                                    {
                                        <a class="top-viewed-card" href="@Url.Action("Index", "Home", new { city = city.Name })">
                                            <span class="top-viewed-card__image" style="background-image:url('@city.ImageUrl')">
                                                <i class="top-viewed-card__img-icon bi bi-geo-alt-fill"></i>
                                            </span>
                                            <span class="top-viewed-card__title"><i class="bi bi-pin-map me-1"></i>@LocalizeCityName(city.Name)</span>
                                            <small><span class="js-countup" data-target="@city.ListingCount">0</span> @T("aktif ilan", "active listings", "активных объявлений", "إعلانًا نشطًا", "آگهی فعال")</small>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const listingTypeSelect = document.getElementById('listingType');
            const listingTypeTabs = document.querySelectorAll('.search-panel__listing-tab');
            const citySelect = document.getElementById('city');
            const cityPicker = document.getElementById('cityPicker');
            const cityPickerToggle = document.getElementById('cityPickerToggle');
            const cityPickerPanel = document.getElementById('cityPickerPanel');
            const cityPickerLabel = document.getElementById('cityPickerLabel');
            const cityPickerCities = document.getElementById('cityPickerCities');
            const cityPickerVillages = document.getElementById('cityPickerVillages');
            const cityPickerVillagesTitle = document.getElementById('cityPickerVillagesTitle');
            const cityPickerApply = document.getElementById('cityPickerApply');
            const categorySelect = document.getElementById('category');
            const priceRangeSelect = document.getElementById('priceRange');
            const sortBySelect = document.getElementById('sortBy');
            const listingSortSelect = document.getElementById('listingSortSelect');
            const featuresContainer = document.getElementById('dynamic-features-container');
            const mobileSearchDock = document.querySelector('[data-mobile-search-dock]');
            const decodeLocalized = (value) => {
                if (typeof value !== 'string' || value.indexOf('&') === -1) {
                    return value;
                }

                const textArea = document.createElement('textarea');
                textArea.innerHTML = value;
                return textArea.value;
            };

            const allCitiesText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["allCities"]));
            const allCategoriesText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(L["allCategories"]));
            const neighborhoodVillageText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T("Mahalle / Köy", "Neighborhood / Village", "Район / Деревня", "الحي / القرية", "محله / روستا")));
            const wholeCityText = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(T("Tüm şehir", "Whole city", "Весь город", "كل المدينة", "کل شهر")));

            const pickOneText = decodeLocalized('@T("Seçiniz", "Select", "Выберите", "اختر")');
            const allSubCategoriesText = decodeLocalized('@T("Tüm alt kategoriler", "All subcategories", "Все подкатегории", "جميع الفئات الفرعية")');
            const dailyRentalSubCategoryText = decodeLocalized('@T("Günlük Kiralık", "Daily Rent", "Ежедневная аренда", "إيجار يومي")');
            const toOptionData = (selectEl) => Array.from(selectEl?.options || []).map((option) => ({
                value: option.value,
                text: decodeLocalized(option.textContent || ''),
                url: option.dataset.url || ''
            }));
            const categorySubCategoryMap = @Html.Raw(Model.CategorySubCategoryJson);
            const currentSubCategory = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubCategory));

            const setSelectOptions = (selectEl, optionData, preferredValue, fallbackValue) => {
                if (!selectEl) return;

                const safeOptions = optionData || [];
                selectEl.innerHTML = '';

                safeOptions.forEach((optionDataItem) => {
                    const optionEl = document.createElement('option');
                    optionEl.value = optionDataItem.value;
                    optionEl.textContent = optionDataItem.text;
                    if (optionDataItem.url) {
                        optionEl.dataset.url = optionDataItem.url;
                    }
                    selectEl.appendChild(optionEl);
                });

                const preferredExists = safeOptions.some((item) => item.value === preferredValue);
                const fallbackExists = safeOptions.some((item) => item.value === fallbackValue);

                if (preferredExists) {
                    selectEl.value = preferredValue;
                } else if (fallbackExists) {
                    selectEl.value = fallbackValue;
                } else if (safeOptions.length > 0) {
                    selectEl.selectedIndex = 0;
                }
            };

            const allCityOptions = toOptionData(citySelect);
            const allCategoryOptions = toOptionData(categorySelect);
            const allPriceRangeOptions = toOptionData(priceRangeSelect);
            const allSortOptions = toOptionData(sortBySelect);
            const subCategorySelect = document.getElementById('subCategory');
            const categoryByListingType = @Html.Raw(Model.ListingTypeCategoryJson);
            const categoryOptionMap = Object.fromEntries(allCategoryOptions.map((option) => [option.value, option.text]));

            const buildCategoryOptions = (categoryKeys) => (categoryKeys || []).map((value) => ({
                value,
                text: categoryOptionMap[value] || value
            }));

            const getSubCategoryFiltersForSelection = (filters) => {
                let visibleFilters = Array.isArray(filters) ? [...filters] : [];
                const listingType = listingTypeSelect?.value || 'all';
                const category = categorySelect?.value || 'all';

                if (listingType === 'rent' && category === 'realestate') {
                    visibleFilters = visibleFilters.filter((item) => item.value !== 'arsa');
                    if (!visibleFilters.some((item) => item.value === 'gunluk-kiralik')) {
                        visibleFilters.push({ value: 'gunluk-kiralik', label: dailyRentalSubCategoryText });
                    }
                }
                else {
                    visibleFilters = visibleFilters.filter((item) => item.value !== 'gunluk-kiralik');
                }

                return visibleFilters;
            };

            const updateSubCategoryOptions = () => {
                if (!subCategorySelect || !categorySelect) {
                    return;
                }

                const selectedCategory = categorySelect.value || 'all';
                const filters = categorySubCategoryMap[selectedCategory] || [];
                const visibleFilters = getSubCategoryFiltersForSelection(filters);
                const options = [{ value: 'all', text: allSubCategoriesText }, ...visibleFilters.map((item) => ({ value: item.value, text: item.label }))];
                setSelectOptions(subCategorySelect, options, currentSubCategory, 'all');
                subCategorySelect.closest('.search-panel__main-field').hidden = options.length <= 1;
            };

            const applyListingTypeFilter = (listingType, presetCategory) => {
                const allowedCategoryValues = categoryByListingType[listingType] || allCategoryOptions.map((x) => x.value);
                const allowedOptions = buildCategoryOptions(allowedCategoryValues);
                const selectedCategory = allowedCategoryValues.includes(categorySelect.value)
                    ? categorySelect.value
                    : (presetCategory && presetCategory !== 'all' && allowedCategoryValues.includes(presetCategory)
                        ? presetCategory
                        : 'all');

                setSelectOptions(categorySelect, allowedOptions, selectedCategory, 'all');
                updateSubCategoryOptions();
            };

            categorySelect?.addEventListener('change', function () {
                updateSubCategoryOptions();
            });

            listingTypeTabs.forEach((tab) => {
                tab.addEventListener('click', function () {
                    const listingType = tab.dataset.listingType || 'all';
                    const presetCategory = tab.dataset.presetCategory || 'all';

                    listingTypeTabs.forEach((item) => {
                        item.classList.remove('is-active');
                        item.setAttribute('aria-pressed', 'false');
                    });

                    tab.classList.add('is-active');
                    tab.setAttribute('aria-pressed', 'true');
                    listingTypeSelect.value = listingType;
                    applyListingTypeFilter(listingType, presetCategory);
                });
            });

            const applyInitialCategoryFilter = () => {
                applyListingTypeFilter(listingTypeSelect.value, categorySelect.value || 'all');
            };

            applyInitialCategoryFilter();

            // Initial visibility and wiring for sort controls
            toggleSortVisibility();
            listingTypeSelect?.addEventListener('change', toggleSortVisibility);
            categorySelect?.addEventListener('change', toggleSortVisibility);
            listingTypeTabs.forEach(tab => tab.addEventListener('click', toggleSortVisibility));

            const cityByCategory = {
                all: allCityOptions.map((x) => x.value),
                realestate: allCityOptions.map((x) => x.value),
                land: allCityOptions.map((x) => x.value),
                vehicle: allCityOptions.map((x) => x.value),
                yacht: allCityOptions.map((x) => x.value),
                caravan: allCityOptions.map((x) => x.value),
                home: allCityOptions.map((x) => x.value),
                services: allCityOptions.map((x) => x.value),
                tutoring: allCityOptions.map((x) => x.value),
                jobs: allCityOptions.map((x) => x.value),
                helper: allCityOptions.map((x) => x.value),
                secondhand: allCityOptions.map((x) => x.value),
                electronics: allCityOptions.map((x) => x.value),
                computer: allCityOptions.map((x) => x.value),
                phone: allCityOptions.map((x) => x.value),
                fashion: allCityOptions.map((x) => x.value),
                equipment: allCityOptions.map((x) => x.value),
                jewelry: allCityOptions.map((x) => x.value),
                watch: allCityOptions.map((x) => x.value)
            };

            const cityGroups = allCityOptions.reduce((acc, option) => {
                if (!option || !option.value || option.value === 'all') {
                    return acc;
                }

                const rawText = (option.text || '').split('/').map(x => x.trim()).filter(Boolean);
                const cityName = rawText[0] || option.value.split('::')[0];
                if (!acc[cityName]) {
                    acc[cityName] = [];
                }

                if (rawText.length >= 2) {
                    acc[cityName].push({
                        value: option.value,
                        text: rawText.slice(1).join(' / ')
                    });
                }

                return acc;
            }, {});

            function updateCityPickerLabel() {
                if (!cityPickerLabel || !citySelect) {
                    return;
                }

                const selected = citySelect.selectedOptions && citySelect.selectedOptions[0];
                cityPickerLabel.textContent = selected ? decodeLocalized(selected.textContent || '') : allCitiesText;
            }

            function renderVillageOptions(activeCity) {
                if (!cityPickerVillages || !cityPickerVillagesTitle) {
                    return;
                }

                cityPickerVillages.innerHTML = '';
                cityPickerVillagesTitle.textContent = activeCity
                    ? `${activeCity} - ${neighborhoodVillageText}`
                    : neighborhoodVillageText;

                const allForCity = allCityOptions.filter(x => x.value === activeCity);
                if (allForCity.length > 0) {
                    const cityOnlyBtn = document.createElement('button');
                    cityOnlyBtn.type = 'button';
                    cityOnlyBtn.className = `city-picker__village ${citySelect.value === activeCity ? 'is-active' : ''}`;
                    cityOnlyBtn.textContent = wholeCityText;
                    cityOnlyBtn.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        citySelect.value = activeCity;
                        renderVillageOptions(activeCity);
                        updateCityPickerLabel();
                    });
                    cityPickerVillages.appendChild(cityOnlyBtn);
                }

                const entries = cityGroups[activeCity] || [];
                entries.forEach((entry) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.className = `city-picker__village ${citySelect.value === entry.value ? 'is-active' : ''}`;
                    btn.textContent = entry.text;
                    btn.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        citySelect.value = entry.value;
                        renderVillageOptions(activeCity);
                        updateCityPickerLabel();
                    });
                    cityPickerVillages.appendChild(btn);
                });
            }

            function initCityPicker() {
                if (!cityPicker || !cityPickerCities || !cityPickerToggle || !cityPickerPanel || !citySelect) {
                    return;
                }

                const rootCities = allCityOptions
                    .filter(x => x.value !== 'all' && !x.value.includes('::'))
                    .map(x => x.value);

                cityPickerCities.innerHTML = '';

                const allBtn = document.createElement('button');
                allBtn.type = 'button';
                allBtn.className = `city-picker__city ${citySelect.value === 'all' ? 'is-active' : ''}`;
                allBtn.textContent = allCitiesText;
                allBtn.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    citySelect.value = 'all';
                    updateCityPickerLabel();
                    cityPickerCities.querySelectorAll('.city-picker__city').forEach(x => x.classList.remove('is-active'));
                    allBtn.classList.add('is-active');
                    renderVillageOptions('');
                });
                cityPickerCities.appendChild(allBtn);

                rootCities.forEach((city) => {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    const isSelected = citySelect.value === city || citySelect.value.startsWith(`${city}::`);
                    btn.className = `city-picker__city ${isSelected ? 'is-active' : ''}`;
                    btn.textContent = city;
                    btn.dataset.city = city;
                    btn.addEventListener('click', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        cityPickerCities.querySelectorAll('.city-picker__city').forEach(x => x.classList.remove('is-active'));
                        btn.classList.add('is-active');
                        if (citySelect.value === 'all' || !citySelect.value.startsWith(`${city}::`)) {
                            citySelect.value = city;
                        }
                        renderVillageOptions(city);
                        updateCityPickerLabel();
                    });
                    cityPickerCities.appendChild(btn);
                });

                cityPickerToggle.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    const willOpen = cityPickerPanel.hidden;
                    cityPickerPanel.hidden = !willOpen;
                    cityPickerToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
                });

                cityPickerApply?.addEventListener('click', function (event) {
                    event.preventDefault();
                    event.stopPropagation();
                    cityPickerPanel.hidden = true;
                    cityPickerToggle.setAttribute('aria-expanded', 'false');
                });

                document.addEventListener('click', function (event) {
                    if (!cityPicker.contains(event.target)) {
                        cityPickerPanel.hidden = true;
                        cityPickerToggle.setAttribute('aria-expanded', 'false');
                    }
                });

                const selectedCity = citySelect.value.includes('::') ? citySelect.value.split('::')[0] : citySelect.value;
                renderVillageOptions(selectedCity === 'all' ? '' : selectedCity);
                updateCityPickerLabel();
            }

            initCityPicker();

            const vehicleBrandOptions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleBrandOptions, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
            const vehicleModelOptionsByBrand = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VehicleModelOptionsByBrand, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));

            const categorySpecific = {
                realestate: [
                    {
                        key: 'propertyType',
                        options: ['@T("Daire", "Apartment", "Квартира", "شقة")', '@T("Müstakil Ev", "Detached House", "Отдельный дом", "منزل مستقل")', '@T("Villa", "Villa", "Вилла", "فيلا")', '@T("İkiz Villa", "Semi-Detached Villa", "Дуэт вилла", "فيلا متصلة")', '@T("Bina", "Building", "Здание", "مبنى")', '@T("Bahçeli", "With Garden", "С садом", "مع حديقة")']
                    },
                    {
                        key: 'roomCount',
                        dependsOn: 'propertyType',
                        optionsByParent: {
                            '@T("Daire", "Apartment", "Квартира", "شقة")': ['1+0', '1+1', '2+1', '3+1', '4+1', '5+1', '6+1', '7+1', '8+1', '9+1', '10+'],
                            '@T("Müstakil Ev", "Detached House", "Отдельный дом", "منزل مستقل")': ['2+1', '3+1', '4+1', '5+1', '6+1', '7+1', '8+1', '9+1', '10+'],
                            '@T("Villa", "Villa", "Вилла", "فيلا")': ['3+1', '4+1', '5+1', '6+1', '7+1', '8+1', '9+1', '10+'],
                            '@T("İkiz Villa", "Semi-Detached Villa", "Дуэт вилла", "فيلا متصلة")': ['3+1', '4+1', '5+1', '6+1'],
                            '@T("Bina", "Building", "Здание", "مبنى")': ['Stüdyo', 'Açık Plan', 'Bölmeli'],
                            '@T("Bahçeli", "With Garden", "С садом", "مع حديقة")': ['2+1', '3+1', '4+1', '5+1', '6+1', '7+1', '8+1', '9+1', '10+']
                        }
                    },
                    {
                        key: 'area',
                        dependsOn: 'roomCount',
                        optionsByParent: {
                            '1+0': ['35-55 m²', '55-75 m²'],
                            '1+1': ['55-75 m²', '75-95 m²'],
                            '2+1': ['85-110 m²', '110-135 m²'],
                            '3+1': ['120-160 m²', '160-220 m²'],
                            '4+1': ['180-260 m²', '260-340 m²'],
                            '5+1': ['250-350 m²', '350+ m²'],
                            '6+1': ['350+ m²'],
                            '7+1': ['350+ m²'],
                            '8+1': ['400+ m²'],
                            '9+1': ['450+ m²'],
                            '10+': ['500+ m²'],
                            'Stüdyo': ['30-50 m²', '50-70 m²'],
                            'Açık Plan': ['60-120 m²', '120-250 m²'],
