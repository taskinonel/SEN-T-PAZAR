                            '55-75 m²': ['@T("Klima", "Air Conditioning", "Кондиционер", "تكييف")', '@T("Merkezi", "Central", "Центральное", "مركزي")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")'],
                            '75-95 m²': ['@T("Klima", "Air Conditioning", "Кондиционер", "تكييف")', '@T("Merkezi", "Central", "Центральное", "مركزي")', '@T("Doğalgaz", "Gas Heating", "Газовое отопление", "غاز")', '@T("Kombi", "Combi Boiler", "Комби котел", "كومبي")', '@T("Soba", "Stove", "Печь", "مدفأة")'],
