            applyPrimarySelectChain();

            const counters = document.querySelectorAll('.js-countup[data-target]');
            if (counters.length > 0) {
                const animateCounter = (el) => {
                    const target = parseInt(el.dataset.target || '0', 10);
                    if (Number.isNaN(target) || target < 1) {
                        el.textContent = '0';
                        return;
                    }

                    const duration = 1200;
                    const start = performance.now();
                    const step = (now) => {
                        const progress = Math.min((now - start) / duration, 1);
                        const eased = 1 - Math.pow(1 - progress, 3);
                        el.textContent = Math.round(target * eased).toString();
                        if (progress < 1) {
                            requestAnimationFrame(step);
                        }
                    };

                    requestAnimationFrame(step);
                };

                const observer = new IntersectionObserver((entries, obs) => {
                    entries.forEach((entry) => {
                        if (!entry.isIntersecting) return;
                        animateCounter(entry.target);
                        obs.unobserve(entry.target);
                    });
                }, { threshold: 0.45 });

                counters.forEach((counter) => observer.observe(counter));
            }

            const notificationButton = document.getElementById('enableNotificationsBtn');
            if (notificationButton) {
                notificationButton.addEventListener('click', async () => {
                    if (!('Notification' in window)) {
                        alert('@T("Tarayıcı bildirimleri desteklemiyor.", "Browser does not support notifications.", "Браузер не поддерживает уведомления.", "المتصفح لا يدعم الإشعارات.")');
                        return;
                    }

                    const permission = await Notification.requestPermission();
                    if (permission === 'granted') {
                        localStorage.setItem('sent-notification-consent', 'granted');
                        const notificationTitle = '@T("Bildirimler açıldı", "Notifications enabled", "Уведомления включены", "تم تفعيل الإشعارات")';
                        const notificationBody = '@T("Yeni ilân, fiyat düşüşü ve favori eşleşmelerinden haberdar olacaksınız.", "You will be notified about new listings, price drops and favorites.", "Вы будете получать уведомления о новых объявлениях и снижении цен.", "ستتلقى إشعارات عن الإعلانات الجديدة وانخفاض الأسعار والمفضلة.")';

                        if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                            navigator.serviceWorker.controller.postMessage({
                                type: 'SHOW_NOTIFICATION',
                                title: notificationTitle,
                                body: notificationBody
                            });
                        } else {
                            new Notification(notificationTitle, { body: notificationBody });
                        }
                        notificationButton.textContent = '@T("Bildirimler Etkin", "Notifications Active", "Уведомления активны", "الإشعارات مفعّلة")';
                    } else {
                        localStorage.setItem('sent-notification-consent', permission);
                    }
                });
            }

            const loadMoreGrids = document.querySelectorAll('.market-board__grid[data-load-more-grid="true"]');
            loadMoreGrids.forEach((loadMoreGrid) => {
                const cards = Array.from(loadMoreGrid.querySelectorAll('.listing-card'));
                const perPage = Math.max(1, parseInt(loadMoreGrid.dataset.pageSize || '12', 10));
                const counterId = loadMoreGrid.dataset.counterId;
                const buttonId = loadMoreGrid.dataset.buttonId;
                const counterElement = counterId ? document.getElementById(counterId) : null;
                const loadMoreButton = buttonId ? document.getElementById(buttonId) : null;
                let visibleCount = Math.min(perPage, cards.length);

                const renderVisibleCards = () => {
                    cards.forEach((card, index) => {
                        card.style.display = index < visibleCount ? '' : 'none';
                    });

                    if (counterElement) {
                        const shownStart = cards.length === 0 ? 0 : 1;
                        const shownEnd = Math.min(visibleCount, cards.length);
                        counterElement.textContent = `${shownStart} - ${shownEnd} / ${cards.length} ilan görüntüleniyor`;
                    }

                    if (loadMoreButton) {
                        loadMoreButton.hidden = visibleCount >= cards.length;
                    }
                };

                renderVisibleCards();

                if (loadMoreButton) {
                    loadMoreButton.addEventListener('click', () => {
                        visibleCount = Math.min(cards.length, visibleCount + perPage);
                        renderVisibleCards();
                    });
                }
            });

            if (mobileSearchDock) {
                mobileSearchDock.addEventListener('click', function (event) {
                    const target = event.target.closest('[data-dock-action]');
                    if (!target) {
                        return;
                    }

                    const action = target.getAttribute('data-dock-action');
                    if (action === 'filter') {
                        if (advancedButton) {
                            advancedButton.click();
                            return;
                        }

                        if (cityPickerToggle) {
                            cityPickerToggle.click();
                        }
                        return;
                    }

                    if (action === 'sort') {
                        const sortTarget = listingSortSelect || sortBySelect;
                        if (sortTarget) {
                            sortTarget.focus();
                            sortTarget.click();
                        }
                        return;
                    }

                    if (action === 'top') {
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }
                });
            }

            const initSpotlightCarousels = () => {
                const spotlightRails = document.querySelectorAll('[data-spotlight-rail]');

                spotlightRails.forEach((rail) => {
                    const viewport = rail.querySelector('.homepage-spotlight-rail__viewport');
                    if (!viewport) {
                        return;
                    }

                    const pages = Array.from(viewport.querySelectorAll('[data-spotlight-page]'));
                    if (pages.length === 0) {
                        return;
                    }

                    const pageIndicator = rail.querySelector('[data-spotlight-page-indicator]');
                    const intervalMs = Math.max(2500, parseInt(viewport.dataset.spotlightInterval || '4000', 10));
                    let currentPageIndex = 0;

                    const showPage = (targetIndex) => {
                        pages.forEach((page, idx) => {
                            const isActive = idx === targetIndex;
                            page.classList.toggle('is-active', isActive);
                            page.setAttribute('aria-hidden', isActive ? 'false' : 'true');
                        });

                        if (pageIndicator) {
                            pageIndicator.textContent = `${targetIndex + 1} / ${pages.length}`;
                        }

                        currentPageIndex = targetIndex;
                    };

                    showPage(0);

                    if (pages.length === 1) {
                        return;
                    }

                    let timer = window.setInterval(() => {
                        showPage((currentPageIndex + 1) % pages.length);
                    }, intervalMs);

                    rail.addEventListener('mouseenter', () => {
                        window.clearInterval(timer);
                    });

                    rail.addEventListener('mouseleave', () => {
                        window.clearInterval(timer);
                        timer = window.setInterval(() => {
                            showPage((currentPageIndex + 1) % pages.length);
                        }, intervalMs);
                    });
                });
            };

            initSpotlightCarousels();
        });
    </script>
}
