<section class="hero hero--light-text">
    <div class="hero__overlay"></div>
    <div class="hero__background-stack" aria-hidden="true">
        <div class="hero__background is-active" id="heroBackgroundPrimary" style="background-image:url('@heroImages[0]');"></div>
        <div class="hero__background" id="heroBackgroundSecondary" style="background-image:url('@heroImages[0]');"></div>
    </div>
    <script>
        const heroImages = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(heroImages));
        window.addEventListener('DOMContentLoaded', function () {
            const layers = [
                document.getElementById('heroBackgroundPrimary'),
                document.getElementById('heroBackgroundSecondary')
            ].filter(Boolean);
            if (layers.length !== 2 || heroImages.length === 0) {
                return;
            }

            const cycleDurationMs = 3000;
            let activeImageIndex = 0;
            let activeLayerIndex = 0;

            const setLayerImage = (layer, src) => {
                layer.style.backgroundImage = `url("${src}")`;
            };

            const preloadImage = (src) => new Promise((resolve) => {
                if (!src) {
                    resolve(false);
                    return;
                }

                const image = new Image();
                image.onload = () => resolve(true);
                image.onerror = () => resolve(false);
                image.src = src;
            });

            heroImages.slice(1).forEach((src) => {
                const image = new Image();
                image.src = src;
            });

            const showNextImage = async () => {
                const nextImageIndex = (activeImageIndex + 1) % heroImages.length;
                const nextImage = heroImages[nextImageIndex];
                const nextLayerIndex = (activeLayerIndex + 1) % layers.length;
                const incomingLayer = layers[nextLayerIndex];
                const outgoingLayer = layers[activeLayerIndex];
                const didLoad = await preloadImage(nextImage);

                if (didLoad) {
                    setLayerImage(incomingLayer, nextImage);
                    incomingLayer.classList.add('is-active');
                    outgoingLayer.classList.remove('is-active');
                    activeLayerIndex = nextLayerIndex;
                    activeImageIndex = nextImageIndex;
                }

                window.setTimeout(showNextImage, cycleDurationMs);
            };

            layers.forEach((layer) => setLayerImage(layer, heroImages[0]));
            layers[0].classList.add('is-active');
            layers[1].classList.remove('is-active');

            if (heroImages.length > 1) {
                window.setTimeout(showNextImage, cycleDurationMs);
            }
        });
    </script>
