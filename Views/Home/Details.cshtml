@model SEN_T_PAZAR.Models.PropertyCard
@inject SEN_T_PAZAR.Services.SiteLocalizer L
@using System.Globalization
@using System.Linq

@{
    if (ViewData["Title"] is null)
    {
        ViewData["Title"] = L["detailsTitle"];
    }

    var gallery = new List<string>();
    if (Model.GalleryImages != null && Model.GalleryImages.Count > 0)
    {
        gallery = Model.GalleryImages;
    }
    else
    {
        gallery = new List<string> { Model.ImageUrl };
    }
    string T(string tr, string en, string ru, string ar, string? fa = null) => L.CultureCode switch
    {
        "en" => en,
        "ru" => ru,
        "ar" => ar,
        "fa" => fa ?? en ?? tr,
        _ => tr
    };
    string NormalizeText(string? value)
    {
        return (value ?? string.Empty).Trim().ToLowerInvariant()
            .Replace('ı', 'i')
            .Replace('ğ', 'g')
            .Replace('ü', 'u')
            .Replace('ş', 's')
            .Replace('ö', 'o')
            .Replace('ç', 'c');
    }
    string LocalizeCityName(string? cityName) => cityName switch
    {
        "Lefkoşa" => T("Lefkoşa", "Nicosia", "Никосия", "نيقوسيا", "لفکوشا"),
        "Girne" => T("Girne", "Kyrenia", "Кирения", "كيرينيا", "گیرنه"),
        "Gazimağusa" => T("Gazimağusa", "Famagusta", "Фамагуста", "فاماغوستا", "قازی‌ماغوسا"),
        "Güzelyurt" => T("Güzelyurt", "Morphou", "Морфу", "مورفو", "گوزل‌یورت"),
        "İskele" => T("İskele", "Trikomo", "Трикомо", "تريكومو", "ایسکله"),
        "Lefke" => T("Lefke", "Lefka", "Лефке", "لفكة", "لفکه"),
        "Karpaz" => T("Karpaz", "Karpasia", "Карпасия", "كارباسيا", "کارپاز"),
        "Belirtilmemiş" => T("Belirtilmemiş", "Unspecified", "Не указано", "غير محدد", "مشخص نشده"),
        _ => cityName ?? T("Belirtilmemiş", "Unspecified", "Не указано", "غير محدد", "مشخص نشده")
    };
    string SellerRoleText(string? role) => NormalizeText(role) switch
    {
        "owner" or "sahibinden" or "bireysel" => T("Sahibinden", "From Owner", "От собственника", "من المالك", "از مالک"),
        "agent" or "emlakcidan" => T("Emlakçıdan", "From Agency", "От агентства", "من الوكالة", "از بنگاه"),
        "developer" or "insaat-firmasindan" or "insaat firmasindan" => T("İnşaat firmasından", "From Developer", "От застройщика", "من شركة التطوير", "از شرکت سازنده"),
        _ => string.IsNullOrWhiteSpace(role)
            ? T("Sahibinden", "From Owner", "От собственника", "من المالك", "از مالک")
            : role!
    };
    string FormatListingLocation(string? cityName, string? location)
    {
        var localizedCity = LocalizeCityName(cityName);
        if (string.IsNullOrWhiteSpace(location) || string.Equals(location, cityName, StringComparison.OrdinalIgnoreCase))
        {
            return localizedCity;
        }
        return $"{localizedCity} - {location}";
    }
    var whatsappNumber = new string((Model.SellerPhone ?? string.Empty).Where(char.IsDigit).ToArray());
    if (whatsappNumber.StartsWith("0"))
    {
        whatsappNumber = "90" + whatsappNumber[1..];
    }
    else if (whatsappNumber.Length == 10)
    {
        whatsappNumber = "90" + whatsappNumber;
    }
    var whatsappMessage = Uri.EscapeDataString(T(
        $"Merhaba, {Model.Title} ilanı için sizinle iletişime geçmek istiyorum. İlan No: {Model.ListingCode}",
        $"Hello, I would like to contact you about the listing {Model.Title}. Listing No: {Model.ListingCode}",
        $"Здравствуйте, я хотел(а) бы связаться с вами по объявлению {Model.Title}. Номер объявления: {Model.ListingCode}",
        $"مرحبًا، أود التواصل معكم بخصوص الإعلان {Model.Title}. رقم الإعلان: {Model.ListingCode}",
        $"سلام، مایل هستم درباره آگهی {Model.Title} با شما تماس بگیرم. شماره آگهی: {Model.ListingCode}"));
    var detailLocationText = string.IsNullOrWhiteSpace(Model.Neighborhood)
        ? (string.IsNullOrWhiteSpace(Model.Location) ? Model.City : Model.Location)
        : (string.IsNullOrWhiteSpace(Model.Location) ? $"{Model.Neighborhood}, {Model.City}" : $"{Model.Neighborhood}, {Model.Location}");
    var detailHighlights = Model.Highlights
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Take(6)
        .ToList();
    var hasMapCoordinates = Model.Latitude.HasValue && Model.Longitude.HasValue;
    var mapQuery = string.IsNullOrWhiteSpace(detailLocationText)
        ? Model.Title
        : $"{Model.Title}, {detailLocationText}";
    var mapLink = $"https://www.google.com/maps/search/?api=1&query={System.Uri.EscapeDataString(mapQuery)}";
    string? mapEmbedUrl = null;

    if (hasMapCoordinates)
    {
        string Invariant(double value) => value.ToString(CultureInfo.InvariantCulture);
        var latitude = Model.Latitude!.Value;
        var longitude = Model.Longitude!.Value;
        var delta = 0.008d;
        mapEmbedUrl = $"https://www.openstreetmap.org/export/embed.html?bbox={Invariant(longitude - delta)},{Invariant(latitude - delta)},{Invariant(longitude + delta)},{Invariant(latitude + delta)}&layer=mapnik&marker={Invariant(latitude)},{Invariant(longitude)}";
        mapLink = $"https://www.openstreetmap.org/?mlat={Invariant(latitude)}&mlon={Invariant(longitude)}#map=15/{Invariant(latitude)}/{Invariant(longitude)}";
    }
}

<section class="section detail-page">
    <div class="container detail-shell">
        @if (TempData["ContactSuccess"] is string contactStatus && !string.IsNullOrWhiteSpace(contactStatus))
        {
            <div class="alert alert-info">@contactStatus</div>
        }

        <div class="detail-hero">
            <div class="detail-gallery">
                <div class="detail-main-image">
                    <button type="button" class="detail-gallery__zoom" id="detailZoomButton" title="@T("Tam ekran görüntüle", "View fullscreen", "На весь экран", "عرض بالشاشة الكاملة", "نمایش تمام صفحه")" aria-label="@T("Resmi büyüt", "Zoom image", "Увеличить фото", "تكبير الصورة", "بزرگنمایی تصویر")">
                        <i class="bi bi-arrows-fullscreen"></i>
                        <span>@T("Büyüt", "Zoom", "Увеличить", "تكبير", "بزرگنمایی")</span>
                    </button>
                    <img id="detailMainImage" src="@gallery[0]" alt="@Model.Title" loading="eager" referrerpolicy="no-referrer" />
                </div>

                @if (gallery.Count > 1 || Model.Has360Tour || !string.IsNullOrEmpty(Model.VideoUrl))
                {
                    <div class="detail-thumbs">
                        @for (var i = 0; i < gallery.Count; i++)
                        {
                            <button type="button"
                                    class="detail-thumb @(i == 0 ? "is-active" : string.Empty)"
                                    data-image="@gallery[i]"
                                    aria-label="@T($"Fotoğraf {i + 1}", $"Photo {i + 1}", $"Фото {i + 1}", $"صورة {i + 1}", $"عکس {i + 1}")">
                                <img src="@gallery[i]" alt="@T($"{Model.Title} fotoğraf {i + 1}", $"{Model.Title} photo {i + 1}", $"{Model.Title} фото {i + 1}", $"{Model.Title} صورة {i + 1}", $"{Model.Title} عکس {i + 1}")" loading="lazy" referrerpolicy="no-referrer" />
                            </button>
                        }
                    </div>
                }
            </div>

            <aside class="detail-summary-card">
                <div class="detail-summary-card__header">
                    <h1>@Model.Title</h1>
                    <button type="button"
                            class="btn-favorite heart-btn"
                            data-listing-id="@Model.Id"
                            title="@T("Favorilerime ekle", "Add to Favorites", "Добавить в избранное", "أضف إلى المفضلة", "افزودن به علاقه‌مندی‌ها")"
                            aria-label="@T("Favori butonu", "Favorite button", "Кнопка избранного", "زر المفضلة", "دکمه علاقه‌مند")">
                        <svg class="heart-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                        <span class="favorite-count" id="listing-favorite-count">@(ViewData["FavoritesCount"] ?? 0)</span>
                    </button>
                </div>
                @if (Model.IsImported && !string.IsNullOrWhiteSpace(Model.SourceName))
                {
                    <div class="alert alert-light border mt-2 mb-2 py-2 px-3 small">
                        <strong>@T("Kaynak", "Source", "Источник", "المصدر", "منبع"):</strong> @Model.SourceName<br />
                        @T("Bu kayıt dış siteye yönlendirme yapmaz; ilan ayrıntıları bu sayfada yerel olarak görüntülenir.", "This record does not redirect to an external site; listing details are shown locally on this page.", "Эта запись не перенаправляет на внешний сайт; детали объявления показываются локально на этой странице.", "هذا السجل لا يعيد التوجيه إلى موقع خارجي؛ يتم عرض تفاصيل الإعلان محليًا في هذه الصفحة.", "این پست به یک سایت خارجی منتقل نمی‌شود؛ جزئیات آگهی به صورت محلی در این صفحه نمایش داده می‌شود.")
                    </div>
                }
                <p class="detail-location">@detailLocationText</p>
                <p class="detail-summary">@Model.Summary</p>

                @if (detailHighlights.Any())
                {
                    <div class="detail-highlights detail-highlights--compact">
                        @foreach (var item in detailHighlights)
                        {
                            <span class="detail-highlight-chip">@item</span>
                        }
                    </div>
                }

                <div class="detail-price-box">
                    <small>@L["price"]</small>
                    <strong>@Model.PriceLabel</strong>
                    @if (!string.IsNullOrWhiteSpace(Model.AvailabilityNote))
                    {
                        <span>@Model.AvailabilityNote</span>
                    }
                </div>

                <div class="detail-quick-meta">
                    <div>
                        <small>@T("İlan no", "Listing no", "Номер объявления", "رقم الإعلان", "شماره آگهی")</small>
                        <strong>@Model.ListingCode</strong>
                    </div>
                    <div>
                        <small>@T("Yayın Tarihi", "Published", "Дата публикации", "تاريخ النشر", "تاریخ انتشار")</small>
                        <strong>@Model.PostedAtLabel</strong>
                    </div>
                    <div>
                        <small>@T("Kimden", "Who listed", "Кто разместил", "الجهة المعلنة", "منتشرکننده")</small>
                        <strong>@Model.SellerRole</strong>
                    </div>
                    <div>
                        <small>@T("Satıcının şehri", "Seller city", "Город продавца", "مدينة البائع", "شهر فروشنده")</small>
                        <strong>@Model.SellerCity</strong>
                    </div>
                </div>

                <div class="detail-promo-cta">
                    <h3>@T("İlanını vitrine taşı, daha hızlı sat", "Move your listing to showcase and sell faster", "Перенесите объявление в витрину и продайте быстрее", "انقل إعلانك إلى الواجهة وبِع بشكل أسرع", "آگهی را به ویترین ببرید و سریع‌تر بفروشید")</h3>
                    <p>@T("Öne çıkan paketler ile daha fazla görüntülenme, daha çok güven ve daha fazla dönüşüm alırsınız.", "Featured packages bring more views, stronger trust, and better conversion.", "Пакеты продвижения дают больше просмотров, больше доверия и выше конверсию.", "باقات الترويج تمنحك مشاهدات أكثر وثقة أعلى وتحويلًا أفضل.", "بسته‌های ویژه بازدید بیشتر، اعتماد قوی‌تر و تبدیل بالاتر می‌آورند.")</p>
                    <div class="detail-promo-cta__actions">
                        <a asp-controller="Pricing" asp-action="Index" asp-route-type="combo" class="btn btn-primary">@T("Vitrin + Öne Çıkan", "Showcase + Featured", "Витрина + Продвижение", "الواجهة + المميز", "ویترین + ویژه")</a>
                        <a asp-controller="Pricing" asp-action="Index" asp-route-type="vitrin" class="btn btn-outline-primary">@T("Paketleri İncele", "View Packages", "Смотреть пакеты", "عرض الباقات", "مشاهده بسته‌ها")</a>
                    </div>
                </div>
            </aside>
        </div>

        <div class="detail-body-grid">
            <div class="detail-body-main">
                <section class="detail-section">
                    <div class="detail-section__head">
                        <h2>@T("İlan Açıklaması", "Listing Description", "Описание объявления", "وصف الإعلان", "توضیحات آگهی")</h2>
                        <p>@T("Detayları mümkün olduğunca açık ve karşılaştırılabilir şekilde sunuyoruz.", "We present the details as clearly and comparably as possible.", "Мы показываем детали максимально ясно и удобно для сравнения.", "نعرض التفاصيل بأوضح شكل ممكن وبطریقة سهلة للمقارنة.", "ما جزئیات را تا حد امکان واضح و قابل مقایسه ارائه می‌دهیم.")</p>
                    </div>
                    <p class="detail-body-text">@Model.DetailBody</p>
                </section>

                <section class="detail-section">
                    <div class="detail-section__head">
                        <h2>@T("Temel Bilgiler", "Key Information", "Основная информация", "المعلومات الأساسية", "اطلاعات اساسی")</h2>
                        <p>@T("Kategoriye göre en sık sorulan nitelikler burada yer alır.", "The most frequently requested details for this category appear here.", "Здесь собраны самые важные параметры этой категории.", "أهم التفاصيل المطلوبة لهذه الفئة تظهر هنا.", "مهم‌ترین جزئیات مورد درخواست برای این دسته در اینجا نمایش داده می‌شود.")</p>
                    </div>
                    <div class="detail-facts-grid">
                        @foreach (var fact in Model.Facts)
                        {
                            <article class="detail-fact-card">
                                <small>@fact.Label</small>
                                <strong>@fact.Value</strong>
                            </article>
                        }
                    </div>
                </section>

                @if (hasMapCoordinates || !string.IsNullOrWhiteSpace(detailLocationText))
                {
                    <section class="detail-section detail-section--map">
                        <div class="detail-section__head">
                            <div class="detail-section__head">
                            </div>
                        </div>
                    </section>
                }

                @if (Model.IsResidentialEstate)
                {
                    <section class="detail-section">
                        <div class="detail-section__head">
                            <h2>@T("İlan Özellikleri", "Listing Features", "Характеристики объявления", "خصائص الإعلان", "ویژگی‌های آگهی")</h2>
                            <p>@T("Dış, iç ve konum özellikleri bu ilanda belirtilen bilgilere göre listelenir.", "Exterior, interior and location features are listed from the details provided in this listing.", "Внешние, внутренние и локационные характеристики отображаются по данным объявления.", "يتم عرض الخصائص الخارجية والداخلية وخصائص الموقع بحسب البيانات المدخلة في الإعلان.", "ویژگی‌های بیرونی، داخلی و موقعیت بر اساس اطلاعات همین آگهی نمایش داده می‌شود.")</p>
                        </div>
                        <div class="detail-feature-columns">
                            <article class="detail-feature-column">
                                <h3>@T("Dış Özellikler", "Exterior Features", "Внешние особенности", "الميزات الخارجية", "ویژگی‌های بیرونی")</h3>
                                @if (Model.ExteriorFeatures.Any())
                                {
                                    <ul class="detail-feature-list">
                                        @foreach (var item in Model.ExteriorFeatures)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="detail-feature-empty">@T("Belirtilmedi", "Not specified", "Не указано", "غير محدد", "ثبت نشده")</p>
                                }
                            </article>
                            <article class="detail-feature-column">
                                <h3>@T("İç Özellikler", "Interior Features", "Внутренние особенности", "الميزات الداخلية", "ویژگی‌های داخلی")</h3>
                                @if (Model.InteriorFeatures.Any())
                                {
                                    <ul class="detail-feature-list">
                                        @foreach (var item in Model.InteriorFeatures)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="detail-feature-empty">@T("Belirtilmedi", "Not specified", "Не указано", "غير محدد", "ثبت نشده")</p>
                                }
                            </article>
                            <article class="detail-feature-column">
                                <h3>@T("Konum Özellikleri", "Location Features", "Особенности расположения", "ميزات الموقع", "ویژگی‌های موقعیت")</h3>
                                @if (Model.LocationFeatures.Any())
                                {
                                    <ul class="detail-feature-list">
                                        @foreach (var item in Model.LocationFeatures)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    <p class="detail-feature-empty">@T("Belirtilmedi", "Not specified", "Не указано", "غير محدد", "ثبت نشده")</p>
                                }
                            </article>
                        </div>
                    </section>
                }

                @if (Model.PopularListings.Any())
                {
                    <section class="detail-section">
                        <div class="detail-section__head">
                            <h2>@T("Popüler İlanlar", "Popular Listings", "Популярные объявления", "الإعلانات الشائعة", "آگهی‌های محبوب")</h2>
                            <p>@T("Kontrol panelinden popüler olarak işaretlenen ilanlar.", "Listings marked as popular from the admin panel.", "Объявления, отмеченные как популярные в панели администратора.", "الإعلانات المعلّمة كشائعة من لوحة التحكم.", "آگهی‌هایی که از پنل مدیریت به‌عنوان محبوب انتخاب شده‌اند.")</p>
                        </div>
                        <div class="detail-mini-list detail-mini-list--cards">
                            @foreach (var item in Model.PopularListings)
                            {
                                <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="detail-mini-item detail-mini-item--listing-card">
                                    <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/img/placeholder.svg';" />
                                    <strong>@item.Title</strong>
                                    <span>@FormatListingLocation(item.City, item.Location)</span>
                                    <em>@item.PriceLabel</em>
                                </a>
                            }
                        </div>
                    </section>
                }

                @if (Model.CorporateProfiles.Any())
                {
                    <section class="detail-section detail-section--banner">
                        <div class="detail-corporate-banner">
                            <div class="detail-corporate-banner__content">
                                <span class="detail-corporate-banner__eyebrow">@T("Kurumsal Ağ", "Corporate Network", "Корпоративная сеть", "الشبكة المؤسسية", "شبکه سازمانی")</span>
                            </div>
                            <div class="detail-corporate-banner__chips">
                                @foreach (var corp in Model.CorporateProfiles.Take(3))
                                {
                                    <article class="detail-corporate-chip">
                                        <div class="detail-corporate-chip__brand">
                                            @if (!string.IsNullOrWhiteSpace(corp.LogoUrl))
                                            {
                                                <img src="@corp.LogoUrl" alt="@corp.DisplayName" class="detail-corporate-chip__logo" loading="lazy" referrerpolicy="no-referrer" />
                                            }
                                            else
                                            {
                                                <span class="detail-corporate-chip__avatar">@corp.DisplayName[..1]</span>
                                            }
                                        </div>
                                        <div>
                                            <strong>@corp.DisplayName</strong>
                                            <span>@LocalizeCityName(corp.City)</span>
                                        </div>
                                        <em>@T("Aktif ilan", "Active listings", "Активные объявления", "الإعلانات النشطة", "آگهی فعال"): @corp.ActiveListingCount</em>
                                        <div class="detail-corporate-chip__actions">
                                            <a asp-controller="Home" asp-action="Store" asp-route-id="@corp.UserId">@T("Mağazayı Gör", "View Store", "Открыть магазин", "عرض المتجر", "مشاهده فروشگاه")</a>
                                            @if (!string.IsNullOrWhiteSpace(corp.WebsiteUrl))
                                            {
                                                <a href="@corp.WebsiteUrl" target="_blank" rel="noopener noreferrer">@T("Web Sitesi", "Website", "Сайт", "الموقع", "وب‌سایت")</a>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(corp.ContactPhone))
                                            {
                                                <a href="tel:@corp.ContactPhone">@corp.ContactPhone</a>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </div>
                    </section>
                }

                @if (Model.Reviews.Any())
                {
                    <section class="detail-section">
                        <div class="detail-section__head">
                            <h2>@T("Değerlendirmeler", "Reviews", "Отзывы", "التعليقات", "بررسی‌ها")</h2>
                            <p>@T("Bu ilan için kullanıcı değerlendirmeleri.", "User reviews for this listing.", "Отзывы пользователей по этому объявлению.", "تعليقات المستخدمين حول هذا الإعلان.", "بررسی‌های کاربرانه برای این آگهی.")</p>
                        </div>
                        <div class="detail-reviews-list">
                            @foreach (var review in Model.Reviews.Where(r => r.ModerationStatus == SEN_T_PAZAR.Models.ReviewModerationStatus.Approved).OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="detail-review-card">
                                    <div class="detail-review-header">
                                        <div class="detail-review-user">
                                            <span class="detail-review-user-avatar">@review.UserName[..1]</span>
                                            <div>
                                                <strong>@review.UserName</strong>
                                                <span class="detail-review-date">@review.CreatedAt.ToString("d MMMM yyyy")</span>
                                            </div>
                                        </div>
                                        <div class="detail-review-rating">
                                            @for (int i = 0; i < 5; i++)
                                            {
                                                <i class="bi @(i < review.Rating ? "bi-star-fill" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="detail-review-text">@review.Comment</p>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>

            <aside class="detail-side-panel">
