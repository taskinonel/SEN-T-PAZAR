                </section>
                }

                @if (Model.FeaturedSideListings.Any())
                {
                <section class="detail-section detail-section--compact">
                    <div class="detail-section__head">
                    </div>
                    <div class="detail-mini-list detail-mini-list--cards">
                        @foreach (var item in Model.FeaturedSideListings)
                        {
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="detail-mini-item detail-mini-item--listing-card">
                                <img src="@item.ImageUrl" alt="@item.Title" loading="lazy" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/img/placeholder.svg';" />
                                <strong>@item.Title</strong>
                                <span>@FormatListingLocation(item.City, item.Location)</span>
                                <em>@item.PriceLabel</em>
                            </a>
                        }
                    </div>
                </section>
                }
            </aside>
        </div>
    </div>
</section>

<div class="detail-lightbox" id="detailLightbox" hidden>
    <button type="button" class="detail-lightbox__close" id="detailLightboxClose" aria-label="@T("Kapat", "Close", "Закрыть", "إغلاق", "بستن")">&times;</button>
    <button type="button" class="detail-lightbox__nav detail-lightbox__nav--prev" id="detailLightboxPrev" aria-label="@T("Önceki", "Previous", "Предыдущее", "السابق", "قبلی")">&#10094;</button>
    <img id="detailLightboxImage" src="@gallery[0]" alt="@Model.Title" />
    <button type="button" class="detail-lightbox__nav detail-lightbox__nav--next" id="detailLightboxNext" aria-label="@T("Sonraki", "Next", "Следующее", "التالي", "بعدی")">&#10095;</button>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const mainImage = document.getElementById('detailMainImage');
            const thumbs = Array.from(document.querySelectorAll('.detail-thumb'));
            const zoomButton = document.getElementById('detailZoomButton');
            const lightbox = document.getElementById('detailLightbox');
            const lightboxImage = document.getElementById('detailLightboxImage');
            const lightboxClose = document.getElementById('detailLightboxClose');
            const lightboxPrev = document.getElementById('detailLightboxPrev');
            const lightboxNext = document.getElementById('detailLightboxNext');
            const images = thumbs.length > 0 ? thumbs.map(function (thumb) { return thumb.dataset.image; }) : [mainImage?.src];
            let currentIndex = 0;

            function setActiveImage(index) {
                if (!mainImage || !images[index]) return;
                currentIndex = index;
                mainImage.src = images[index];
                if (lightboxImage) {
                    lightboxImage.src = images[index];
                }
                thumbs.forEach(function (item, itemIndex) {
                    item.classList.toggle('is-active', itemIndex === index);
                });
            }

            function stepImage(step) {
                if (images.length <= 1) return;
                const nextIndex = (currentIndex + step + images.length) % images.length;
                setActiveImage(nextIndex);
            }

            function openLightbox() {
                if (!lightbox || !lightboxImage || !images[currentIndex]) return;
                lightbox.hidden = false;
                lightboxImage.src = images[currentIndex];
                document.body.style.overflow = 'hidden';
            }

            function closeLightbox() {
                if (!lightbox) return;
                lightbox.hidden = true;
                document.body.style.overflow = '';
            }

            thumbs.forEach(function (thumb) {
                thumb.addEventListener('click', function () {
                    const targetIndex = thumbs.indexOf(thumb);
                    if (targetIndex >= 0) {
                        setActiveImage(targetIndex);
                    }
                });
            });

            if (mainImage) {
                mainImage.addEventListener('click', function () {
                    if (images.length > 1) {
                        stepImage(1);
                    }
                });
            }

            if (zoomButton) {
                zoomButton.addEventListener('click', openLightbox);
            }

            if (lightboxClose) {
                lightboxClose.addEventListener('click', closeLightbox);
            }

            if (lightboxPrev) {
                lightboxPrev.addEventListener('click', function () { stepImage(-1); });
            }

            if (lightboxNext) {
                lightboxNext.addEventListener('click', function () { stepImage(1); });
            }

            if (lightbox) {
                lightbox.addEventListener('click', function (event) {
                    if (event.target === lightbox) {
                        closeLightbox();
                    }
                });
            }

            document.addEventListener('keydown', function (event) {
                if (lightbox && !lightbox.hidden) {
                    if (event.key === 'Escape') closeLightbox();
                    if (event.key === 'ArrowLeft') stepImage(-1);
                    if (event.key === 'ArrowRight') stepImage(1);
                }
            });
        });
    </script>
}
