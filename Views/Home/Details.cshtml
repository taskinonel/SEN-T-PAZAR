                        <div class="detail-seller-card__avatar">@Model.SellerName[..1]</div>
                        <div>
                            <strong>
                                @Model.SellerName
                                @if (Model.IsVerifiedSeller)
                                {
                                    <span class="badge badge-verified ms-1" title="@T("Doğrulanmış Satıcı", "Verified Seller", "Проверенный продавец", "بائع موثق", "فروشنده تأیید شده")">
                                        <i class="bi bi-patch-check-fill"></i>
                                    </span>
                                }
                            </strong>
                            <span>@SellerRoleText(Model.SellerRole)</span>
                            <span>@LocalizeCityName(Model.SellerCity)</span>
                            <a href="tel:@Model.SellerPhone">@Model.SellerPhone</a>
                        </div>
                    </div>
                    <div class="detail-contact-actions mt-3">
                        <a href="tel:@Model.SellerPhone" class="btn btn-outline-primary">
                            <i class="bi bi-telephone-fill me-2"></i>@T("Satıcıyı Ara", "Call Seller", "Позвонить продавцу", "اتصل بالبائع", "تماس با فروشنده")
                        </a>
                        @if (Model.AllowWhatsApp && !string.IsNullOrWhiteSpace(whatsappNumber))
                        {
                            <a href="https://wa.me/@(whatsappNumber)?text=@whatsappMessage" target="_blank" rel="noopener noreferrer" class="btn btn-success">
                                <i class="bi bi-whatsapp me-2"></i>WhatsApp
                            </a>
                        }
                        @if (Model.AllowMessages)
                        {
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#listingMessageForm" aria-expanded="false" aria-controls="listingMessageForm">
                                <i class="bi bi-chat-dots-fill me-2"></i>@T("Mesaj Gönder", "Send Message", "Отправить сообщение", "إرسال رسالة", "ارسال پیام")
                            </button>
                        }
                        @if (hasMapCoordinates || !string.IsNullOrWhiteSpace(detailLocationText))
                        {
                            <a href="@mapLink" target="_blank" rel="noopener noreferrer" class="btn btn-outline-secondary ms-2">
                                <i class="bi bi-geo-alt-fill me-2"></i>@T("Haritada Göster", "Show on map", "Показать на карте", "عرض على الخريطة", "نمایش در نقشه")
                            </a>
                        }
                    </div>
                    @if (Model.AllowMessages)
                    {
                        <div class="collapse mt-3" id="listingMessageForm">
                            <form asp-action="SendListingMessage" asp-controller="Home" method="post" class="card card-body border-0 bg-light">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="listingId" value="@Model.Id" />

                                <div class="mb-2">
                                    <label class="form-label">@T("Ad Soyad", "Full Name", "Имя и фамилия", "الاسم الكامل", "نام و نام خانوادگی")</label>
                                    <input name="senderName" class="form-control" maxlength="120" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">@T("E-posta", "Email", "Эл. почта", "البريد الإلكتروني", "ایمیل")</label>
                                    <input name="senderEmail" type="email" class="form-control" maxlength="180" required />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">@T("Telefon (opsiyonel)", "Phone (optional)", "Телефон (необязательно)", "الهاتف (اختياري)", "تلفن (اختیاری)")</label>
                                    <input name="senderPhone" class="form-control" maxlength="40" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">@T("Konu", "Subject", "Тема", "الموضوع", "موضوع")</label>
                                    <input name="subject" class="form-control" maxlength="180" value="@T($"{Model.ListingCode} için iletişim talebi", $"Contact request for {Model.ListingCode}", $"Запрос по объявлению {Model.ListingCode}", $"طلب تواصل بخصوص الإعلان {Model.ListingCode}", $"درخواست تماس برای آگهی {Model.ListingCode}")" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">@T("Mesaj", "Message", "Сообщение", "الرسالة", "پیام")</label>
                                    <textarea name="message" class="form-control" rows="4" maxlength="4000" required>@T($"{Model.Title} ilanı hakkında bilgi almak istiyorum.", $"I would like to get more information about the listing {Model.Title}.", $"Я хотел(а) бы получить больше информации об объявлении {Model.Title}.", $"أرغب في الحصول على مزيد من المعلومات حول الإعلان {Model.Title}.", $"مایلم اطلاعات بیشتری درباره آگهی {Model.Title} دریافت کنم.")</textarea>
                                </div>

                                <button class="btn btn-primary" type="submit">@T("Mesajı Gönder", "Send Message", "Отправить сообщение", "إرسال الرسالة", "ارسال پیام")</button>
                            </form>
                        </div>
                    }
                </section>

                @if (Model.ShowcaseListings.Any())
                {
                <section class="detail-section detail-section--compact">
                    <div class="detail-section__head">
                    </div>
                    <div class="detail-mini-list detail-mini-list--cards">
