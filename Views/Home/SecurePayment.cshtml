@using System.Globalization
@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    string T(string tr, string en, string ru, string ar, string? fa = null) => L.CultureCode switch
    {
        "en" => en,
        "ru" => ru,
        "ar" => ar,
        "fa" => fa ?? en ?? tr,
        _ => tr
    };
    ViewData["Title"] = T("Güvenli Ödeme", "Secure Payment", "Безопасная оплата", "دفع آمن");
    var paymentReference = Context.Request.Query["ref"].FirstOrDefault();
    var hasPaymentReference = !string.IsNullOrWhiteSpace(paymentReference);
    var referenceToDisplay = hasPaymentReference ? paymentReference! : "SNT-12345-20260504";
}

<style>
    .payment-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #198754 100%);
        padding: 3.5rem 0 2.5rem;
        color: #fff;
        text-align: center;
    }
    .payment-method-card {
        border: 2px solid #e9ecef; border-radius: 16px; padding: 1.75rem;
        text-align: center; transition: all .2s;
    }
    .payment-method-card:hover { border-color: #0d6efd; box-shadow: 0 8px 24px rgba(13,110,253,.12); transform: translateY(-3px); }
    .method-icon { font-size: 2.5rem; margin-bottom: .75rem; }
    .payment-info-strip {
        background: #eefbf3;
        border: 1px solid #9ce2b8;
        border-radius: 14px;
        padding: .85rem 1rem;
        color: #146c43;
        font-weight: 600;
    }
    .payment-reference-panel {
        background: #ffffff;
        border: 2px dashed #8cb7ff;
        border-radius: 14px;
        padding: 1rem;
    }
    .payment-reference-code {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #0d6efd;
        color: #fff;
        border-radius: 10px;
        padding: .45rem .75rem;
        font: 700 1rem/1.3 Consolas, "Courier New", monospace;
        letter-spacing: .04em;
        word-break: break-all;
    }
    .copy-ref-btn {
        border: 1px solid #0d6efd;
        color: #0d6efd;
        background: #fff;
        border-radius: 10px;
        padding: .42rem .8rem;
        font-weight: 600;
    }
    .copy-ref-btn:hover { background: #e8f0ff; }
    .payment-timeline {
        list-style: none;
        margin: 0;
        padding: 0;
    }
    .payment-timeline__item {
        position: relative;
        padding-left: 4.25rem;
        margin-bottom: 1.25rem;
        min-height: 3.5rem;
    }
    .payment-timeline__item:last-child { margin-bottom: 0; }
    .payment-timeline__item::before {
        content: "";
        position: absolute;
        left: 1.4rem;
        top: 2.8rem;
        bottom: -1.35rem;
        width: 2px;
        background: linear-gradient(180deg, #8fb5ff, rgba(13,110,253,0));
    }
    .payment-timeline__item:last-child::before { display: none; }
    .step-circle { width: 48px; height: 48px; border-radius: 50%; background: linear-gradient(135deg, #0d6efd, #198754); color: #fff; font-size: 1.2rem; font-weight: 800; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    @@media (max-width: 768px) {
        .payment-timeline__item { padding-left: 3.6rem; }
        .payment-timeline__item::before { left: 1.1rem; }
        .step-circle { width: 40px; height: 40px; font-size: 1rem; }
    }
</style>

<section class="payment-hero">
    <div class="container">
        <h1><i class="bi bi-shield-lock-fill me-2"></i>@T("Güvenli Ödeme", "Secure Payment", "Безопасная оплата", "دفع آمن")</h1>
        <p class="mb-0 opacity-90">@T("Tüm işlemleriniz şifrelenerek güvence altındadır", "All your transactions are protected with encryption.", "Все ваши операции защищены шифрованием.", "جميع معاملاتك محمية بالتشفير.")</p>
    </div>
</section>

<div class="bg-light py-5">
    <div class="container">
        <div class="payment-info-strip d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-info-circle-fill"></i>
            <span>@T("Ödeme doğrulaması açıklama alanındaki referans kodu ile yapılır.", "Payment verification is done with the reference code in the transfer note.", "Проверка платежа выполняется по референс-коду в назначении перевода.", "يتم التحقق من الدفع عبر رمز المرجع في وصف التحويل.")</span>
        </div>

        <!-- Ödeme Yöntemleri -->
        <h2 class="text-center fw-bold mb-2">@T("Kabul Edilen Ödeme Yöntemleri", "Accepted Payment Methods", "Принимаемые способы оплаты", "طرق الدفع المقبولة")</h2>
        <p class="text-center text-muted mb-5">@T("Güvenli seçenekler arasından size uygun olanı seçin", "Choose the secure option that fits you best.", "Выберите безопасный вариант, который подходит вам.", "اختر الخيار الآمن الأنسب لك.")</p>

        <div class="row g-4 mb-5">
            <div class="col-md-6">
                <div class="payment-method-card h-100">
                    <div class="method-icon">🏦</div>
                    <h5 class="fw-bold">@T("Havale / EFT", "Bank Transfer", "Банковский перевод", "تحويل بنكي")</h5>
                    <p class="text-muted small">@T("Banka hesabımıza doğrudan havale yapın. İşlem 1-2 iş günü içinde onaylanır.", "Transfer directly to our bank account. It is confirmed within 1-2 business days.", "Сделайте прямой перевод на наш банковский счет. Подтверждение в течение 1-2 рабочих дней.", "حوّل مباشرة إلى حسابنا البنكي. يتم التأكيد خلال 1-2 يوم عمل.")</p>
                    <div class="mt-3">
                        <strong class="d-block">TC Ziraat Bankası</strong>
                        <span class="text-muted small">Taşkın ÖNEL</span><br>
                        <span class="text-muted small">IBAN: TR67 0001 0040 1352 7080 5550 17</span><br>
                        <span class="text-muted small">@T("Açıklama: Sipariş numaranızı yazın", "Note: Enter your order number", "Примечание: укажите номер заказа", "ملاحظة: اكتب رقم الطلب")</span>
                    </div>
                    <button type="button" class="copy-ref-btn mt-3" data-copy-text="TR67 0001 0040 1352 7080 5550 17">@T("IBAN Kopyala", "Copy IBAN", "Скопировать IBAN", "نسخ IBAN")</button>
                    <span class="badge bg-success mt-3 px-3">@T("Ücretsiz", "Free", "Бесплатно", "مجاني")</span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="payment-method-card h-100">
                    <div class="method-icon">🏛️</div>
                    <h5 class="fw-bold">@T("EFT", "EFT", "EFT", "EFT")</h5>
                    <p class="text-muted small">@T("Farklı banka hesaplarından EFT ile ödeme yapabilirsiniz. Referans kodu ile doğrulama hızlıca tamamlanır.", "You can pay via EFT from different banks. Verification is completed quickly with your reference code.", "Вы можете оплатить через EFT из другого банка. Проверка быстро завершается по референс-коду.", "يمكنك الدفع عبر EFT من بنك مختلف، ويتم التحقق بسرعة باستخدام رمز المرجع.")</p>
                    <div class="mt-3">
                        <strong class="d-block">TC Ziraat Bankası</strong>
                        <span class="text-muted small">Taşkın ÖNEL</span><br>
                        <span class="text-muted small">IBAN: TR67 0001 0040 1352 7080 5550 17</span><br>
                        <span class="text-muted small">@T("Açıklama: Ödeme referans kodunu yazın", "Note: Enter payment reference code", "Примечание: укажите референс-код платежа", "ملاحظة: اكتب رمز مرجع الدفع")</span>
                    </div>
                    <button type="button" class="copy-ref-btn mt-3" data-copy-text="TR67 0001 0040 1352 7080 5550 17">@T("IBAN Kopyala", "Copy IBAN", "Скопировать IBAN", "نسخ IBAN")</button>
                    <span class="badge bg-success mt-3 px-3">@T("Aktif", "Active", "Активно", "نشط")</span>
                </div>
            </div>
        </div>

        <div class="payment-reference-panel mb-5 text-center">
            <div class="text-muted small mb-2">@T("Havale açıklamasına yazılacak referans", "Reference to include in transfer note", "Референс для назначения перевода", "المرجع الذي يجب كتابته في وصف التحويل")</div>
            <div class="payment-reference-code" id="paymentReferenceCode">@referenceToDisplay</div>
            <div class="mt-3 d-flex align-items-center justify-content-center gap-2 flex-wrap">
                <button type="button" class="copy-ref-btn" data-copy-target="#paymentReferenceCode">@T("Referansı Kopyala", "Copy Reference", "Скопировать референс", "نسخ المرجع")</button>
                @if (!hasPaymentReference)
                {
                    <span class="text-muted small">@T("Örnek kod gösteriliyor", "Sample code shown", "Показан пример кода", "يتم عرض رمز تجريبي")</span>
                }
            </div>
        </div>

        <!-- Havale Adımları -->
        <div class="card border-0 rounded-4 shadow-sm mb-5">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-4">@T("Havale ile Ödeme Nasıl Yapılır?", "How to Pay by Bank Transfer?", "Как оплатить банковским переводом?", "كيف يتم الدفع بالتحويل البنكي؟")</h4>
                <ul class="payment-timeline">
                    @foreach (var (step, i) in new[] {
                        (T("Paketi seçin ve 'Satın Al' butonuna tıklayın", "Choose a package and click 'Buy'", "Выберите пакет и нажмите 'Купить'", "اختر الباقة واضغط 'شراء'"), 1),
                        (T("Ekrandaki IBAN ve referans kodunu not alın", "Note the IBAN and reference code on screen", "Запишите IBAN и код ссылки на экране", "دوّن رقم IBAN وكود المرجع الظاهر على الشاشة"), 2),
                        (T("Bankanızdan belirtilen IBAN'a havale yapın", "Transfer to the specified IBAN from your bank", "Сделайте перевод на указанный IBAN через ваш банк", "حوّل إلى رقم IBAN المحدد عبر بنكك"), 3),
                        (T("Açıklama kısmına referans kodunu yazın", "Enter the reference code in the transfer note", "Укажите код ссылки в назначении платежа", "اكتب كود المرجع في خانة الوصف"), 4),
                        (T("1-2 iş günü içinde paketiniz aktif edilir", "Your package is activated within 1-2 business days", "Пакет активируется в течение 1-2 рабочих дней", "يتم تفعيل الباقة خلال 1-2 يوم عمل"), 5)
                    })
                    {
                        <li class="payment-timeline__item">
                            <div class="d-flex gap-3 align-items-start">
                                <div class="step-circle">@i</div>
                                <div class="pt-2"><strong>@step</strong></div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>

        <div class="text-center">
            <a asp-action="Index" asp-controller="Pricing" class="btn btn-primary btn-lg me-3">
                <i class="bi bi-star me-2"></i>@T("Paketleri İncele", "View Packages", "Смотреть пакеты", "عرض الباقات")
            </a>
            <a asp-action="Contact" asp-controller="Home" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-headset me-2"></i>@T("Destek Al", "Get Support", "Получить поддержку", "احصل على الدعم")
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const copyButtons = document.querySelectorAll('[data-copy-text], [data-copy-target]');
            if (!copyButtons.length) {
                return;
            }

            const copyText = async (text) => {
                if (!text) {
                    return false;
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(text);
                    return true;
                }

                const input = document.createElement('textarea');
                input.value = text;
                input.setAttribute('readonly', 'readonly');
                input.style.position = 'absolute';
                input.style.left = '-9999px';
                document.body.appendChild(input);
                input.select();
                const ok = document.execCommand('copy');
                document.body.removeChild(input);
                return ok;
            };

            copyButtons.forEach((button) => {
                button.addEventListener('click', async () => {
                    const text = button.getAttribute('data-copy-text')
                        || (button.getAttribute('data-copy-target')
                            ? (document.querySelector(button.getAttribute('data-copy-target'))?.textContent || '').trim()
                            : '');

                    try {
                        const ok = await copyText(text);
                        if (!ok) {
                            return;
                        }

                        const oldText = button.textContent;
                        button.textContent = '@T("Kopyalandı", "Copied", "Скопировано", "تم النسخ")';
                        setTimeout(() => {
                            button.textContent = oldText;
                        }, 1400);
                    } catch {
                        // no-op
                    }
                });
            });
        })();
    </script>
}
