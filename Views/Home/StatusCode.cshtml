@{
    var code = ViewData["StatusCode"] is int sc ? sc : 500;
    var title = code == 404 ? "Sayfa Bulunamadi" : "Beklenmeyen Hata";
    var description = code == 404
        ? "Aradiginiz sayfa tasinmis veya kaldirilmis olabilir."
        : "Isteginiz islenirken beklenmeyen bir durum olustu.";

    ViewData["Title"] = title;
}

<section class="container py-5">
    <div class="mx-auto" style="max-width:680px;">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <h1 class="display-5 fw-bold mb-2">@code</h1>
                <h2 class="h4 mb-3">@title</h2>
                <p class="text-muted mb-4">@description</p>
                <div class="d-flex justify-content-center gap-2 flex-wrap">
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana Sayfaya Don</a>
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Contact">Iletisim</a>
                </div>
            </div>
        </div>
    </div>
</section>
