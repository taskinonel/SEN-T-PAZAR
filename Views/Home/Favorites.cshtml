@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    ViewData["Title"] = L["favorites"];
}

<section class="section info-page" style="background-image: linear-gradient(110deg, rgba(18,43,73,.9), rgba(18,43,73,.42)), url('https://images.unsplash.com/photo-1514996937319-344454492b37?auto=format&fit=crop&w=1800&q=80');">
    <div class="container info-page__content">
        <h1>@L["favorites"]</h1>
        <p>Favorilerine eklediğin ilanları tek ekranda takip et.</p>
        <div class="info-page__cards">
            <article>
                <img src="https://images.unsplash.com/photo-1484154218962-a197022b5858?auto=format&fit=crop&w=1000&q=80" alt="Favori ev" />
                <h3>Konut Favorileri</h3>
                <p>Takip ettiğin konut ilanlarını karşılaştır.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1000&q=80" alt="Favori araç" />
                <h3>Araç Favorileri</h3>
                <p>Fiyat değişimlerini ve yeni fırsatları izle.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=1000&q=80" alt="Favori moda" />
                <h3>Yaşam Favorileri</h3>
                <p>Moda ve yaşam ürünlerini tek listede tut.</p>
            </article>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-light mt-3">@L["home"]</a>
    </div>
</section>
