@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    ViewData["Title"] = L["membership"];
}

<section class="section info-page" style="background-image: linear-gradient(110deg, rgba(20,30,55,.92), rgba(20,30,55,.4)), url('https://images.unsplash.com/photo-1520607162513-77705c0f0d4a?auto=format&fit=crop&w=1800&q=80');">
    <div class="container info-page__content">
        <h1>@L["membership"]</h1>
        <p>Üyelik avantajlarıyla ilanlarını daha geniş kitlelere ulaştır.</p>
        <div class="info-page__cards">
            <article>
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=1000&q=80" alt="Üyelik paketleri" />
                <h3>Paket Yönetimi</h3>
                <p>İhtiyacına göre standart veya premium paket seç.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?auto=format&fit=crop&w=1000&q=80" alt="Raporlama" />
                <h3>Performans Raporu</h3>
                <p>İlan görüntülenme ve talep oranlarını izle.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1531482615713-2afd69097998?auto=format&fit=crop&w=1000&q=80" alt="Destek" />
                <h3>Öncelikli Destek</h3>
                <p>Kritik talepler için hızlı destek hattı kullan.</p>
            </article>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-light mt-3">@L["home"]</a>
    </div>
</section>
