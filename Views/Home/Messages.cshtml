@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    ViewData["Title"] = L["messages"];
}

<section class="section info-page" style="background-image: linear-gradient(110deg, rgba(15,36,63,.9), rgba(15,36,63,.35)), url('https://images.unsplash.com/photo-1521791136064-7986c2920216?auto=format&fit=crop&w=1800&q=80');">
    <div class="container info-page__content">
        <h1>@L["messages"]</h1>
        <p>Satıcı ve alıcılarla güvenli biçimde iletişim kur.</p>
        <div class="info-page__cards">
            <article>
                <img src="https://images.unsplash.com/photo-1552581234-26160f608093?auto=format&fit=crop&w=1000&q=80" alt="Mesajlaşma" />
                <h3>Anlık Yanıtlar</h3>
                <p>İlan taleplerine hızlı cevap vererek dönüşümünü artır.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?auto=format&fit=crop&w=1000&q=80" alt="Ekip iletişimi" />
                <h3>Konuşma Geçmişi</h3>
                <p>Tüm görüşmeleri düzenli ve erişilebilir tut.</p>
            </article>
            <article>
                <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?auto=format&fit=crop&w=1000&q=80" alt="Bildirim" />
                <h3>Bildirimler</h3>
                <p>Yeni mesajlar ve teklif hareketleri anında bildirilir.</p>
            </article>
        </div>
        <a asp-action="Index" asp-controller="Home" class="btn btn-light mt-3">@L["home"]</a>
    </div>
</section>
