@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    ViewData["Title"] = L["vitrinAdTitle"];
    string T(string tr, string en, string ru, string ar, string? fa = null) => L.CultureCode switch
    {
        "en" => en,
        "ru" => ru,
        "ar" => ar,
        "fa" => fa ?? en ?? tr,
        _ => tr
    };
}

<style>
    .vitrin-hero {
        background: linear-gradient(135deg, #0ea5e9 0%, #0d6efd 60%, #6366f1 100%);
        padding: 4.5rem 0 3.25rem;
        color: #fff;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .vitrin-hero h1 { font-size: 2.2rem; font-weight: 800; }
    .vitrin-hero p { opacity: .9; max-width: 580px; margin: .75rem auto 0; }
    .vitrin-hero__decor {
        position: absolute;
        inset: 0;
        pointer-events: none;
        overflow: hidden;
    }
    .vitrin-hero__orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(4px);
        opacity: .55;
    }
    .vitrin-hero__orb--left { width: 280px; height: 280px; left: -90px; top: 40px; background: radial-gradient(circle, rgba(255,255,255,.18), rgba(255,255,255,0) 68%); }
    .vitrin-hero__orb--right { width: 320px; height: 320px; right: -110px; top: 10px; background: radial-gradient(circle, rgba(255,255,255,.2), rgba(255,255,255,0) 68%); }
    .vitrin-hero__orb--bottom { width: 220px; height: 220px; left: 12%; bottom: -100px; background: radial-gradient(circle, rgba(255,255,255,.16), rgba(255,255,255,0) 68%); }
    .vitrin-hero__floating {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        width: 210px;
        border-radius: 22px;
        padding: 1rem;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        backdrop-filter: blur(12px);
        box-shadow: 0 18px 40px rgba(15, 23, 42, .18);
        text-align: left;
    }
    .vitrin-hero__floating.left { left: 5%; }
    .vitrin-hero__floating.right { right: 5%; }
    .vitrin-hero__floating strong { display: block; font-size: 1rem; margin-bottom: .15rem; }
    .vitrin-hero__floating span { display: block; font-size: .85rem; opacity: .9; line-height: 1.4; }
    .vitrin-hero__floating .mini-chip { display: inline-flex; margin-top: .7rem; border-radius: 999px; padding: .28rem .65rem; background: rgba(255,255,255,.18); font-size: .75rem; font-weight: 700; }
    @@media (max-width: 991px) { .vitrin-hero__floating { display: none; } }
    .vitrin-package { border: 2px solid #e9ecef; border-radius: 16px; padding: 2rem; transition: all .25s; cursor: pointer; position: relative; overflow: hidden; }
    .vitrin-package:hover { border-color: #0d6efd; box-shadow: 0 8px 32px rgba(13,110,253,.12); transform: translateY(-4px); }
    .vitrin-package.selected { border-color: #198754; box-shadow: 0 0 0 3px rgba(25,135,84,.14), 0 16px 36px rgba(25,135,84,.18); background: linear-gradient(135deg, rgba(25,135,84,.06), rgba(25,135,84,.12)); }
    .vitrin-package::after { content: ''; position: absolute; inset: auto -30% -45% -30%; height: 120px; background: radial-gradient(circle, rgba(255,255,255,.26), transparent 62%); opacity: 0; transition: opacity .28s ease; pointer-events: none; }
    .vitrin-package:hover::after,
    .vitrin-package.selected::after { opacity: 1; }
    .vitrin-package.featured { border-color: #0d6efd; position: relative; padding-top: 2.8rem; overflow: visible; }
    .vitrin-package.featured::before {
        content: 'EN ÇOK TERCİH EDİLEN';
        position: absolute; top: 0; left: 50%; transform: translate(-50%, -50%);
        background: linear-gradient(90deg, #0d6efd, #6366f1);
        color: #fff; font-size: .7rem; font-weight: 700;
        padding: .3rem 1rem; border-radius: 20px; white-space: nowrap; z-index: 2;
    }
    .stat-chip { background: rgba(255,255,255,.15); border-radius: 12px; padding: .75rem 1.25rem; text-align: center; }
    .stat-chip .value { font-size: 1.8rem; font-weight: 800; }
    .stat-chip .label { font-size: .8rem; opacity: .85; }
    .form-contact { background: #fff; border-radius: 16px; box-shadow: 0 4px 24px rgba(0,0,0,.07); padding: 2.5rem; }
    .selected-plan-note { display: none; margin-top: 1rem; border-radius: 10px; background: #e8f7ee; color: #0f5132; border: 1px solid #b7e4c7; padding: .75rem 1rem; font-weight: 600; }
    .selected-plan-note.show { display: block; }
</style>

<section class="vitrin-hero">
    <div class="vitrin-hero__decor" aria-hidden="true">
        <span class="vitrin-hero__orb vitrin-hero__orb--left"></span>
        <span class="vitrin-hero__orb vitrin-hero__orb--right"></span>
        <span class="vitrin-hero__orb vitrin-hero__orb--bottom"></span>
        <div class="vitrin-hero__floating left">
            <strong>@T("Hızlı öne çıkın", "Boost fast", "Быстрый буст", "تعزيز سريع")</strong>
            <span>@T("İlanınızın vitrin akışında daha uzun süre görünmesini sağlayın.", "Keep your listing visible longer in the showcase flow.", "Сделайте объявление заметнее и дольше в витрине.", "أبقِ إعلانك ظاهرًا لفترة أطول في تدفق الواجهة.")</span>
            <span class="mini-chip">@T("Anında görünürlük", "Instant visibility", "Мгновенная видимость", "ظهور فوري")</span>
        </div>
        <div class="vitrin-hero__floating right">
            <strong>@T("Dönüşüm odaklı", "Conversion focused", "Фокус на конверсии", "موجه للتحويل")</strong>
            <span>@T("Premium yerleşimler ile daha fazla tıklama ve daha güçlü ilk izlenim.", "Premium placements for more clicks and a stronger first impression.", "Премиальные размещения для большего числа кликов и сильного первого впечатления.", "مواضع مميزة لمزيد من النقرات وانطباع أول أقوى.")</span>
            <span class="mini-chip">@T("Öne çıkan alan", "Featured slot", "Выделенное место", "مساحة مميزة")</span>
        </div>
    </div>
    <div class="container">
        <span class="badge rounded-pill mb-3" style="background:rgba(255,255,255,.2);">@T("Vitrin & Öne Çıkarma", "Showcase & Boost", "Витрина и продвижение", "الواجهة وتعزيز الإعلان")</span>
        <h1><i class="bi bi-eye-fill me-2"></i>@T("Vitrin Reklamı", "Showcase Ad", "Витринная реклама", "إعلان الواجهة")</h1>
        <p>@T("İlanınızı binlerce ziyaretçiye vitrinde gösterin. Anında görünürlük, anında dönüşüm.", "Show your listing in the showcase to thousands of visitors. Instant visibility, instant conversion.", "Покажите объявление тысячам посетителей на витрине. Мгновенная видимость и отклик.", "اعرض إعلانك لآلاف الزوار في الواجهة. ظهور فوري ونتائج أسرع.")</p>
        <div class="row g-3 justify-content-center mt-4">
            <div class="col-auto"><div class="stat-chip"><div class="value">50K+</div><div class="label">@T("Aylık Ziyaret", "Monthly Visits", "Посещений в месяц", "زيارات شهرية")</div></div></div>
            <div class="col-auto"><div class="stat-chip"><div class="value">3x</div><div class="label">@T("Daha Fazla Tıklama", "More Clicks", "Больше кликов", "نقرات أكثر")</div></div></div>
            <div class="col-auto"><div class="stat-chip"><div class="value">%92</div><div class="label">@T("Müşteri Memnuniyeti", "Customer Satisfaction", "Удовлетворенность клиентов", "رضا العملاء")</div></div></div>
        </div>
    </div>
</section>

<div class="bg-light py-5">
    <div class="container">

        <!-- Paketler -->
        <h2 class="text-center fw-bold mb-2">@T("Vitrin Reklam Paketleri", "Showcase Packages", "Пакеты витрины", "باقات الواجهة")</h2>
        <p class="text-center text-muted mb-3">@T("İhtiyacınıza uygun paketi seçin", "Choose the package that fits your needs", "Выберите пакет под ваши задачи", "اختر الباقة المناسبة لاحتياجك")</p>
        <div id="selectedVitrinPackage" class="selected-plan-note"></div>
        <div class="row g-4 mb-5">
            <div class="col-md-4">
                <div class="vitrin-package h-100" data-package="pkg-std" data-name="@T("Standart Vitrin", "Standard Showcase", "Стандартная витрина", "واجهة قياسية")" data-price="249">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-secondary px-3">BRONZE</span>
                    </div>
                    <h4 class="fw-bold">@T("Standart Vitrin", "Standard Showcase", "Стандартная витрина", "واجهة قياسية")</h4>
                    <div class="display-6 fw-bold my-3" style="color:#6c757d;">₺249<small class="fs-6 text-muted">@T("/7 gün", "/7 days", "/7 дней", "/7 أيام")</small></div>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("1 ilanı vitrine al", "Showcase 1 listing", "1 объявление на витрине", "إظهار إعلان واحد في الواجهة")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("7 gün boyunca gösterim", "7-day visibility", "Показ в течение 7 дней", "ظهور لمدة 7 أيام")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("İlan listesi üstünde konumlandırma", "Top placement in listing feed", "Размещение вверху списка", "موضع متقدم في قائمة الإعلانات")</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vitrin-package featured h-100" data-package="pkg-super" data-name="@T("Super Vitrin", "Super Showcase", "Супер витрина", "واجهة سوبر")" data-price="599">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge bg-primary px-3">@T("GOLD ⭐", "GOLD ⭐", "GOLD ⭐", "GOLD ⭐")</span>
                    </div>
                    <h4 class="fw-bold">@T("Super Vitrin", "Super Showcase", "Супер витрина", "واجهة سوبر")</h4>
                    <div class="display-6 fw-bold my-3" style="color:#0d6efd;">₺599<small class="fs-6 text-muted">@T("/14 gün", "/14 days", "/14 дней", "/14 يومًا")</small></div>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("1 ilanı vitrin üst bandına al", "Top-band showcase for 1 listing", "Верхняя витрина для 1 объявления", "شريط علوي لإعلان واحد")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("14 gün tam öncelik", "14 days full priority", "14 дней полного приоритета", "أولوية كاملة لمدة 14 يومًا")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("Öne çıkan rozeti", "Featured badge", "Значок рекомендации", "شارة مميز")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("Tıklama istatistikleri", "Click analytics", "Статистика кликов", "تحليلات النقر")</li>
                    </ul>
                </div>
            </div>
            <div class="col-md-4">
                <div class="vitrin-package h-100" data-package="pkg-vip" data-name="@T("VIP Vitrin", "VIP Showcase", "VIP витрина", "واجهة VIP")" data-price="999">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="badge px-3" style="background: linear-gradient(135deg,#7c3aed,#c026d3);">VIP</span>
                    </div>
                    <h4 class="fw-bold">@T("VIP Vitrin", "VIP Showcase", "VIP витрина", "واجهة VIP")</h4>
                    <div class="display-6 fw-bold my-3" style="color:#7c3aed;">₺999<small class="fs-6 text-muted">@T("/30 gün", "/30 days", "/30 дней", "/30 يومًا")</small></div>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("Ana sayfa hero vitrin konumu", "Homepage hero showcase slot", "Место в hero-блоке главной", "موضع الواجهة في قسم البطل بالصفحة الرئيسية")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("30 gün tam öncelik", "30 days full priority", "30 дней полного приоритета", "أولوية كاملة لمدة 30 يومًا")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("Sosyal medya paylaşımı", "Social media push", "Продвижение в соцсетях", "ترويج عبر وسائل التواصل")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("Haftalık performans raporu", "Weekly performance report", "Еженедельный отчёт", "تقرير أداء أسبوعي")</li>
                        <li class="mb-2"><i class="bi bi-check2-circle text-success me-2"></i>@T("Özel destek hattı", "Dedicated support line", "Выделенная линия поддержки", "خط دعم مخصص")</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Paket yönlendirmesi -->
        <div class="row justify-content-center" id="purchase-form">
            <div class="col-lg-8">
                <div class="form-contact">
                    <h4 class="fw-bold mb-2"><i class="bi bi-shield-check text-primary me-2"></i>@T("Vitrin Paketlerini İncele", "Review Showcase Packages", "Посмотреть пакеты витрины", "مراجعة باقات الواجهة")</h4>
                    <p class="text-muted mb-4">@T("Bir sonraki adımda vitrininize uygun paketi, kullanım süresini ve mevcut ödeme seçeneklerini görebilirsiniz.", "In the next step, you can review the right showcase package, duration, and available payment options.", "На следующем шаге вы увидите подходящий витринный пакет, срок действия и доступные способы оплаты.", "في الخطوة التالية يمكنك مراجعة الباقة المناسبة للواجهة ومدة الاستخدام وخيارات الدفع المتاحة.")</p>
                    <div class="d-grid gap-2">
                        <a class="btn btn-success btn-lg" href="@Url.Action("Index", "Pricing", new { type = "vitrin" })">
                                <i class="bi bi-cart-check me-2"></i>@T("Vitrin Paketlerini Gör", "View Showcase Packages", "Смотреть пакеты витрины", "عرض باقات الواجهة")
                            </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<script>
    (function () {
        const cards = document.querySelectorAll('.vitrin-package[data-package]');
        const radios = {
            'pkg-std': document.getElementById('pkg-std'),
            'pkg-super': document.getElementById('pkg-super'),
            'pkg-vip': document.getElementById('pkg-vip')
        };
        const note = document.getElementById('selectedVitrinPackage');

        function setSelected(packageId, name, price) {
            cards.forEach((card) => card.classList.toggle('selected', card.dataset.package === packageId));
            if (radios[packageId]) {
                radios[packageId].checked = true;
            }

            if (note) {
                note.textContent = '@T("Seçilen paket", "Selected package", "Выбранный пакет", "الباقة المحددة")' + ': ' + `${name} (₺${price})`;
                note.classList.add('show');
            }
        }

        cards.forEach((card) => {
            card.addEventListener('click', () => {
                setSelected(card.dataset.package || '', card.dataset.name || '', card.dataset.price || '');
                const formAnchor = document.getElementById('purchase-form');
                if (formAnchor) {
                    formAnchor.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

        setSelected('pkg-super', '@T("Super Vitrin", "Super Showcase", "Супер витрина", "واجهة سوبر")', '599');
    })();
</script>
