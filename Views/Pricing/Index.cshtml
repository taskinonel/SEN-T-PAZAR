@inject SEN_T_PAZAR.Services.SiteLocalizer L
@model List<SEN_T_PAZAR.Models.PricingPackage>
@{
    ViewData["Title"] = L["pricing"];
    var userPackages = ViewData["UserPackages"] as List<SEN_T_PAZAR.Models.UserPackageInfo>;
    var selectedType = ViewData["SelectedType"] as string;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">@L["pricingPackages"]</h1>
        <p class="lead text-muted">@L["pricingSubtitle"]</p>
    </div>
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

<!-- Paket Türü Filtreleri -->
     <div class="text-center mb-4">
         <div class="btn-group" role="group">
             <a href="@Url.Action("Index", "Pricing")" class="btn btn-outline-primary @((selectedType == null) ? "active" : "")">@L["allPackages"]</a>
             <a href="@Url.Action("Index", "Pricing", new { type = "featured" })" class="btn btn-outline-primary @(selectedType == "featured" ? "active" : "")">@L["featured"]</a>
             <a href="@Url.Action("Index", "Pricing", new { type = "vitrin" })" class="btn btn-outline-primary @(selectedType == "vitrin" ? "active" : "")">@L["vitrin"]</a>
             <a href="@Url.Action("Index", "Pricing", new { type = "popular" })" class="btn btn-outline-primary @(selectedType == "popular" ? "active" : "")">@L["popular"]</a>
             <a href="@Url.Action("Index", "Pricing", new { type = "combo" })" class="btn btn-outline-primary @(selectedType == "combo" ? "active" : "")">@L["combo"]</a>
         </div>
     </div>

    <!-- Kullanıcının Paketleri -->
    @if (userPackages != null && userPackages.Any())
    {
        <div class="card mb-5 border-success">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0"><i class="bi bi-gift"></i> @L["yourPackages"]</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    @foreach (var up in userPackages)
                    {
                        <div class="col-md-4 mb-3">
                            <div class="border rounded p-3">
                                <h6>@up.PackageName</h6>
                                <p class="mb-1 text-muted">@L["available"] @up.RemainingUses</p>
                                @if (up.ExpiryDate.HasValue)
                                {
                                    <small class="text-muted">@L["expiry"] @up.ExpiryDate.Value.ToString("dd.MM.yyyy")</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            @L["noPackages"]
        </div>
    }
    else
    {
        var vitrinPackages = Model.Where(p => p.PackageType == "vitrin").OrderBy(p => p.DisplayOrder).ToList();
        var featuredPackages = Model.Where(p => p.PackageType == "featured").OrderBy(p => p.DisplayOrder).ToList();
        var popularPackages = Model.Where(p => p.PackageType == "popular").OrderBy(p => p.DisplayOrder).ToList();
        var comboPackages = Model.Where(p => p.PackageType == "combo").OrderBy(p => p.DisplayOrder).ToList();
        var otherPackages = Model.Where(p => p.PackageType != "vitrin" && p.PackageType != "featured" && p.PackageType != "popular" && p.PackageType != "combo").OrderBy(p => p.DisplayOrder).ToList();
        
        @if (vitrinPackages.Any())
        {
            <h4 class="mt-5 mb-3 text-primary"><i class="bi bi-shop me-2"></i>@L["vitrin"] Paketleri</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var package in vitrinPackages)
                {
                    <partial name="_PackageCard" model="package" />
                }
            </div>
        }
        
        @if (featuredPackages.Any())
        {
            <h4 class="mt-5 mb-3 text-warning"><i class="bi bi-star-fill me-2"></i>@L["featured"] Paketleri</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var package in featuredPackages)
                {
                    <partial name="_PackageCard" model="package" />
                }
            </div>
        }
        
        @if (popularPackages.Any())
        {
            <h4 class="mt-5 mb-3 text-success"><i class="bi bi-fire me-2"></i>@L["popular"] Paketleri</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var package in popularPackages)
                {
                    <partial name="_PackageCard" model="package" />
                }
            </div>
        }
        
        @if (comboPackages.Any())
        {
            <h4 class="mt-5 mb-3 text-info"><i class="bi bi-lightning-charge me-2"></i>@L["combo"] Paketleri</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var package in comboPackages)
                {
                    <partial name="_PackageCard" model="package" />
                }
            </div>
        }
        
        @if (otherPackages.Any())
        {
            <h4 class="mt-5 mb-3">Diğer Paketler</h4>
            <div class="row row-cols-1 row-cols-md-3 g-4">
                @foreach (var package in otherPackages)
                {
                    <partial name="_PackageCard" model="package" />
                }
            </div>
        }
    }
</div>

<style>
    .btn-group .btn.active {
        background-color: var(--bs-primary);
        color: white;
    }
</style>
