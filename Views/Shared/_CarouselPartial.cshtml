@model List<SEN_T_PAZAR.Models.ProjectCard>
@inject SEN_T_PAZAR.Services.SiteLocalizer L

@{
    var category = ViewData["Category"] as string ?? "emlak";
    var fallbackImage = ViewData["FallbackImage"] as string ?? "";
}

@if (Model != null && Model.Count > 0)
{
    <div class="featured-carousel" data-category="@category" role="region" aria-label="@L["projectsTitle"]">
        <div class="featured-carousel-viewport">
            <div class="featured-carousel-track" role="list">
                @for (int i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    <article class="project-card" role="listitem">
                        <a asp-action="Details" asp-controller="Home" asp-route-id="@item.Id" class="project-card__media-link">
                            <img src="@(string.IsNullOrWhiteSpace(item.ImageUrl) ? fallbackImage : item.ImageUrl)" 
                                 alt="@item.Name" 
                                 loading="lazy"
                                 decoding="async"
                                 referrerpolicy="no-referrer"
                                 onerror="this.src='@fallbackImage'" />
                        </a>
                        <div class="project-card__body">
                            <h3><a asp-action="Details" asp-controller="Home" asp-route-id="@item.Id">@item.Name</a></h3>
                            <p class="project-card__location">@item.Location</p>
                            <ul>
                                <li>@item.Company</li>
                                <li>@item.DeliveryDate</li>
                            </ul>
                            <p class="project-price">@item.PriceFrom</p>
                            <a asp-action="Details" asp-controller="Home" asp-route-id="@item.Id" class="project-link">@L["details"]</a>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
}
