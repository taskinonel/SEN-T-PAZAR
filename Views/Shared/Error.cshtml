@model ErrorViewModel
@{
    ViewData["Title"] = "Bir Hata Olustu";
}

<section class="container py-5">
    <div class="mx-auto" style="max-width:680px;">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <h1 class="h3 text-danger mb-3">Islem Tamamlanamadi</h1>
                <p class="text-muted mb-4">Beklenmeyen bir hata olustu. Lutfen tekrar deneyin.</p>

                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-4">
                        <strong>Takip Kodu:</strong> <code>@Model.RequestId</code>
                    </p>
                }

                @if (Model.ShowErrorDetail)
                {
                    <div class="alert alert-danger text-start mt-3">
                        <strong>Hata Detayi:</strong>
                        <pre class="mb-0 mt-2" style="white-space:pre-wrap;font-size:12px;">@Model.ErrorDetail</pre>
                    </div>
                }
                    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Ana Sayfaya Don</a>
                    <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Contact">Destek Al</a>
                </div>
            </div>
        </div>
    </div>
</section>
