@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    ViewData["Title"] = L["register"];
}
@using SEN_T_PAZAR.Models
@model RegisterViewModel

<div class="d-flex flex-column align-items-center" style="min-height:100vh; background:linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
    <div class="card shadow-sm mt-5" style="max-width:400px; width:100%; margin-bottom:2rem; border-radius:15px; overflow:hidden;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <h3 class="mb-3">@L["register"]</h3>
                <p class="text-muted">@L["createAccount"]</p>
            </div>
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">@L["userName"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="UserName" class="form-control" placeholder="@L["userName"]" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">@L["fullName"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                        <input asp-for="FullName" class="form-control" placeholder="@L["fullName"]" />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">@L["email"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="@L["email"]" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label">@L["password"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="@L["password"]" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label">@L["confirmPassword"]</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="@L["confirmPassword"]" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 mb-3" style="border-radius:30px; padding:12px;">
                    @L["register"]
                </button>
            </form>
            <div class="text-center my-3">
                <hr class="my-4">
                <p class="mb-2 text-muted">@L["orRegisterWith"]</p>
                <a href="/Account/ExternalLogin?provider=Google&returnUrl=%2F" class="btn btn-outline-danger w-100" style="border-radius:30px; padding:12px; display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-google me-2"></i> @L["google"]
                </a>
            </div>
            <div class="text-center mt-3">
                @L["haveAccount"] <a href="/Account/Login" class="fw-bold text-decoration-none">@L["loginHere"]</a>
            </div>
        </div>
    </div>
</div>
