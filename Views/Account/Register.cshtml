@{
    ViewData["Title"] = "Kayıt Ol";
}
@using SEN_T_PAZAR.Models
@model RegisterViewModel

<div class="d-flex flex-column align-items-center" style="min-height:100vh; background:#fafbfc;">
    <div class="card shadow-sm mt-5" style="max-width:400px; width:100%; margin-bottom:2rem;">
        <div class="card-body">
            <h3 class="text-center mb-4">Hesap aç</h3>
            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" placeholder="Kullanıcı adı" />
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label"></label>
                    <input asp-for="FullName" class="form-control" placeholder="Ad Soyad" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" placeholder="E-posta adresi" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" placeholder="Şifre" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" placeholder="Şifre tekrarı" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn btn-primary w-100 mb-2">Hesap Aç</button>
            </form>
            <div class="text-center my-2 text-muted" style="font-size:0.95em;">
                Zaten hesabın var mı? <a href="/Account/Login">Giriş yap</a>
            </div>
        </div>
    </div>
    <div class="text-center text-muted mb-2" style="font-size:0.9em; max-width:420px;">
        Bu sayfadaki bilgiler hesabınız ve fatura gönderimi dahil olmak üzere tüm bilgilendirmeleriniz için alınmaktadır. Kişisel verilerin korunması ve kullanım koşullarıyla ilgili açıklamalar üyelik akışında tarafınıza sunulur.
    </div>
    <footer class="w-100 bg-white border-top py-3 mt-auto">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center" style="max-width:1100px;">
            <div class="mb-2 mb-md-0">
                <span class="me-3"><i class="bi bi-telephone"></i> 0 850 222 44 44</span>
                <span class="me-3"><i class="bi bi-question-circle"></i> Yardım Merkezi</span>
            </div>
            <div class="mb-2 mb-md-0">
                <span>Dil Seçimi:</span>
                <select class="form-select d-inline-block w-auto ms-2" style="min-width:90px;">
                    <option selected>Türkçe</option>
                    <option>English</option>
                </select>
            </div>
            <div>
                <span style="font-size:0.85em;">Copyright © 2026 SEN-T PAZAR</span>
            </div>
        </div>
    </footer>
</div>
