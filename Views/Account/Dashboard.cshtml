@model SEN_T_PAZAR.Models.AccountDashboardViewModel
@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    ViewData["Title"] = L["myAccount"];
    var activeTab = (ViewData["ActiveTab"] as string ?? "overview").ToLowerInvariant();
}

<div class="account-dashboard container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex align-items-center gap-3">
            <img src="@(string.IsNullOrWhiteSpace(Model.User.AvatarUrl) ? "https://ui-avatars.com/api/?name=" + Uri.EscapeDataString(Model.User.FullName) + "&background=1e3a66&color=fff" : Model.User.AvatarUrl)"
                 alt="Profil fotoğrafı"
                 class="account-dashboard__avatar" />
            <div>
                <h2 class="mb-1">Merhaba, @Model.User.FullName</h2>
                <div class="text-muted">@Model.User.Email</div>
            </div>
        </div>
    </div>

    @if (TempData["DashboardSuccess"] is string success && !string.IsNullOrWhiteSpace(success))
    {
        <div class="alert alert-success">@success</div>
    }
    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger"></div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Toplam İlan</div>
                    <div class="fs-4 fw-bold">@Model.Stats.TotalListings</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Yayındaki İlan</div>
                    <div class="fs-4 fw-bold">@Model.Stats.ApprovedListings</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Onay Bekleyen</div>
                    <div class="fs-4 fw-bold">@Model.Stats.PendingListings</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Öne Çıkan</div>
                    <div class="fs-4 fw-bold">@Model.Stats.FeaturedListings</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Vitrin</div>
                    <div class="fs-4 fw-bold">@Model.Stats.VitrinListings</div>
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Favoriler</div>
                    <div class="fs-4 fw-bold">@Model.Stats.FavoritesCount</div>
                </div>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs account-dashboard__tabs mb-3">
        <li class="nav-item"><a class="nav-link @(activeTab == "overview" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="overview">Genel Bakış</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "profile" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="profile">Profil</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "security" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="security">Güvenlik</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "listings" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="listings">İlanlarım</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "favorites" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="favorites">Favoriler</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "notifications" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="notifications">Bildirimler</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "billing" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="billing">Fatura</a></li>
        <li class="nav-item"><a class="nav-link @(activeTab == "corporate" ? "active" : string.Empty)" asp-action="Dashboard" asp-route-tab="corporate"><i class="bi bi-building me-1"></i>Kurumsal</a></li>
    </ul>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            @if (activeTab == "overview")
            {
                <h5 class="mb-3">Hesap Özeti</h5>
                <p class="text-muted mb-4">Profil, güvenlik, ilanlar ve bildirim ayarlarınızı yukarıdaki sekmelerden yönetebilirsiniz.</p>
                
                @if (Model.User.IsCorporateMember)
                {
                    <div class="alert alert-info mb-4">
                        <h6><i class="bi bi-building"></i> Kurumsal Üye</h6>
                        <p class="mb-0">
                            Şirket: <strong>@Model.User.CompanyName</strong> | 
                            Plan: <strong>@Model.User.SubscriptionPlan</strong>
                        </p>
                    </div>
                }
                
                @if (Model.ActivePackages.Any())
                {
                    <h6 class="mt-4">Aktif Paketler</h6>
                    <div class="row">
                        @foreach (var pkg in Model.ActivePackages)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card border-success">
                                    <div class="card-body">
                                        <h6>@pkg.PackageName</h6>
                                        <p class="mb-1">Kalan: <strong>@pkg.RemainingUses</strong></p>
                                        @if (pkg.ExpiryDate.HasValue)
                                        {
                                            <small class="text-muted">Bitiş: @pkg.ExpiryDate.Value.ToString("dd.MM.yyyy")</small>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <a href="@Url.Action("Index", "Pricing")" class="btn btn-outline-primary btn-sm">Tüm Paketler</a>
                }
                else
                {
                    <div class="alert alert-light border">
                        <p class="mb-2">İlanlarınızı öne çıkarmak veya vitrinde göstermek için paket satın alabilirsiniz.</p>
                        <a href="@Url.Action("Index", "Pricing")" class="btn btn-primary btn-sm">Fiyatlandırma</a>
                    </div>
                }
            }
            else if (activeTab == "profile")
            {
                <h5 class="mb-3">Profil Bilgileri</h5>
                <form asp-action="UpdateProfile" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label asp-for="ProfileForm.FullName" class="form-label"></label>
                        <input asp-for="ProfileForm.FullName" class="form-control" />
                        <span asp-validation-for="ProfileForm.FullName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProfileForm.PhoneNumber" class="form-label"></label>
                        <input asp-for="ProfileForm.PhoneNumber" class="form-control" />
                        <span asp-validation-for="ProfileForm.PhoneNumber" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProfileForm.City" class="form-label"></label>
                        <input asp-for="ProfileForm.City" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ProfileForm.AvatarUrl" class="form-label"></label>
                        <input asp-for="ProfileForm.AvatarUrl" class="form-control" />
                        <span asp-validation-for="ProfileForm.AvatarUrl" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ProfileForm.AddressLine" class="form-label"></label>
                        <textarea asp-for="ProfileForm.AddressLine" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                    </div>
                </form>
            }
            else if (activeTab == "security")
            {
                <h5 class="mb-3">Güvenlik Ayarları</h5>
                <form asp-action="ChangePassword" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-4">
                        <label asp-for="PasswordForm.CurrentPassword" class="form-label"></label>
                        <input asp-for="PasswordForm.CurrentPassword" class="form-control" />
                        <span asp-validation-for="PasswordForm.CurrentPassword" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PasswordForm.NewPassword" class="form-label"></label>
                        <input asp-for="PasswordForm.NewPassword" class="form-control" />
                        <span asp-validation-for="PasswordForm.NewPassword" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PasswordForm.ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="PasswordForm.ConfirmNewPassword" class="form-control" />
                        <span asp-validation-for="PasswordForm.ConfirmNewPassword" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">Şifreyi Güncelle</button>
                    </div>
                </form>
            }
            else if (activeTab == "listings")
            {
                <h5 class="mb-3">İlanlarım</h5>
                
                @if (Model.MyListings.Count == 0)
                {
                    <div class="text-muted">Henüz size ait ilan bulunmuyor.</div>
                    <a href="@Url.Action("Publish", "Home")" class="btn btn-primary mt-3">İlk İlanını Ver</a>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Görsel</th>
                                    <th>Başlık</th>
                                    <th>Fiyat</th>
                                    <th>Durum</th>
                                    <th>Vitrin/Öne Çıkan</th>
                                    <th>Tarih</th>
                                    <th>İşlemler</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MyListings)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.CoverImageUrl))
                                            {
                                                <img src="@item.CoverImageUrl" alt="@item.Title" style="width: 60px; height: 60px; object-fit: cover;" class="rounded" />
                                            }
                                            else
                                            {
                                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            }
                                        </td>
                                        <td>
                                            <a href="@Url.Action("Details", "Home", new { id = item.Id })" class="text-decoration-none">
                                                @item.Title
                                            </a>
                                            <div class="small text-muted">@item.City</div>
                                        </td>
                                        <td>
                                            <strong>@item.PriceAmount.ToString("N0") @item.PriceCurrency</strong>
                                        </td>
                                        <td>
                                            @if (item.IsApproved)
                                            {
                                                <span class="badge bg-success">Yayında</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Bekliyor</span>
                                            }
                                        </td>
                                        <td>
                                            @if (item.IsFeatured && (item.FeaturedExpiryDate == null || item.FeaturedExpiryDate > DateTime.UtcNow))
                                            {
                                                <span class="badge bg-primary me-1">Öne Çıkan</span>
                                            }
                                            @if (item.IsVitrin && (item.VitrinExpiryDate == null || item.VitrinExpiryDate > DateTime.UtcNow))
                                            {
                                                <span class="badge bg-warning">Vitrin</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="text-muted">@item.CreatedAt.ToString("dd.MM.yyyy")</small>
                                        </td>
                                        <td>
                                            <div class="dropdown">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                                                    İşlem
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li><a class="dropdown-item" href="@Url.Action("Details", "Home", new { id = item.Id })">Görüntüle</a></li>
                                                    <li><a class="dropdown-item" href="@Url.Action("Edit", "Home", new { id = item.Id })">Düzenle</a></li>
                                                    <li><hr class="dropdown-divider"></li>
                                                    <li><a class="dropdown-item text-danger" href="@Url.Action("Pricing", "Promote", new { listingId = item.Id })">Güçlendir</a></li>
                                                    <li><a class="dropdown-item text-danger" href="@Url.Action("Pricing", "Index")">Paket Satın Al</a></li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
                            <thead>
                                <tr>
                                    <th>Başlık</th>
                                    <th>Şehir</th>
                                    <th>Fiyat</th>
                                    <th>Durum</th>
                                    <th>Tarih</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.MyListings)
                                {
                                    <tr>
                                        <td>@item.Title</td>
                                        <td>@item.City</td>
                                        <td>@item.PriceAmount @item.PriceCurrency</td>
                                        <td>
                                            <span class="badge @(item.IsApproved ? "text-bg-success" : "text-bg-warning")">
                                                @(item.IsApproved ? "Yayında" : "Onay Bekliyor")
                                            </span>
                                        </td>
                                        <td>@item.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (activeTab == "favorites")
            {
                <h5 class="mb-3">Favoriler</h5>
                <div class="text-muted">Favori sistemi bir sonraki adımda ilan kartlarıyla entegre edilecek. Altyapı panelde hazırlandı.</div>
            }
            else if (activeTab == "notifications")
            {
                <h5 class="mb-3">Bildirim Tercihleri</h5>
                <form asp-action="NotificationSettings" method="post">
                    @Html.AntiForgeryToken()
                    <div class="form-check form-switch mb-2">
                        <input asp-for="NotificationForm.EmailNotifications" class="form-check-input" />
                        <label asp-for="NotificationForm.EmailNotifications" class="form-check-label"></label>
                    </div>
                    <div class="form-check form-switch mb-3">
                        <input asp-for="NotificationForm.SmsNotifications" class="form-check-input" />
                        <label asp-for="NotificationForm.SmsNotifications" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary">Tercihleri Kaydet</button>
                </form>
            }
            else if (activeTab == "billing")
            {
                <h5 class="mb-3">Fatura ve Ödeme Geçmişi</h5>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Fatura No</th>
                                <th>Tarih</th>
                                <th>Tutar</th>
                                <th>Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BillingItems)
                            {
                                <tr>
                                    <td>@item.InvoiceNo</td>
                                    <td>@item.Date.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                    <td>@item.Amount @item.Currency</td>
                                    <td><span class="badge text-bg-secondary">@item.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (activeTab == "corporate")
            {
                @if (TempData["CorporateSuccess"] is string corpSuccess)
                {
                    <div class="alert alert-success">@corpSuccess</div>
                }

                @if (Model.User.IsCorporateMember)
                {
                    <div class="row">
                        <div class="col-lg-4 mb-4">
                            <div class="card border-primary">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="bi bi-building me-2"></i>@L["corporateStore"]</h6>
                                </div>
                                <div class="card-body text-center">
                                    @if (!string.IsNullOrEmpty(Model.User.CompanyLogoUrl))
                                    {
                                        <img src="@Model.User.CompanyLogoUrl" alt="@Model.User.CompanyName" class="rounded-circle mb-3" style="width: 80px; height: 80px; object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                                            <i class="bi bi-building" style="font-size: 2rem; color: #6c757d;"></i>
                                        </div>
                                    }
                                    <h5>@Model.User.CompanyName</h5>
                                    @if (Model.User.IsCorporateApproved)
                                    {
                                        <span class="badge bg-success mb-2"><i class="bi bi-patch-check-fill me-1"></i>@L["verifiedStore"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark mb-2"><i class="bi bi-clock me-1"></i>Onay Bekliyor</span>
                                    }
                                    <div class="mt-3 text-start">
                                        <p class="mb-1"><strong>@L["selectPlan"]:</strong> @Model.User.SubscriptionPlan</p>
                                        <p class="mb-1"><strong>Vergi No:</strong> @Model.User.CompanyTaxNumber</p>
                                        <p class="mb-0"><strong>Telefon:</strong> @Model.User.CompanyPhone</p>
                                    </div>
                                </div>
                                <div class="card-footer bg-light">
                                    <a asp-action="UpdateCorporate" class="btn btn-outline-primary btn-sm w-100">
                                        <i class="bi bi-pencil me-1"></i>Bilgileri Güncelle
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="col-lg-8 mb-4">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <i class="bi bi-file-earmark-text text-primary" style="font-size: 2rem;"></i>
                                            <h6 class="mt-2 mb-1">İlan Kotası</h6>
                                            <p class="mb-0 fs-5 fw-bold">@(Model.User.ListingsRemainingThisMonth == 999999 ? "∞" : Model.User.ListingsRemainingThisMonth.ToString())</p>
                                            <small class="text-muted">/@(Model.User.TotalListingsAllowed == 999999 ? "∞" : Model.User.TotalListingsAllowed.ToString()) @L["listingsPerMonth"]</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <i class="bi bi-star-fill text-warning" style="font-size: 2rem;"></i>
                                            <h6 class="mt-2 mb-1">@L["featuredListings"]</h6>
                                            <p class="mb-0 fs-5 fw-bold">@(Model.User.FeaturedListingsIncluded - Model.User.FeaturedListingsUsed)</p>
                                            <small class="text-muted">/@Model.User.FeaturedListingsIncluded kaldı</small>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="card bg-light">
                                        <div class="card-body text-center">
                                            <i class="bi bi-eye-fill text-info" style="font-size: 2rem;"></i>
                                            <h6 class="mt-2 mb-1">@L["vitrinListings"]</h6>
                                            <p class="mb-0 fs-5 fw-bold">@(Model.User.VitrinListingsIncluded - Model.User.VitrinListingsUsed)</p>
                                            <small class="text-muted">/@Model.User.VitrinListingsIncluded kaldı</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="card mt-3">
                                <div class="card-header">
                                    <h6 class="mb-0">Abonelik Detayları</h6>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <p class="mb-1"><strong>Başlangıç:</strong> @(Model.User.SubscriptionStartDate?.ToString("dd.MM.yyyy") ?? "-")</p>
                                            <p class="mb-1"><strong>Bitiş:</strong> @(Model.User.SubscriptionEndDate?.ToString("dd.MM.yyyy") ?? "-")</p>
                                        </div>
                                        <div class="col-md-6">
                                            <p class="mb-1"><strong>Durum:</strong> 
                                                @if (Model.User.IsSubscriptionActive)
                                                {
                                                    <span class="badge bg-success">Aktif</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Beklemede</span>
                                                }
                                            </p>
                                            <p class="mb-0"><strong>Not:</strong> @(Model.User.CorporateNote ?? "-")</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-building text-muted" style="font-size: 4rem;"></i>
                        <h5 class="mt-3">@L["corporateMembership"]</h5>
                        <p class="text-muted mb-4">İşletmenizi profesyonel bir şekilde sergileyin. Onaylı rozet, sınırsız ilan ve öncelikli destek ile satışlarınızı artırın.</p>
                        <a asp-action="CorporateMembership" class="btn btn-primary btn-lg">
                            <i class="bi bi-arrow-right-circle me-2"></i>@L["submitApplication"]
                        </a>
                    </div>
                }
            }
        </div>
    </div>
</div>
