@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    ViewData["Title"] = L["login"];
}
@model SEN_T_PAZAR.Models.LoginViewModel
<div class="container" style="max-width:400px;margin:2rem auto;">
    <h2>@L["login"]</h2>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">@L["email"]</label>
            <input asp-for="Email" class="form-control" placeholder="@L["email"]" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">@L["password"]</label>
            <input asp-for="Password" class="form-control" placeholder="@L["password"]" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3 form-check">
            <input asp-for="RememberMe" class="form-check-input" />
            <label asp-for="RememberMe" class="form-check-label">@L["rememberMe"]</label>
        </div>
        <button type="submit" class="btn btn-primary w-100">@L["login"]</button>
    </form>
</div>
