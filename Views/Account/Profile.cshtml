@model SEN_T_PAZAR.Models.ApplicationUser
@inject SEN_T_PAZAR.Services.SiteLocalizer L
@{
    string T(string tr, string en, string ru, string ar, string? fa = null) => L.CultureCode switch
    {
        "en" => en,
        "ru" => ru,
        "ar" => ar,
        "fa" => fa ?? en ?? tr,
        _ => tr
    };

    ViewData["Title"] = L["myAccount"];
}
<div class="container" style="max-width:600px;margin:2rem auto;">
    <h2>@T("Hesap Bilgilerim", "My Account Details", "Данные моего аккаунта", "تفاصيل حسابي")</h2>
    <div class="card p-4 mb-4">
        <dl class="row">
            <dt class="col-sm-4">@L["fullName"]</dt>
            <dd class="col-sm-8">@Model.FullName</dd>
            <dt class="col-sm-4">@L["email"]</dt>
            <dd class="col-sm-8">@Model.Email</dd>
            <dt class="col-sm-4">@L["userName"]</dt>
            <dd class="col-sm-8">@Model.UserName</dd>
        </dl>
    </div>
    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-primary">@L["logout"]</button>
    </form>
</div>
