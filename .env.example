# Example env file for production
# Set these as environment variables in your production environment

# JWT signing key (32+ random chars)
Jwt__Key=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32_PLUS_CHARS

# Database connection (use a proper production DB)
ConnectionStrings__DefaultConnection=Data Source=/var/db/sent-pazar.db

# SMTP
Smtp__Host=smtp.example.com
Smtp__Port=587
Smtp__User=mail@example.com
Smtp__Pass=supersecret
Smtp__From=noreply@example.com

# Google OAuth
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# App public origin
App__PublicOrigin=https://www.sentpazar.com

